@article{SparksEtAl2014,
  title = {Cooling off and Backing out: {{Understanding}} Consumer Decisions to Rescind a Product Purchase},
  author = {Sparks, Beverley A. and Bradley, Graham L. and Jennings, Gayle R. and Johnston, Nicole R.},
  date = {2014-01},
  journaltitle = {Journal of Business Research},
  volume = {67},
  number = {1},
  pages = {2903--2910},
  issn = {01482963},
  doi = {10.1016/j.jbusres.2012.06.003},
  url = {http://10.0.3.248/j.jbusres.2012.06.003 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=91267323{&}site=bsi-live},
  abstract = {Consumers sometimes have the right to exit a sales contract during what is known as a cooling-off period. Sales process research generally does not address cases when consumers withdraw from sales contracts during this period. Since securing product sales involves substantial marketing and sales costs, a need exists to better understand not only consumer rescission decisions and their legal context but also the managerial implications of the cooling-off period. This exploratory qualitative study examines purchase rescinding and develops a conceptual model using timeshare as the context. Results suggest that rescission relates to a mismatch between product features and personal circumstances, post-purchase concerns about product value, reassessment of financial capability, reflections on sales presentations, and cautionary influences of reference groups. \textcopyright{} 2012.},
  keywords = {\#nosource,Buyer regret,Consumer protection,Cooling-off period,Emotions,Rescind,Timeshare}
}

