  url = {http://10.0.4.62/697413 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=130463315{&}site=bsi-live},
  abstract = {Financial literacy programs are popular, despite limited evidence that they lead to significant changes in savings behavior. We experimentally test the impact of financial literacy training on clients of a branchless banking program that offers doorstep access to banking to low-income households. The intervention had significant impacts: total savings in the treatment group increased by 49\% (\$39) within a period of 1 year. The increase in savings is due in part to decreases in expenditures on temptation goods. These results suggest that financial education interventions can be successful in changing savings outcomes, although results may be very context specific.},
  keywords = {\#nosource,Consumer behavior,Finance education,Financial literacy,Personal finance,Saving \{\textbackslash\&\} investment}
}

