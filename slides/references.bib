@article{FreundliebEtAl2018,
  title = {Reading {{Your Mind While You Are Reading}}\textemdash{{Evidence}} for {{Spontaneous Visuospatial Perspective Taking During}} a {{Semantic Categorization Task}}},
  author = {Freundlieb, Martin and Kov\'acs, \'Agnes M. and Sebanz, Natalie},
  date = {2018-04},
  journaltitle = {Psychological Science},
  shortjournal = {Psychol Sci},
  volume = {29},
  number = {4},
  pages = {614--622},
  issn = {0956-7976, 1467-9280},
  doi = {10.1177/0956797617740973},
  url = {http://journals.sagepub.com/doi/10.1177/0956797617740973},
  urldate = {2022-10-07},
  abstract = {Recent studies have demonstrated people's propensity to adopt others' visuospatial perspectives (VSPs) in a shared physical context. The present study investigated whether spontaneous VSP taking occurs in mental space where another person's perspective matters for mental activities rather than physical actions. Participants sat at a 90\textdegree{} angle to a confederate and performed a semantic categorization task on written words. From the participants' point of view, words were always displayed vertically, while for the confederate, these words appeared either the right way up or upside down, depending on the confederate's sitting position. Participants took longer to categorize words that were upside down for the confederate, suggesting that they adopted the confederate's VSP without being prompted to do so. Importantly, the effect disappeared if the other's visual access was impeded by opaque goggles. This demonstrates that human adults show a spontaneous sensitivity to others' VSP in the context of mental activities, such as joint reading.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Freundlieb et al_2018_Reading Your Mind While You Are Reading—Evidence for Spontaneous Visuospatial.pdf}
}

@article{FriedlineKepple2017,
  title = {Does {{Community Access}} to {{Alternative Financial Services Relate}} to {{Individuals}}' {{Use}} of {{These Services}}? {{Beyond Individual Explanations}}},
  author = {Friedline, Terri and Kepple, Nancy},
  date = {2017-03},
  journaltitle = {Journal of Consumer Policy},
  volume = {40},
  number = {1},
  pages = {51--79},
  publisher = {{Springer Nature}},
  issn = {15730700},
  doi = {10.1007/s10603-016-9331-y},
  url = {http://10.0.3.239/s10603-016-9331-y http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=122457958{&}site=bsi-live http://link.springer.com/10.1007/s10603-016-9331-y},
  abstract = {There is concern that the increasing number of alternative financial services in communities across the USA is risking individuals' financial health by increasing their use of these high-cost services. To address this concern, this study used restricted-access, zip code data from nationally representative samples of adult individuals and examined associations between the density or concentration of alternative financial services within communities and individuals' use of these services. The associations between community density and individ-uals' use varied by annual household income: Communities' higher density of alternative financial services was associated with the increased probability that modest-and highest-income individuals ever used these services, while higher density was associated with more chronic use among lowest-income individuals. State regulation that prohibited payday lenders had a protective association for modest-and highest-income individuals but had no effect for lowest-income individuals. Policy implications are discussed. An individual's use of alternative financial services\textemdash including auto title lenders, payday lenders, tax refund and anticipation lenders, pawnshops, and rent-to-own stores\textemdash is likely more than an individual phenomenon. Residential community characteristics may also relate to an individual's use of these services, in addition to other financial behaviors. This is not meant to discount individual explanations of financial behavior; instead, a fuller explanation of},
  keywords = {\#nosource,Alternative financial services,Collective efficacy,National Financial Capability Study (NFCS),Payday lenders}
}

