@article{keaseyDecisionMakingNoteNew1989,
  title = {Decision-{{Making}} : A {{Note}} on a {{New Measure}} of {{Consensus}}},
  author = {Keasey, Kevin and Watson, Robert},
  date = {1989-07},
  journaltitle = {Accounting, Organisation and Society},
  volume = {14},
