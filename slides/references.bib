@article{TolbaEtAl2014,
  title = {Factors Influencing Intentions of {{Egyptian MSME}} Owners in Taking Commercial Bank Loans},
  author = {Tolba, Ahmed and Seoudi, Iman and Fahmy, Khadiga},
  date = {2014-11},
  journaltitle = {Journal of Small Business and Entrepreneurship},
  volume = {27},
  number = {6},
  pages = {497--518},
  issn = {21692610},
  doi = {10.1080/08276331.2015.1102478},
  url = {http://10.0.4.56/08276331.2015.1102478 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=112860065{&}site=ehost-live},
  abstract = {This study sheds light on the behavioral factors affecting Egyptian small and medium enterprise (SME) owner-managers' intentions to take commercial bank loans from a consumer buyer behavior perspective. A conceptual model based on the theory of planned behavior postulates that SME owner-manager intentions are determined by Knowledge, Previous Experience, Perceptions, Attitude, Subjective Norms and Perceived Behavioral Control. Gender, age, knowledge and education are individual-level factors that potentially influence the latter relationship. Key company-level variables such as firm size, type, years in operation, growth orientation and owner-manager separation are explored. The study uses a mix of qualitative (interviews and focus group) and quantitative (survey and regression analysis) methods. The results show that intentions to take a commercial bank loan are low in Egypt and SME owner-managers have negative perceptions on the service quality of loan providers. Subjective norm and knowledge are the key factors that influence loan-taking intentions. Moreover, intentions vary according to certain demographic and company characteristics. Managerial and policy implications for financial institutions, governments and developmental organizations are drawn.},
  keywords = {\#nosource,Egyptian SMEs,loan consumer buyer behavior,SME finance}
}

@article{ToloEtAl2017,
  title = {Do Banks' Overnight Borrowing Rates Lead Their {{CDS}} Price? {{Evidence}} from the {{Eurosystem}}},
  author = {T\"ol\"o, Eero and Jokivuolle, Esa and Vir\'en, Matti},
  date = {2017-07},
  journaltitle = {Journal of Financial Intermediation},
  volume = {31},
  pages = {93--106},
  issn = {10960473},
  doi = {10.1016/j.jfi.2017.05.006},
  url = {http://10.0.3.248/j.jfi.2017.05.006 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=124420730{&}site=ehost-live},
  abstract = {We construct a measure of a bank's relative creditworthiness from the Eurosystem's proprietary inter-bank loan data: average overnight borrowing rate relative to an overnight rate index (AOR). We then investigate the dynamic relationship between AOR and the credit default swap price relative to the corresponding market index of 60 banks during 2008\textendash 2013. Price discovery mainly takes place in the CDS market, but AOR also contributes to it. The lagged daily changes of AOR help predict CDS. This indicates that AOR includes private information, which the CDS market does not immediately incorporate. We further show that the private information advantage is concentrated on days of market stress and on banks, which mainly borrow from relationship lender banks. Such borrower banks are typically smaller, have weaker ratings, and are likely to reside in crisis countries. Competent authorities can use AOR as a complementary indicator of banks' concurrent health.},
  keywords = {\#nosource,Credit default swaps (CDS),Early-warning indicators,Eurosystem,Lead-lag relationship,Money markets,Overnight borrowing rates,Private information,TARGET2}
}

