@article{xuImpactSelfconstrualMessage2019,
  title = {The Impact of Self-Construal and Message Frame Valence on Reactance: A Cross-Cultural Study in Charity Advertising},
  shorttitle = {The Impact of Self-Construal and Message Frame Valence on Reactance},
  author = {Xu, Jie},
  date = {2019-04-03},
  journaltitle = {International Journal of Advertising},
  volume = {38},
