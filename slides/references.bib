@article{taylorTestingCreditBlame1995,
  title = {Testing {{Credit}} and {{Blame Attributions}} as {{Explanation}} for {{Choices}} under {{Ambiguity}}},
  author = {Taylor, Kimberly A.},
  date = {1995-11},
  journaltitle = {Organizational Behavior and Human Decision Processes},
  volume = {64},
  number = {2},
  pages = {128--137},
  issn = {07495978},
  doi = {10.1006/obhd.1995.1095},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=9511291116{&}site=ehost-live},
  abstract = {People make decisions every day based on their estimates of the chances of various events occurring. By their very nature, these subjective estimates are less certain, and thus more ambiguous, than objective probabilities such as those associated with roulette wheels or lotteries. In two experimental studies, we investigate choices between bets on the decision maker′s knowledge versus bets on a lottery with the same chance of winning. In Study 1, we partially replicate the Heath and Tversky (1991) finding that subjects have an increasing preference for betting on their own knowledge over the matched-chance lottery as probability increases. We also discover a significant minority of subjects who exhibit the opposite pattern and prefer the lottery as probability increases. In addition, we explicitly test the subjects′ attributions about the credit they would feel for a win and the blame they would feel for a loss, and these attributions do provide some explanation for their choice behavior. In Study 2, we manipulate knowledge and accountability, in an attempt to heighten the attributions of credit and blame, and we replicate the findings. © 1995 by Academic Press, Inc.},
  keywords = {Credit,Decision making,Liability (Law),Lottery tickets,nosource,Roulette,Winning \\\& losing (Contests \\\& competitions),Winning \& losing (Contests \& competitions)}
}

@article{tealProblemGamblingFuelled2021,
  title = {Problem {{Gambling}} '{{Fuelled}} on the {{Fly}}'},
  author = {Teal, J and Kusev, P and Heilman, R and Martin, R and Passanisi, A and Pace, U},
  date = {2021-08},
  journaltitle = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
  volume = {18},
  number = {16},
  issn = {1660-4601},
  doi = {10.3390/ijerph18168607},
  abstract = {Problem gambling is a gambling disorder often described as continued gambling in the face of increasing losses. In this article, we explored problem gambling behaviour and its psychological determinants. We considered the assumption of stability in risky preferences, anticipated by both normative and descriptive theories of decision making, as well as recent evidence that risk preferences are in fact 'constructed on the fly' during risk elicitation. Accordingly, we argue that problem gambling is a multifaceted disorder, which is 'fueled on the fly' by a wide range of contextual and non-contextual influences, including individual differences in personality traits, hormonal and emotional activations. We have proposed that the experience of gambling behaviour in itself is a dynamic experience of events in time series, where gamblers anchor on the most recent event-typically a small loss or rare win. This is a highly adaptive, but erroneous, decision-making mechanism, where anchoring on the most recent event alters the psychological representations of substantial and accumulated loss in the past to a representation of negligible loss. In other words, people feel better while they gamble. We conclude that problem gambling researchers and policy makers will need to employ multifaceted and holistic approaches to understand problem gambling.},
  langid = {english},
  keywords = {5-FACTOR MODEL,anchoring on recent events,BIG-5 PERSONALITY-FACTORS,construction of preferences,DECISION-MAKING,dynamic experience of events in time series,EMOTION REGULATION,GENDER-DIFFERENCES,LOSS AVERSION,problem gambling,PROSPECT-THEORY,RISK-TAKING,risky decision-making,STABILITY,TRAITS},
  file = {/home/chris/Zotero/storage/PRKTG6JE/Teal et al. - 2021 - Problem Gambling 'Fuelled on the Fly'.pdf}
}

@article{temcheffWhichDiagnosticCriteria2016,
  title = {Which {{Diagnostic Criteria}} Are {{Most Useful}} in {{Discriminating Between Social Gamblers}} and {{Individuals}} with {{Gambling Problems}}? {{An Examination}} of {{DSM-IV}} and {{DSM-5 Criteria}}.},
  author = {Temcheff, Caroline and Paskus, Thomas and family=Potenza, given=Marc., given-i={{Marc}} and Derevensky, Jeffrey and Temcheff, Caroline E and Paskus, Thomas S and Potenza, Marc N and Derevensky, Jeffrey L},
  date = {2016-09-01},
  journaltitle = {Journal of Gambling Studies},
  shortjournal = {Journal of Gambling Studies},
  volume = {32},
  number = {3},
  pages = {957--968},
  publisher = {Springer Nature},
  location = {New York, New York},
  issn = {1050-5350},
  doi = {10.1007/s10899-015-9591-5},
  url = {https://research.ebsco.com/linkprocessor/plink?id=d09fa292-2c0f-3077-aa11-51186f8e94b7},
  abstract = {The current study sought to identify which diagnostic criteria for gambling disorder have the greatest ability to differentiate between social and problem gamblers. This study was conducted on a sample of male and female college student athletes across the U.S. (n~=~8674). Classification and regression tree analysis represents an appropriate technique when addressing the question of an item's diagnostic value, as it sequentially selects variables to isolate sets of observations with similar outcomes. The current results suggest that the item related to preoccupation ("Have there been periods in the past year where you spent a lot of time thinking about gambling?") was the DSM-5 item best able to differentiate between male and female social and problem gamblers in this sample. When considering only the nine criteria retained in the DSM-5, three criteria were identified as key for distinguishing between social and disordered gamblers among men, and one criterion was identified for distinguishing between groups of women. In addition, these results do not support the notion that the illegal acts criterion has a particularly low base rate and found that it can be an important indicator of disordered gambling in a college-aged sample.},
  langid = {english},
  keywords = {Adult,Adult: 19-44 years,Behavioral Symptoms Diagnosis,Behavioral Symptoms Psychosocial Factors,DSM,Female,Gambling Diagnosis,Gambling Psychosocial Factors,Male,Middle Age,Middle Aged: 45-64 years,Risk Taking Behavior,Severity of Illness Indices,Students,Young Adult}
}

