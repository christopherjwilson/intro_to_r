@article{vitorioFNIRSResponseWalking2017,
  title = {{{fNIRS}} Response during Walking — {{Artefact}} or Cortical Activity? {{A}} Systematic Review},
  shorttitle = {{{fNIRS}} Response during Walking — {{Artefact}} or Cortical Activity?},
  author = {Vitorio, R. and Stuart, S. and Rochester, L. and Alcock, L. and Pantall, A.},
  date = {2017-12},
  journaltitle = {Neuroscience \& Biobehavioral Reviews},
  shortjournal = {Neuroscience \& Biobehavioral Reviews},
  volume = {83},
  pages = {160--172},
  issn = {01497634},
  doi = {10.1016/j.neubiorev.2017.10.002},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0149763417303470},
  urldate = {2024-10-18},
  abstract = {This systematic review aims to (i) evaluate functional near infrared spectroscopy (fNIRS) walking study design in young adults, older adults and people with Parkinson’s disease (PD); (ii) examine signal processing techniques to reduce artefacts and physiological noise in fNIRS data; and (iii) provide evidence-based recommendations for fNIRS walking study design and signal analysis techniques. An electronic search was undertaken. The search request detailed the measurement technique, cohort and walking task. Thirty-one of an initial yield of 73 studies satisfied the criteria. Protocols and methods for removing artefacts and noise varied. Differences in fNIRS signals between studies were found in rest vs. walking, speed of walking, usual vs. complex walking and easy vs. difficult tasks. In conclusion, there are considerable technical and methodological challenges in conducting fNIRS studies during walking which can introduce inconsistencies in study findings. We provide recommendations for the construction of robust methodologies and suggest signal processing techniques implementing a theoretical framework accounting for the physiology of haemodynamic responses.},
  langid = {english},
  keywords = {Complex walking,Cortical activation,Dual task,fNIRS,Gait},
  file = {/home/chris/Zotero/storage/DY5W2F2U/Vitorio et al._2017_fNIRS resp.pdf;/home/chris/Zotero/storage/UUZAKEL5/Vitorio et al_2017_fNIRS response during walking — Artefact or cortical activity.pdf;/home/chris/Zotero/storage/Y6TUDRTV/Vitorio et al_2017_fNIRS response during walking — Artefact or cortical activity.pdf}
}

