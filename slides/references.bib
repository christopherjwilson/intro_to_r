@article{soaresHiddenSnakeGrass2014,
  title = {The {{Hidden Snake}} in the {{Grass}}: {{Superior Detection}} of {{Snakes}} in {{Challenging Attentional Conditions}}},
  shorttitle = {The {{Hidden Snake}} in the {{Grass}}},
  author = {Soares, Sandra C. and Lindström, Björn and Esteves, Francisco and Öhman, Arne},
  editor = {Nishijo, Hisao},
  date = {2014-12-10},
  journaltitle = {PLoS ONE},
  shortjournal = {PLoS ONE},
  volume = {9},
  number = {12},
  eprint = {25493937},
  eprinttype = {pubmed},
  pages = {e114724},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0114724},
  url = {https://dx.plos.org/10.1371/journal.pone.0114724},
  urldate = {2022-10-07},
  abstract = {Snakes have provided a serious threat to primates throughout evolution. Furthermore, bites by venomous snakes still cause significant morbidity and mortality in tropical regions of the world. According to the Snake Detection Theory (SDT Isbell, 2006; 2009), the vital need to detect camouflaged snakes provided strong evolutionary pressure to develop astute perceptual capacity in animals that were potential targets for snake attacks. We performed a series of behavioral tests that assessed snake detection under conditions that may have been critical for survival. We used spiders as the control stimulus because they are also a common object of phobias and rated negatively by the general population, thus commonly lumped together with snakes as ‘‘evolutionary fear-relevant’’. Across four experiments (N5205) we demonstrate an advantage in snake detection, which was particularly obvious under visual conditions known to impede detection of a wide array of common stimuli, for example brief stimulus exposures, stimuli presentation in the visual periphery, and stimuli camouflaged in a cluttered environment. Our results demonstrate a striking independence of snake detection from ecological factors that impede the detection of other stimuli, which suggests that, consistent with the SDT, they reflect a specific biological adaptation. Nonetheless, the empirical tests we report are limited to only one aspect of this rich theory, which integrates findings across a wide array of scientific disciplines.},
  langid = {english},
  pmcid = {PMC4262429},
  file = {/home/chris/Zotero/storage/788E4KQR/Soares et al. - 2014 - The Hidden Snake in the Grass Superior Detection .pdf;/home/chris/Zotero/storage/DSSBE66A/Soares et al_2014_The Hidden Snake in the Grass.pdf;/home/chris/Zotero/storage/PXI5BUMW/Soares et al_2014_The Hidden Snake in the Grass.pdf;/home/chris/Zotero/storage/S3JKUBCU/Soares et al. - 2014 - The Hidden Snake in the Grass Superior Detection .PDF;/home/chris/Zotero/storage/YYY44QPH/Soares et al_2014_The Hidden Snake in the Grass.pdf}
}

