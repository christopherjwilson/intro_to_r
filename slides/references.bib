@article{PraetoriusEtAl2016,
  title = {Cultural Integration through Shared Learning among Resettled {{Bhutanese}} Women},
  author = {Praetorius, Regina T. and Mitschke, Diane B. and Avila, Christopher D. and Kelly, Don R. and Henderson, Jeremiah},
  date = {2016-08},
  journaltitle = {Journal of Human Behavior in the Social Environment},
  volume = {26},
  number = {6},
  pages = {549--560},
  publisher = {{Taylor \& Francis}},
  location = {{Praetorius, Regina T., School of Social Work, University of Texas at Arlington, 211 S. Cooper, Box 19129, Arlington, TX, US, 76019}},
  issn = {15403556},
  doi = {10.1080/10911359.2016.1172997},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-30680-006{&}site=ehost-live http://rtpraetorius@uta.edu},
  abstract = {The multidimensional needs of recently resettled refugees have been well\textbackslash ndocumented and range from elevated rates of mental illness and health\textbackslash ncare challenges to difficulties accessing resources due to language and\textbackslash nliteracy barriers. These factors are largely responsible for the\textbackslash nchallenges resettled refugees face in acquiring and maintaining stable\textbackslash nemployment. It is possible that achieving financial stability through\textbackslash nsteady employment and purposeful money management may alleviate some\textbackslash nstressors associated with the resettlement process, though research in\textbackslash nthis area that is specific to refugees is in its infancy. What is clear,\textbackslash nhowever, is that a traditional approach to mental health treatment\textbackslash n(i.e., therapy in a traditional office setting) may lack effectiveness\textbackslash nbecause of the lack of attention to extraneous stressors such as\textbackslash npoverty, transportation, and language and literacy challenges that\textbackslash nimpact resettled refugees. The purpose of this study was to\textbackslash nqualitatively assess the impact of a group-based financial education\textbackslash ncourse and social enterprise on the self-reported mental health\textbackslash n(i.e.,post-traumatic stress symptoms, depression, anxiety, and\textbackslash nsomatization) of Bhutanese refugee women resettled in the United States.\textbackslash nThe study also sought to evaluate the acceptability and overall\textbackslash nsatisfaction with various components of the intervention. This\textbackslash nqualitative study was a follow-up to a larger quantitative study that\textbackslash nincluded 65 Bhutanese women who were resettled to the southwestern\textbackslash nUnited States by a large resettlement agency. The results of this study\textbackslash noffer insights into the lived experiences of Bhutanese refugees in the\textbackslash nUnited States, particularly related to cultural integration bolstered by\textbackslash ngroup-based education and shared learning opportunities.},
  keywords = {\#nosource,Mental health,qualitative,refugees,social enterprise}
}

