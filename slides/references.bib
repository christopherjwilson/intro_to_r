@article{EpsteinYuthas2017,
  title = {Cash {{Flow Training}} and {{Improved Microfinance Outcomes}}.},
  author = {Epstein, Marc J and Yuthas, Kristi},
  date = {2017-01},
  journaltitle = {Journal of International Development},
  volume = {29},
  number = {1},
  pages = {106--116},
  publisher = {{John Wiley \& Sons, Inc.}},
  issn = {09541748},
  url = {http://10.0.3.234/jid.2918 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=120669286{&}site=bsi-live},
  abstract = {Despite its promise as a powerful tool for alleviating poverty, research suggests that microfinance has had only a modest impact on development. Misallocation of funds by clients has been implicated as a major impediment to microfinance success. In this study, clients received training on how to track (but not manage) their cash flows during the first two meetings of the microfinance loan cycle. Examination of weekly cash flow shows that clients immediately invested the majority of their funds into the businesses and carefully managed revenues and expenditures to maintain sufficient food and other household expenditures throughout the loan cycle. It is not possible to know whether this behaviour occurred as a result of monitoring cash flow because clients who do not keep cash flow records do not have a reliable way to report expenditures. However, exit interviews provide evidence that cash flow tracking enhanced financial performance and control. When asked whether tracking cash flows affected their understanding and behaviour, half or more of the subjects responded that tracking their cash flow helped them to understand the importance of investing in the business, identify unnecessary expenditures and/or develop a better understanding of their revenues, expenses and profit. By investing a small amount of time in helping clients track cash flows, lenders can empower clients and potentially improve both the repayment and productive benefits of the loans they make. Copyright \textcopyright{} 2013 John Wiley \& Sons, Ltd. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,business development services,business training,Cash flow,cash flow tracking,Consumption (Economics),financial diaries,financial literacy,Loan agreements,microfinance,Microfinance,Nicaragua,poverty alleviation,Poverty reduction}
}

