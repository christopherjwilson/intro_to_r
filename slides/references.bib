  doi = {10.1111/joca.12187},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2018-16771-001{&}site=ehost-live orcid: 0000-0002-4413-0590},
  abstract = {This paper analyzes the importance of numerical abilities, conscientiousness, and financial literacy for individuals' financial decision making and participation in formal financialmarkets.Our analysis is based on the Financial Capabilities Survey, which was applied in four countries of the Andean Region: Bolivia, Colombia, Ecuador, and Peru. The empirical analysis underlines the centrality of numerical abilities, dif- ferent subfacets of conscientiousness (propensity to plan, perseverance, and scrupulosity), and financial literacy in developing a propensity to save and borrow, and in participating in the formal financial sector},
  keywords = {\#nosource,No terms assigned}
}

