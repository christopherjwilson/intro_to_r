@article{SmeetsBarnes-Holmes2003b,
  title = {Children's Emergent Preferences for Soft Drinks: {{Stimulus-equivalence}} and Transfer},
  shorttitle = {Children's Emergent Preferences for Soft Drinks},
  author = {Smeets, Paul M and Barnes-Holmes, Dermot},
  date = {2003-10},
  journaltitle = {Journal of Economic Psychology},
  shortjournal = {Journal of Economic Psychology},
  volume = {24},
  number = {5},
  pages = {603--618},
  issn = {01674870},
  doi = {10.1016/S0167-4870(03)00004-7},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0167487003000047},
  urldate = {2022-10-07},
  abstract = {Two experiments were conducted, each with 16 5-year-old children. In Experiment 1, the children were trained on two sets of match-to-sample tasks: B1\textendash A1, B2\textendash A2 and C1\textendash B1, C2\textendash B2, or A1\textendash B1, A2\textendash B2 and B1\textendash C1, B2\textendash C2. Stimuli A1 and A2 were the pictures of a smiling cartoon character and of a crying child, respectively. The B and C stimuli were arbitrarily selected geometric shapes and symbols, respectively. After having learned both tasks, the children were tested for equivalence responding (e.g., C1\textendash A1, C2\textendash A2). Finally, the subjects were presented with two samples of a same soft drink, one with label C1 and one with label C2. The subjects were asked to indicate which drink they would like to taste first. After having tasted both drinks, they were required to indicate which drink they preferred. Finally, they were asked which picture they liked most, A1 or A2. Experiment 2 was the same but without the equivalence test. Across both experiments, 29/32 children (91\%) first wanted to taste the drink with the label (C1 or C2) that was indirectly related to the preferred picture (A1 or A2). After tasting both drinks, 26 of these children (90\%) indicated that they also preferred that drink. These findings are consistent with and extend previous research on emergent preferences in adults [Barnes-Holmes et al., Psychol. Record 50 (2000) 493].},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Kahneman, Tversky_Unknown_Choices, values, and frames(5).pdf}
}

