@article{wolffHowDefineMeasure2019,
  title = {How to Define and Measure Risk Perceptions},
  author = {Wolff, Katharina and Larsen, Svein and Øgaard, Torvald},
  date = {2019-11-01},
  journaltitle = {Annals of Tourism Research},
  shortjournal = {Annals of Tourism Research},
  volume = {79},
  pages = {102759},
  issn = {0160-7383},
  doi = {10.1016/j.annals.2019.102759},
  url = {https://www.sciencedirect.com/science/article/pii/S0160738319301161},
  urldate = {2023-10-03},
  abstract = {Research on risk perceptions within the tourism domain suffers from two closely related problems: diverging conceptual and measurement definitions. The lack of precision and standardization is hindering comparisons of findings across studies as well as systematic accumulation of knowledge. The present paper gives some examples of how diverging definitions of risk may constitute a serious problem. It also shows how measures of perceived risk are influenced by various heuristics and biases via item wording. Lacking awareness of the effects of these biases may lead to erroneous conclusions regarding the relative risk of various hazards. The paper concludes with specific suggestions for how some of these problems can be tackled, and should be of practical use for tourism scholars researching risk perceptions.},
  keywords = {Item wording,Perceived risk,Psychometric risk research,Standardization of measurement,Tourism risk research},
  file = {/home/chris/Zotero/storage/VJB7VEUY/Wolff et al_2019_How to define and measure risk perceptions.pdf;/home/chris/Zotero/storage/Y6G7XMHP/Wolff et al_2019_How to define and measure risk perceptions.pdf;/home/chris/Zotero/storage/LRUDVK4Y/S0160738319301161.html}
}

@article{wolffReadySetGo2019,
  title = {Ready, Set, Go: {{Cortical}} Hemodynamics during Self-Controlled Sprint Starts},
  shorttitle = {Ready, Set, Go},
  author = {Wolff, Wanja and Thürmer, J. Lukas and Stadler, Kim-Marie and Schüler, Julia},
  date = {2019-03-01},
  journaltitle = {Psychology of Sport and Exercise},
  shortjournal = {Psychology of Sport and Exercise},
  volume = {41},
  pages = {21--28},
  issn = {1469-0292},
  doi = {10.1016/j.psychsport.2018.11.002},
  url = {https://www.sciencedirect.com/science/article/pii/S1469029218304679},
  urldate = {2024-05-14},
  abstract = {Objectives Successful sprint starts require self-control: Athletes need to avoid a false start (impulse control) and at the same time need to start as fast as possible (action initiation). Research from cognitive neuroscience shows that such self-control acts hinge on activity in areas in the lateral Prefrontal Cortex (lPFC). We are harnessing these findings in order to accurately analyze and better understand the neural basis of self-controlled sprint start performance. Design In a within-subject experimental design, participants executed three different sprint start sequences (Ready-Set-Go) for ten times each. In the no-start condition, participants only had to avoid producing a false start (impulse control) and in the experimental conditions - either with fixed or with supposedly variable set-start intervals - they additionally had to execute a fast start (impulse control~+~action initiation). Methods We used functional near-infrared spectroscopy (fNIRS) to assess cerebral oxygenation in the lPFC during sprint start in 33 male participants. Results Results show that cerebral oxygenation increased after the set-signal and this increase was particularly pronounced in the fixed and supposedly-variable start conditions. Post-hoc analyses further indicated that oxygenation differences between no-start and the two start conditions were particularly pronounced in anterior parts of the LPFC. Discussion This is the first study to reveal oxygenation changes in self-control relevant cortical areas during sprint start performance. This substantiates the claim that sprint starts impose self-control demands and provides a much called for application of neuroscience findings to the sport context.},
  keywords = {Cognitive control,fNIRS,Prefrontal cortex,Self-control,Sprint},
  file = {/home/chris/Zotero/storage/BKSBXQRU/S1469029218304679.html}
}

@article{wolgastCognitiveReappraisalAcceptance2011,
  title = {Cognitive Reappraisal and Acceptance: {{An}} Experimental Comparison of Two Emotion Regulation Strategies},
  shorttitle = {Cognitive Reappraisal and Acceptance},
  author = {Wolgast, Martin and Lundh, Lars-Gunnar and Viborg, Gardar},
  date = {2011-12},
  journaltitle = {Behaviour Research and Therapy},
  shortjournal = {Behaviour Research and Therapy},
  volume = {49},
  number = {12},
  eprint = {21999941},
  eprinttype = {pubmed},
  pages = {858--866},
  publisher = {Elsevier Ltd},
  issn = {00057967},
  doi = {10.1016/j.brat.2011.09.011},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0005796711002233},
  urldate = {2022-10-07},
  abstract = {The purpose of the present study was to compare the effect of cognitive reappraisal and acceptance on subjective distress, physiological reactions and behavioral avoidance in relation to aversive emotional states elicited by film-clips. Ninety-four participants were randomized to one of three groups. The Reappraisal group was instructed to think about what they saw in a way that minimized negative emotional reactions, the Acceptance group was told to let their feelings come and go without trying to control or avoid them, while the Watch (control) group was told just to watch the film-clips. Compared to the control condition, both reappraisal and acceptance led to significant reductions of subjective distress, physiological reactions associated with aversive emotions and behavioral avoidance. On the three types of measures there were few significant differences between the Reappraisal and Acceptance groups, but when such differences existed they were to the benefit of the Reappraisal condition. In the reappraisal condition there was however a positive correlation between elicited aversive emotion and avoidance, while no such correlation existed in the acceptance condition. The results are interpreted and discussed in relation to the theories underlying reappraisal and acceptance as well as the conceptual framework for emotion regulation established by Gross (2007).},
  langid = {english},
  keywords = {Adolescent,Adult,Avoidance Learning,Cognition,Cognition: physiology,Electromyography,Electromyography: methods,Electromyography: psychology,Emotions,Emotions: physiology,Facial Expression,Female,Galvanic Skin Response,Galvanic Skin Response: physiology,Humans,Male,Middle Aged,nosource,Psychological,Psychological: physiopathology,Psychological: psychology,Social Distance,Stress},
  file = {/home/chris/Zotero/storage/9V53UQU5/Wolgast et al_2011_Cognitive reappraisal and acceptance.pdf;/home/chris/Zotero/storage/FXBI3LC2/Wolgast et al_2011_Cognitive reappraisal and acceptance.pdf}
}

@thesis{wollaEvaluatingEffectivenessOnline2016,
  title = {Evaluating the Effectiveness of an Online Learning Module and Its Impact on Majority Minority and {{African American}} School Populations},
  booktitle = {Dissertation {{Abstracts International Section A}}: {{Humanities}} and {{Social Sciences}}},
  author = {Wolla, Scott A},
  date = {2016},
  volume = {77},
  number = {6-A(E)},
  institution = {ProQuest Information \& Learning},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-42145-187{&}site=ehost-live},
  abstract = {Economic and financial literacy are essential building blocks on which consumers and firms rely when they make economic decisions. The benefits of economic and financial literacy apply to both individuals and the economy more broadly. However, an academic achievement gap exists between schools with a majority population of white students (majority majority) and those with a majority population of minority students (majority minority). Online learning may be one way to address differences in academic achievement between these two school populations. This study used school-level data from 100 schools to examine the effectiveness of Soar to Savings, an online learning module that teaches key personal finance and economics concepts. Further, this study examines the effectiveness of the Soar to Savings module in schools with majority minority, Office of Minority and Women Inclusion (OMWI) African American, and African American majority student populations. Finally, this study examines the relationship between minority status and posttest achievement on the Soar to Savings online module. The findings show large, positive, and statistically significant gains in learning from pretest to posttest for the student-level and school-level samples. In addition, large, positive, statistically significant gains in learning from pretest to posttest were found for majority minority schools, OMWI African American schools, and African American majority schools. Ordinary least squares regression analysis was used to control for prior knowledge and exogenous factors as well as majority minority status. In these models, the pretest score was a statistically significant predictor of posttest achievement, but the variables indicating majority minority status were not statistically significant predictors of the posttest score. The results provide evidence that Soar to Savings is an effective tool for increasing financial knowledge in schools. The findings on the effects of the module with majority minority school populations are promising but require more research. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
  isbn = {0419-4209},
  keywords = {African American school populations,Decision Making,Learning,majority minority,nosource,online learning module,Schools}
}

