  title = {{{THE EFFECTS OF PERSONALITY TRAITS ON FINANCIAL BEHAVIOUR}}},
  author = {Ozer, Gokhan and Mutlu, Ummuhan},
  date = {2019-09-30},
  journaltitle = {Journal of Business Economics and Finance},
  shortjournal = {JBEF},
  volume = {8},
