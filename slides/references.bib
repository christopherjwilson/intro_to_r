@article{BankerEtAl2021,
  title = {Neural Mechanisms of Credit Card Spending},
  author = {Banker, Sachin and Dunfield, Derek and Huang, Alex and Prelec, Drazen},
  date = {2021-02-18},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
  volume = {11},
  number = {1},
  pages = {4070},
  publisher = {{Nature Publishing Group}},
  issn = {2045-2322},
  doi = {10.1038/s41598-021-83488-3},
  url = {https://www.nature.com/articles/s41598-021-83488-3},
  urldate = {2022-06-23},
  abstract = {Credit cards have often been blamed for consumer overspending and for the growth in household debt. Indeed, laboratory studies of purchase behavior have shown that credit cards can facilitate spending in ways that are difficult to justify on purely financial grounds. However, the psychological mechanisms behind this spending facilitation effect remain conjectural. A leading hypothesis is that credit cards reduce the pain of payment and so `release the brakes' that hold expenditures in check. Alternatively, credit cards could provide a `step on the gas,' increasing motivation to spend. Here we present the first evidence of differences in brain activation in the presence of real credit and cash purchase opportunities. In an fMRI shopping task, participants purchased items tailored to their interests, either by using a personal credit card or their own cash. Credit card purchases were associated with strong activation in the striatum, which coincided with onset of the credit card cue and was not related to product price. In contrast, reward network activation weakly predicted cash purchases, and only among relatively cheaper items. The presence of reward network activation differences highlights the potential neural impact of novel payment instruments in stimulating spending\textemdash these fundamental reward mechanisms could be exploited by new payment methods as we transition to a purely cashless society.},
  issue = {1},
  langid = {english},
  keywords = {Human behaviour,Neuroscience},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Banker et al_2021_Neural mechanisms of credit card spending.pdf;C\:\\Users\\wilso\\Zotero\\storage\\V5ZAVJXX\\s41598-021-83488-3.html}
}

