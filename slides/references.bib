  pages = {206--221},
  publisher = {{Oxford University Press}},
  location = {{New York, NY}},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2017-30939-018{&}site=ehost-live},
  abstract = {How did you feel when you read the title of this chapter? How you feel about money and money management in your life can help you to determine whether you want a simple, easy-to-follow guide or a complex, sophisticated, professionally informed set of documents that make up a comprehensive financial plan. Be honest with yourself about your level of motivation and your interest in planning your financial future; it is the first step toward knowing how to proceed. Your financial plan has to work for you and can vary from a simple one-page guide with 'rules of thumb'' to multiple binders full of graphs, pie charts, projections, assumptions, actionable items, goals, and potential barriers to success. Recent research has shown that general rules of thumb for decision making can be more effective for some people than traditional financial education. In financial planning, as with many important endeavors, getting started may be the most challenging aspect. As a mental health professional, you can understand and empathize with clients who are reluctant to engage in a process that is unknown and anxiety arousing. Not knowing how to start, whom to trust, and which of the bewildering array of choices to pursue can be just as paralyzing to you as it is to potential clients seeking mental health services. In addition, you may feel resistant to an honest examination of your finances, procrastinating and delaying gathering and integrating the information that is necessary to see the bigger picture. A recent study by Britt, Klontz, Tibbetts, and Leitz suggests that mental health professionals may be 'money avoidant'. These authors found that compared to other occupations, mental health professionals were at greater financial risk in terms of carrying credit card debt, setting money aside for emergencies, having a spending plan, and having adequate investment strategies. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
  isbn = {978-0-19-027216-6},
  keywords = {\#nosource,clients,Finance,Financial Literacy,financial planning,Private Practice,private practitioners}
}

