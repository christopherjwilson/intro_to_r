  url = {https://linkinghub.elsevier.com/retrieve/pii/S0167268114000304},
  urldate = {2022-10-07},
  abstract = {Decision-makers show an increased risk appetite when they gamble with previously won money, the house money effect, and when they have a chance to make up for a prior loss, the break even effect. To explore the origins of these effects, we use functional magnetic resonance imaging to record the brain activities of subjects while they make sequential risky choices. The behavioral data from our experiment confirm the path dependence of choices, despite the short trial duration and the many task repetitions required for neuroimaging. The brain data yield evidence that the increased risk appetite after gains and losses is related to an increased activity of affective brain processes and a decreased activity of deliberative brain processes.},
  langid = {english},
