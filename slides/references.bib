@article{MendezEtAl2014,
  title = {Institutional Racism, Neighborhood Factors, Stress, and Preterm Birth.},
  author = {Mendez, Dara D and Hogan, Vijaya K and Culhane, Jennifer F},
  date = {2014-09},
  journaltitle = {Ethnicity \& Health},
  volume = {19},
  number = {5},
  pages = {479--499},
  publisher = {{Routledge}},
  issn = {13557858},
  url = {http://10.0.4.56/13557858.2013.846300 http://search.ebscohost.com/login.aspx?direct=true{&}db=pbh{&}AN=96869153{&}site=ehost-live},
  abstract = {Objective.Racial/ethnic disparities in the risk of preterm birth may be explained by various factors, and previous studies are limited in examining the role of institutional racism. This study focused on the following questions: what is the association between preterm birth and institutional racism as measured by residential racial segregation (geographic separation by race) and redlining (black\textendash white disparity in mortgage loan denial); and what is the association between preterm birth and reported stress, discrimination, and neighborhood quality. Design.We used data from a clinic-based sample of pregnant women (n= 3462) participating in a stress and pregnancy study conducted from 1999 to 2004 in Philadelphia, PA (USA). We linked data from the 2000 US Census and Home Mortgage Disclosure Act (HMDA) data from 1999 to 2004 and developed measures of residential redlining and segregation. Results.Among the entire population, there was an increased risk for preterm birth among women who were older, unmarried, tobacco users, higher number of previous births, high levels of experiences of everyday discrimination, owned their homes, lived in nonredlined areas, and areas with high levels of segregation measured by the isolation index. Among black women, living in a redlined area (where blacks were more likely to be denied mortgage loans compared to whites) was moderately associated with a decreased risk of preterm birth (aRR = 0.8, 95\% CI: 0.6, 0.99). Conclusion.Residential redlining as a form institutional racism and neighborhood characteristic may be important for understanding racial/ethnic disparities in pregnancy and preterm birth. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,BLACKS,CHI-squared test,COMMUNITIES,CONFIDENCE intervals,DATA analysis,DATA analysis software,DESCRIPTIVE statistics,EDUCATIONAL attainment -- Evaluation,HISPANIC Americans,INCOME,INTER-observer reliability,INTERVIEWING,MARITAL status,PENNSYLVANIA,PREGNANCY,RACISM,RELATIVE risk (Medicine),RISK factors in premature labor,SELF-evaluation,STATISTICS,STRESS (Psychology),SURVEYS,WHITE people}
}

