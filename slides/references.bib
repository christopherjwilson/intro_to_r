  location = {["Cambridge Hlth Alliance, Dept Psychiat, Cambridge, MA 02139 USA", "Cambridge Hlth Alliance, Div Addict, Cambridge, MA 02139 USA", "Univ Sydney, Sch Pesychol, Fac Sci, Brain \& Mind Ctr, Sydney, NSW, Australia", "Laval Univ, Quebec City, PQ, Canada"]},
