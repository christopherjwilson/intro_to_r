  author = {Håkansson, Anders and Jönsson, Caroline and Kenttä, Göran},
  date = {2020-09-14},
  journaltitle = {International journal of environmental research and public health},
  shortjournal = {International journal of environmental research and public health},
  volume = {17},
  number = {18},
  publisher = {MDPI},
