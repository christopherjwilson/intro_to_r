@article{HuangKuo2012,
  title = {How Impulsivity Affects Consumer Decision-Making in e-Commerce},
  author = {Huang, Yu Feng and Kuo, Feng Yang},
  date = {2012-11},
  journaltitle = {Electronic Commerce Research and Applications},
  volume = {11},
  number = {6},
  pages = {582--590},
  publisher = {{Elsevier}},
  issn = {15674223},
  doi = {10.1016/j.elerap.2012.09.004},
  url = {https://www.sciencedirect.com/science/article/pii/S1567422312000774},
  abstract = {This research investigates whether a person's mood can influence impulsivity in online shopping decisions, and how involvement can regulate it. We adopt a process view of impulsivity, and recorded the detailed information search patterns of consumers using an eye-tracker methodology. The results show that incidental moods tend to increase process impulsivity, and this effect may not be restrained by involvement. We also demonstrate that the decision-making process can be separated into two stages - orientation and evaluation. We further find that differences in impulsivity are most evident in the evaluation stage. These results suggest the importance of mood-elicited impulsivity of purchases in e-commerce. \textcopyright{} 2012 Elsevier B.V. All rights reserved.},
  keywords = {\#nosource,Decision-making,Empirical research,Eye-tracking,Impulsivity,Mood,Online shopping,Purchase behavior},
