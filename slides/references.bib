@article{zhangLosschasingGamblingBehaviour2020,
  title = {Loss-Chasing in Gambling Behaviour: Neurocognitive and Behavioural Economic Perspectives},
  shorttitle = {Loss-Chasing in Gambling Behaviour},
  author = {Zhang, Ke and Clark, Luke},
  date = {2020-02-01},
  journaltitle = {Current Opinion in Behavioral Sciences},
  shortjournal = {Current Opinion in Behavioral Sciences},
  series = {Gambling},
  volume = {31},
  pages = {1--7},
  issn = {2352-1546},
  doi = {10.1016/j.cobeha.2019.10.006},
  url = {https://www.sciencedirect.com/science/article/pii/S2352154619301068},
  urldate = {2025-06-27},
  abstract = {Loss-chasing describes the tendency of a gambler to amplify their betting in an effort to recoup prior losses. It is widely regarded as a defining feature of disordered gambling, and a hallmark of the transition from recreational to disordered gambling. We consider the empirical evidence for this central role of loss-chasing in disordered gambling. We highlight multiple behavioural expressions of chasing, including between-session and within-session chasing. From a neurocognitive perspective, loss-chasing could arise from compromised executive functions including inhibitory control, mood-related impulsivity (urgency) and compulsivity, for which there is compelling evidence in disordered gambling. This view is contrasted with a behavioural economic perspective that emphasizes the subjective valuation of outcomes to the gambler, and may better account for nuances in gamblers’ complex response to loss, such as the significance of ‘breaking even’. Neuroimaging and psychopharmacological research on loss-chasing may help to arbitrate between these two perspectives.},
  file = {/home/chris/Zotero/storage/UD4ACHKS/Zhang and Clark - 2020 - Loss-chasing in gambling behaviour neurocognitive and behavioural economic perspectives.pdf;/home/chris/Zotero/storage/TCPTVZA6/S2352154619301068.html}
}

