  keywords = {Anxiety Symptom,Default Mode Network,Depressive Symptom,Major Depressive Disorder},
  file = {/home/chris/Zotero/storage/MYNBYAGW/Forbes et al._2010_Reward-rel.pdf}
}

@article{fordKeepingYourEyes2010,
  title = {Keeping {{Your Eyes}} on the {{Prize}}: {{Anger}} and {{Visual Attention}} to {{Threats}} and {{Rewards}}},
  shorttitle = {Keeping {{Your Eyes}} on the {{Prize}}},
  author = {Ford, Brett Q. and Tamir, Maya and Brunyé, Tad T. and Shirer, William R. and Mahoney, Caroline R. and Taylor, Holly A.},
  date = {2010-08-01},
  journaltitle = {Psychological Science},
  shortjournal = {Psychol Sci},
  volume = {21},
  number = {8},
  pages = {1098--1105},
  publisher = {SAGE Publications Inc},
  issn = {0956-7976},
  doi = {10.1177/0956797610375450},
  url = {https://doi.org/10.1177/0956797610375450},
  urldate = {2023-10-02},
  abstract = {People?s emotional states influence what they focus their attention on in their environment. For example, fear focuses people?s attention on threats, whereas excitement may focus their attention on rewards. This study examined the effect of anger on overt visual attention to threats and rewards. Anger is an unpleasant emotion associated with approach motivation. If the effect of emotion on visual attention depends on valence, we would expect anger to focus people?s attention on threats. If, however, the effect of emotion on visual attention depends on motivation, we would expect anger to focus people?s attention on rewards. Using an eye tracker, we examined the effects of anger, fear, excitement, and a neutral emotional state on participants? overt visual attention to threatening, rewarding, and control images. We found that anger increased visual attention to rewarding information, but not to threatening information. These findings demonstrate that anger increases attention to potential rewards and suggest that the effects of emotions on visual attention are motivationally driven.},
  file = {/home/chris/Zotero/storage/9CGEIE5Y/Ford et al_2010_Keeping Your Eyes on the Prize.pdf;/home/chris/Zotero/storage/RJHRDIBB/Ford et al_2010_Keeping Your Eyes on the Prize.pdf}
}

