@article{schonbergMindGapBridging2011,
  title = {Mind the Gap: Bridging Economic and Naturalistic Risk-Taking with Cognitive Neuroscience},
  shorttitle = {Mind the Gap},
  author = {Schonberg, Tom and Fox, Craig R. and Poldrack, Russell A.},
  date = {2011-01-01},
  journaltitle = {Trends in Cognitive Sciences},
  shortjournal = {Trends in Cognitive Sciences},
  volume = {15},
  number = {1},
  pages = {11--19},
  issn = {1364-6613},
  doi = {10.1016/j.tics.2010.10.002},
  url = {http://www.sciencedirect.com/science/article/pii/S1364661310002366},
  urldate = {2019-10-11},
  abstract = {Economists define risk in terms of the variability of possible outcomes, whereas clinicians and laypeople generally view risk as exposure to possible loss or harm. Neuroeconomic studies using relatively simple behavioral tasks have identified a network of brain regions that respond to economic risk, but these studies have had limited success predicting naturalistic risk-taking. By contrast, more complex behavioral tasks developed by clinicians (e.g. Balloon Analogue Risk Task and Iowa Gambling Task) correlate with naturalistic risk-taking but resist decomposition into distinct cognitive constructs. We propose here that to bridge this gap and better understand neural substrates of naturalistic risk-taking, new tasks are needed that: are decomposable into basic cognitive and/or economic constructs; predict naturalistic risk-taking; and engender dynamic, affective engagement.},
  file = {/home/chris/Zotero/storage/K2HWFYZM/Schonberg et al_2011_Mind the gap.pdf;/home/chris/Zotero/storage/P95BXJ69/Schonberg et al_2011_Mind the gap.pdf;/home/chris/Zotero/storage/QQBFCYLA/Schonberg et al_2011_Mind the gap.pdf;/home/chris/Zotero/storage/QRRGCX9D/Schonberg et al_2011_Mind the gap.pdf;/home/chris/Zotero/storage/CZVVU5PS/S1364661310002366.html}
}

