@incollection{EgelmanEtAl2013,
  title = {Choice {{Architecture}} and {{Smartphone Privacy}}: {{There}}'s a {{Price}} for {{That}}},
  shorttitle = {Choice {{Architecture}} and {{Smartphone Privacy}}},
  booktitle = {The {{Economics}} of {{Information Security}} and {{Privacy}}},
  author = {Egelman, Serge and Felt, Adrienne Porter and Wagner, David},
  editor = {B\"ohme, Rainer},
  date = {2013},
  pages = {211--236},
  publisher = {{Springer}},
  location = {{Berlin, Heidelberg}},
  doi = {10.1007/978-3-642-39498-0_10},
  url = {https://doi.org/10.1007/978-3-642-39498-0_10},
  urldate = {2021-11-26},
  abstract = {Under certain circumstances, consumers are willing to pay a premium for privacy. We explore how choice architecture affects smartphone users' stated willingness to install applications that request varying permissions. We performed two experiments to gauge smartphone users' stated willingness to pay premiums to limit their personal information exposure when installing applications. When participants were comparison shopping between multiple applications that performed similar functionality, a quarter of our sample indicated a willingness to pay a \$1.50 premium for the application that requested the fewest permissions\textemdash though only when viewing the requested permissions of each application side-by-side. In a second experiment, we more closely simulated the user experience by asking them to valuate a single application that featured multiple sets of permissions based on five between-subjects conditions. In this scenario, the requested permissions had a much smaller impact. Our results suggest that many smartphone users are concerned with their privacy and are willing to pay premiums for applications that are less likely to request access to personal information, but that the current choice architectures do not support this. We propose improvements for smartphone application markets that could result in decreased satisficing and increased rational behavior.},
  isbn = {978-3-642-39498-0},
  langid = {english},
  keywords = {Choice Architecture,Location Privacy,Privacy Concern,Reverse Auction,Send Text Message},
  file = {C:\Users\wilso\Zotero\storage\TI9YFYA8\Egelman et al. - 2013 - Choice Architecture and Smartphone Privacy There’.pdf}
}

@article{EhringEtAl2011,
