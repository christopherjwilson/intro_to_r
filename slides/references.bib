@article{FriesenKingstone2003,
  title = {Abrupt Onsets and Gaze Direction Cues Trigger Independent Reflexive Attentional Effects},
  author = {Friesen, Chris Kelland and Kingstone, Alan},
  date = {2003},
  journaltitle = {Cognition},
  volume = {87},
  number = {1},
  eprint = {12499107},
  eprinttype = {pmid},
  pages = {291--293},
  issn = {00100277},
  doi = {10.1016/S0010-0277(02)00181-6},
  abstract = {The present study investigated whether the detection of visual signals is influenced independently by two automatic visual orienting phenomena: orienting to a gazed-at location and inhibition of return (IOR) to the location of an abrupt onset. A schematic face served as both a nonpredictive gaze direction cue and an abrupt onset cue. Results indicated that target detection was facilitated at the gazed-at location, and that it was inhibited at the abrupt onset location. Importantly, these two different reflexive attention effects were triggered by the same event and exhibited overlapping time courses. Moreover, the IOR effect did not vary as a function of the facilitatory effect of gaze. These findings strongly suggest that reflexive attention to gaze direction and reflexive inhibition to an abrupt onset are independent processes, and that gaze direction does not produce IOR at the gazed-at location. ?? 2002 Elsevier Science B.V. All rights reserved.},
  isbn = {0010-0277 (Print)},
  keywords = {\#nosource,Gaze direction,Inhibition of return,Reflexive orienting,Visual attention},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Friesen_Kingstone_2003_Abrupt onsets and gaze direction cues trigger independent reflexive attentional.pdf}
}

