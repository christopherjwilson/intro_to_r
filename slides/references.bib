@article{HoffmannShefrin2014,
  title = {Technical {{Analysis}} and {{Individual Investors}}},
  author = {Hoffmann, Arvid O. I. and Shefrin, Hersh},
  date = {2014-11},
  journaltitle = {Journal of Economic Behavior \& Organization},
  series = {Empirical {{Behavioral Finance}}},
  volume = {107},
  pages = {487--511},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2014.04.002},
  abstract = {We find that individual investors who use technical analysis and trade options frequently make poor portfolio decisions, resulting in dramatically lower returns than other investors. The data on which this claim is based consists of transaction records and matched survey responses of a sample of Dutch discount brokerage clients for the period 2000\textendash 2006. Overall, our results indicate that individual investors who report using technical analysis are disproportionately prone to have speculation on short-term stock-market developments as their primary investment objective, hold more concentrated portfolios which they turn over at a higher rate, are less inclined to bet on reversals, choose risk exposures featuring a higher ratio of nonsystematic risk to total risk, engage in more options trading, and earn lower returns.},
  keywords = {\#nosource,Behavioral finance,Household finance,Individual investors,Investor behavior,Investor performance,Speculation,Technical analysis}
}

@article{HofmannEtAl2012,
  title = {What {{People Desire}}, {{Feel Conflicted About}}, and {{Try}} to {{Resist}} in {{Everyday Life}}},
  author = {Hofmann, Wilhelm and Vohs, Kathleen D. and Baumeister, Roy F.},
  date = {2012-06-01},
  journaltitle = {Psychological Science},
  shortjournal = {Psychol Sci},
  volume = {23},
  number = {6},
  pages = {582--588},
  issn = {0956-7976},
  doi = {10.1177/0956797612437426},
  url = {https://doi.org/10.1177/0956797612437426},
  urldate = {2019-02-21},
  abstract = {In the present study, we used experience sampling to measure desires and desire regulation in everyday life. Our analysis included data from 205 adults, who furnished a total of 7,827 reports of their desires over the course of a week. Across various desire domains, results revealed substantial differences in desire frequency and strength, the degree of conflict between desires and other goals, and the likelihood of resisting desire and the success of this resistance. Desires for sleep and sex were experienced most intensively, whereas desires for tobacco and alcohol had the lowest average strength, despite the fact that these substances are thought of as addictive. Desires for leisure and sleep conflicted the most with other goals, and desires for media use and work brought about the most self-control failure. In addition, we observed support for a limited-resource model of self-control employing a novel operationalization of cumulative resource depletion: The frequency and recency of engaging in prior self-control negatively predicted people's success at resisting subsequent desires on the same day.},
  langid = {english},
  keywords = {\#nosource},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Hofmann et al_2012_What People Desire, Feel Conflicted About, and Try to Resist in Everyday Life.pdf;C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Hofmann et al. - 2012 - What People Desire, Feel Conflicted About, and Try.pdf}
}

@article{HofmannHayes2019,
  title = {The {{Future}} of {{Intervention Science}}: {{Process-Based Therapy}}},
  shorttitle = {The {{Future}} of {{Intervention Science}}},
  author = {Hofmann, Stefan G. and Hayes, Steven C.},
  date = {2019-01-01},
  journaltitle = {Clinical Psychological Science},
  volume = {7},
  number = {1},
  pages = {37--50},
  publisher = {{SAGE Publications Inc}},
  issn = {2167-7026},
  doi = {10.1177/2167702618772296},
  url = {https://doi.org/10.1177/2167702618772296},
  urldate = {2023-09-25},
  abstract = {Clinical science seems to have reached a tipping point. It appears that a new paradigm is beginning to emerge that is questioning the validity and utility of the medical illness model, which assumes that latent disease entities are targeted with specific therapy protocols. A new generation of evidence-based care has begun to move toward process-based therapies to target core mediators and moderators based on testable theories. This could represent a paradigm shift in clinical science with far-reaching implications. Clinical science might see a decline of named therapies defined by set technologies, a decline of broad schools, a rise of testable models, a rise of mediation and moderation studies, the emergence of new forms of diagnosis based on functional analysis, a move from nomothetic to idiographic approaches, and a move toward processes that specify modifiable elements. These changes could integrate or bridge different treatment orientations, settings, and even cultures.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Hofmann_Hayes_2019_The Future of Intervention Science.pdf}
}

@article{HogarthEtAl2011,
  title = {Emotion and Reason in Everyday Risk Perception},
  author = {Hogarth, Robin M. and Portell, Mariona and Cuxart, Anna and Kolev, Gueorgui I.},
  date = {2011},
  journaltitle = {Journal of Behavioral Decision Making},
  volume = {24},
  number = {2},
  pages = {202--222},
  issn = {1099-0771},
  doi = {10.1002/bdm.689},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bdm.689},
  urldate = {2022-04-13},
  abstract = {Although research has documented the importance of emotion in risk perception, little is known about it in the context of everyday life. Using the Experience Sampling Method (ESM), 94 part-time students were prompted at random\textemdash via cellular telephones\textemdash to report on mood state and three emotions and to assess risk on thirty occasions during their working hours. The emotions\textemdash valence, arousal, and dominance\textemdash were measured using self-assessment manikins (SAMs) (Bradley \& Lang, 1994). Hierarchical linear models (HLM) revealed that mood state and emotions explained significant variance in risk perception. In addition, valence and arousal accounted for variance over and above ``reason'' (measured by severity and possibility of risks). Six risks were re-assessed in a post-experimental session and found to be lower than their real-time counterparts. The study demonstrates the feasibility and value of collecting representative samples of data with simple technology. Evidence is also provided to demonstrate the statistical consistency of the HLM estimates. Copyright \textcopyright{} 2010 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {emotional reactions,experience sampling method,multilevel analysis,representative design,retrospective judgment,risk perception,self-assessment manikins (SAMs)},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Hogarth et al_2011_Emotion and reason in everyday risk perception.pdf;C\:\\Users\\wilso\\Zotero\\storage\\Q8EFZIRH\\bdm.html}
}

