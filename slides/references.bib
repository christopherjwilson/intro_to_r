  volume = {57},
  number = {3},
  pages = {773--786},
  issn = {03608352},
  doi = {10.1016/j.cie.2009.02.005},
  url = {http://10.0.3.248/j.cie.2009.02.005 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=44101483{&}site=ehost-live},
  abstract = {A profitable decision policy between a supplier and the retailers can be characterized by an agreement on the trade credit scenario such as permissible delay in payments. In real life business, we observe that the demand is a function of both the selling price and credit period rather than the constant demand. Incorporating this demand function to the retailer of a supply chain, we develop an EPQ - based model for perishable items under two-echelon trade financing. The purpose of this paper is to maximize the profit by determining the optimal selling price, credit period and replenishment time. It is shown that the model developed by Jaggi et al. [Jaggi, J. K., Goyal, S. K., \& Goel, S. K., 2008. Retailer's optimal replenishment decisions with creditlinked demand under permissible delay in payments. European Journal of Operational Research, 190, 130-135] can be treated as a special case of this paper. Finally, through numerical examples, sensitivity analysis shows the influence of key model parameters. © 2009 Elsevier Ltd. All rights reserved.},
  keywords = {EPQ model,nosource,Perishable items,Supply chain,Two-level trade credit financing}
}

