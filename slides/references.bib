@article{olatunjiEmotionalExpressionsVisual2011,
  title = {Emotional Expressions and Visual Search Efficiency: {{Specificity}} and Effects of Anxiety Symptoms.},
  shorttitle = {Emotional Expressions and Visual Search Efficiency},
  author = {Olatunji, Bunmi O. and Ciesielski, Bethany G. and Armstrong, Thomas and Zald, David H.},
  date = {2011},
  journaltitle = {Emotion},
  shortjournal = {Emotion},
  volume = {11},
  number = {5},
  pages = {1073--1079},
  issn = {1931-1516, 1528-3542},
  doi = {10.1037/a0021785},
  url = {http://doi.apa.org/getdoi.cfm?doi=10.1037/a0021785},
  urldate = {2022-10-07},
  abstract = {Although facial expressions are thought to vary in their functional impact on perceivers, experimental demonstration of the differential effects of facial expressions on behavior are lacking. In the present study, we examined the effects of exposure to facial expressions on visual search efficiency. Participants (n ϭ 31) searched for a target in a 12 location circle array after exposure to an angry, disgusted, fearful, happy, or neutral facial expression for 100 ms or 500 ms. Consistent with predictions, exposure to a fearful expression prior to visual search resulted in faster target identification compared to exposure to other facial expressions. The effects of other facial expressions on visual search did not differ from each other. The fear facilitating effect on visual search efficiency was observed at 500-ms but not at 100-ms presentations, suggesting a specific temporal course of the facilitation. Subsequent analysis also revealed that individual differences in fear of negative evaluation, trait anxiety, and obsessive– compulsive symptoms possess a differential pattern of association with visual search efficiency. The experimental and clinical implications of these findings are discussed.},
  langid = {english},
  file = {/home/chris/Zotero/storage/3VU7VGGS/Olatunji et al_2011_Emotional expressions and visual search efficiency.pdf;/home/chris/Zotero/storage/UVEJ9NUX/Olatunji et al_2011_Emotional expressions and visual search efficiency.pdf}
}

