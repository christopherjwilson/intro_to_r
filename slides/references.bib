@thesis{Wolla2016,
  title = {Evaluating the Effectiveness of an Online Learning Module and Its Impact on Majority Minority and {{African American}} School Populations},
  booktitle = {Dissertation {{Abstracts International Section A}}: {{Humanities}} and {{Social Sciences}}},
  author = {Wolla, Scott A},
  date = {2016},
  volume = {77},
  number = {6-A(E)},
  institution = {{ProQuest Information \& Learning}},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-42145-187{&}site=ehost-live},
  abstract = {Economic and financial literacy are essential building blocks on which consumers and firms rely when they make economic decisions. The benefits of economic and financial literacy apply to both individuals and the economy more broadly. However, an academic achievement gap exists between schools with a majority population of white students (majority majority) and those with a majority population of minority students (majority minority). Online learning may be one way to address differences in academic achievement between these two school populations. This study used school-level data from 100 schools to examine the effectiveness of Soar to Savings, an online learning module that teaches key personal finance and economics concepts. Further, this study examines the effectiveness of the Soar to Savings module in schools with majority minority, Office of Minority and Women Inclusion (OMWI) African American, and African American majority student populations. Finally, this study examines the relationship between minority status and posttest achievement on the Soar to Savings online module. The findings show large, positive, and statistically significant gains in learning from pretest to posttest for the student-level and school-level samples. In addition, large, positive, statistically significant gains in learning from pretest to posttest were found for majority minority schools, OMWI African American schools, and African American majority schools. Ordinary least squares regression analysis was used to control for prior knowledge and exogenous factors as well as majority minority status. In these models, the pretest score was a statistically significant predictor of posttest achievement, but the variables indicating majority minority status were not statistically significant predictors of the posttest score. The results provide evidence that Soar to Savings is an effective tool for increasing financial knowledge in schools. The findings on the effects of the module with majority minority school populations are promising but require more research. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
  isbn = {0419-4209},
  keywords = {\#nosource,African American school populations,Decision Making,Learning,majority minority,online learning module,Schools}
}

