@article{sawakiHyperfocusingAttentionGoalrelated2017,
  title = {Hyperfocusing of Attention on Goal-Related Information in Schizophrenia: {{Evidence}} from Electrophysiology.},
  shorttitle = {Hyperfocusing of Attention on Goal-Related Information in Schizophrenia},
  author = {Sawaki, Risa and Kreither, Johanna and Leonard, Carly J. and Kaiser, Samuel T. and Hahn, Britta and Gold, James M. and Luck, Steven J.},
  date = {2017-01},
  journaltitle = {Journal of Abnormal Psychology},
  shortjournal = {Journal of Abnormal Psychology},
  volume = {126},
  number = {1},
  pages = {106--116},
  issn = {1939-1846, 0021-843X},
  doi = {10.1037/abn0000209},
  url = {http://doi.apa.org/getdoi.cfm?doi=10.1037/abn0000209},
  urldate = {2023-07-13},
  abstract = {Schizophrenia clearly involves impairments of attention, but the precise nature of these impairments has been difficult to determine. One possibility is that the deficit in attention is a secondary consequence of a deficit in goal maintenance. However, recent research suggests that people with schizophrenia (PSZ) actually focus attention more strongly on objects containing goal-relevant features. To test these competing hypotheses, we recorded event-related potentials (ERPs) from PSZ (N = 20) and healthy control subjects (HCS, N = 20) while they looked for a particular target color at fixation and tried to ignore lateral distractors that sometimes matched the target color (target-color distractors). Goal maintenance was made trivially easy by the continual presentation of a goal reminder. We found that HCS were able to successfully suppress target-color distractors (leading to a PD ERP component), whereas PSZ focused attention on these items (leading to an N2pc ERP component). This suggests that, when maintaining a task set, PSZ engage in aberrant focusing of attention, or hyperfocusing, onto goalrelevant features.},
  langid = {english},
  file = {/home/chris/Zotero/storage/4VARJJIY/Sawaki et al_2017_Hyperfocusing of attention on goal-related information in schizophrenia.pdf;/home/chris/Zotero/storage/8DVL7AG4/Sawaki et al_2017_Hyperfocusing of attention on goal-related information in schizophrenia2.pdf;/home/chris/Zotero/storage/B7PWRRI5/2016-47862-001.pdf;/home/chris/Zotero/storage/DGHZ7LYX/Sawaki et al_2017_Hyperfocusing of attention on goal-related information in schizophrenia.pdf}
}

@inproceedings{schaaffMeasuringEmotionalArousal2013,
  title = {Measuring {{Emotional Arousal}} for {{Online Applications}}: {{Evaluation}} of {{Ultra-Short Term Heart Rate Variability Measures}}},
  shorttitle = {Measuring {{Emotional Arousal}} for {{Online Applications}}},
  booktitle = {2013 {{Humaine Association Conference}} on {{Affective Computing}} and {{Intelligent Interaction}}},
