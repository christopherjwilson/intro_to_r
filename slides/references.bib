@article{qureshiExecutiveFunctionNecessary2010,
  title = {Executive Function Is Necessary for Perspective Selection, Not {{Level-1}} Visual Perspective Calculation: Evidence from a Dual-Task Study of Adults.},
  author = {Qureshi, Adam W and Apperly, Ian A and Samson, Dana},
  date = {2010-11},
  journaltitle = {Cognition},
  volume = {117},
