@article{stewartCorrelatesHealthcareFinancial2018,
  title = {Correlates of Healthcare and Financial Decision Making among Older Adults without Dementia},
  author = {Stewart, Christopher C. and Yu, Lei and Wilson, Robert S. and Bennett, David A. and Boyles, Patricia A.},
  date = {2018-07},
  journaltitle = {Health Psychology},
  volume = {37},
  number = {7},
  pages = {618--626},
  publisher = {American Psychological Association},
  location = {Stewart, Christopher C., Department of Behavioral Sciences, Rush University Medical Center, 1645 West Jackson Boulevard, Suite 400, Chicago, IL, US, 60612},
