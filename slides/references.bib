@incollection{farnsworthIntersectionsIdentityIdeology2012,
  title = {Intersections of Identity and Ideology in Learning about Financial Capability.},
  booktitle = {Reframing Financial Literacy: {{Exploring}} the Value of Social Currency.},
  author = {Farnsworth, Valerie},
  editor = {Lucey, Thomas A and Laney, James D},
  date = {2012},
  pages = {149--169},
  publisher = {IAP Information Age Publishing},
  location = {Charlotte, NC},
  issn = {978-1-61735-719-0 (Paperback); 978-1-61735-720-6 (Hardcover); 978-1-61735-721-3 (PDF)},
  url = {http://ovidsp.ovid.com/ovidweb.cgi?T=JS{&}PAGE=reference{&}D=psyc9{&}NEWS=N{&}AN=2012-18170-008},
  abstract = {Cartesian dichotomies continue to structure Western ideologies and 'Discourses' (Gee, 1999). This chapter will argue that Discourses about the meaning of financially capability in the United Kingdom are structured in relation to a rational/emotional dichotomy. Interviews conducted by a team of researchers at the University of Manchester, who inquired into the ways that young people in the United Kingdom learn about finance, also reflected this Discourse. Students' talk about personal financial management practices, ideals, and expectations was found to be similar to the comments made by Flanders (2010) in that they drew from similar dichotomies. The Discourse, which the following analysis will present, effectively perpetuates an ideology of individualism and sets up rational decisions as distinct from (and even corrupted by) emotional and moral considerations. Another well-established dichotomy which sets public and private domains as distinct and separate also supports an emphasis on individual financial choices and rational decision making. As such, these mutually supportive dichotomies of emotional/rational and public/private structure financial capability education so as to subvert discussions and actions that are initiated in the name of the public good and social justice. This chapter focuses on the ways particular ideologies and Discourses are substantiated, sustained, and circulated, but also challenged and resisted in financial capability education. It is proposed that the propagation of these dichotomies in financial capability education (e.g., one is either emotional or rational, and decisions are private not public matters) is not only problematic from a social justice perspective, but also a mythical one. It is also proposed that a more dialectical view is needed in order to realize the inter-dependencies of the 'public' and the 'private' and between the 'rational' and the 'emotional.' This chapter is developed through an analysis of interviews conducted with United Kingdom students aged 16-19, who completed a financial capability course as one of their options in postcompulsory schooling. From these interviews, in which students talked about what they learned from the course about finance, particular meanings of finance were implied. A Discourse analysis of how students talked about personal finance identifies consumer-oriented cultural models or storylines (Gee, 1999) about financial capability that are consequently framed in terms of private and rational decisions/choices with regards to one's finances. Particularly notable are instances in which the public and the emotional storylines were marginalized or discounted as not indicative of financial capability. The analysis highlights implied dichotomies between public and private and between rational and emotional in order to then critically examine the social and ideological functions that these dichotomies play. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-1-61735-719-0},
  keywords = {*Decision Making,*Finance,*Ideology,*Individual Differences,*Self-Concept,Emotion Recognition,nosource,Rationality}
}

@report{fastValuePersonalData2020,
  type = {SSRN Scholarly Paper},
  title = {The {{Value}} of {{Personal Data}}: {{An Experimental Analysis}} of {{Data Types}} and {{Personal Antecedents}}},
  shorttitle = {The {{Value}} of {{Personal Data}}},
  author = {Fast, Victoria and Schnurr, Daniel},
  date = {2020-09-01},
  institution = {Social Science Research Network},
  location = {Rochester, NY},
  doi = {10.2139/ssrn.3611232},
  url = {https://papers.ssrn.com/abstract=3611232},
  urldate = {2021-11-26},
  abstract = {Experimental investigations of privacy decision-making can provide complementary insights to surveys but they raise the methodological challenge of which data type(s) to use in controlled laboratory environments. To this end, we conduct a laboratory experiment with 317 participants and elicit subjects’ data valuation (i.e., willingness-to-accept, WTA) of three different synthetic data types, which we create and collect in the laboratory. We find that subjects place positive, although different, monetary valuations on these data sets and show that these valuations are similar to subjects’ valuations of field data created at an online retailer. Moreover, we find that subjects’ WTA is significantly influenced by their gender, age, general risk attitude as well as stated privacy concerns. Finally, we find that information sensitivity mediates the relationship between data type and subjects’ WTA. Altogether, our findings provide guidance for future experimental designs on revealed privacy decision-making and the pricing of personal data brokers.},
  eid = {ID 3611232},
  langid = {english},
  keywords = {data disclosure,data valuation,laboratory experiments,paying for privacy,personal data,privacy,willingness-to-accept},
  file = {/home/chris/Zotero/storage/B7QXKA6V/Fast and Schnurr - 2020 - The Value of Personal Data An Experimental Analys.pdf}
}

