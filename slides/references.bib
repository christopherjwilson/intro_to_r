@article{fjorbackMindfulnessBasedStressReduction2011,
  title = {Mindfulness-{{Based Stress Reduction}} and {{Mindfulness-Based Cognitive Therapy}} - a Systematic Review of Randomized Controlled Trials: {{Systematic}} Review of Mindfulness {{RCTs}}},
