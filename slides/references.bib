@article{lermerEffectConstrualLevel2015,
  title = {The Effect of Construal Level on Risk-Taking},
  author = {Lermer, Eva and Streicher, Bernhard and Sachs, Rainer and Raue, Martina and Frey, Dieter},
  date = {2015},
  journaltitle = {European Journal of Social Psychology},
  volume = {45},
