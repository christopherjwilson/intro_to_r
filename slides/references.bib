  keywords = {athlete satisfaction,COMPETITION,EXPLORATION,gambling-legal business,JOB-SATISFACTION,LEADERSHIP,MANAGEMENT,mental skills,MODELS,ORGANIZATIONAL COMMITMENT,PERCEPTIONS,PERFORMANCE,QUALITY,racing cyclist,trust},
