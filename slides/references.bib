@article{brigoCocoBondsPricing2015,
  title = {Coco {{Bonds Pricing With Credit}} and {{Equity Calibrated First-Passage Firm Value Models}}},
  author = {family=BRIGO, given=DAMIANO, given-i=DAMIANO and family=GARCIA, given=JOÃO, given-i=JOÃO and family=PEDE, given=NICOLA, given-i=NICOLA},
  date = {2015-05},
  journaltitle = {International Journal of Theoretical and Applied Finance},
  volume = {18},
  number = {03},
  pages = {1550015},
  issn = {0219-0249},
  doi = {10.1142/s0219024915500156},
  url = {http://10.0.4.118/S0219024915500156 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=102714379{&}site=ehost-live},
  abstract = {Since the beginning of the credit and liquidity crisis, financial institutions have been con-sidering creating a convertible-bond type contract focusing on capital. Under the terms of this contract, a bond is converted into equity if the authorities deem the institution to be under-capitalized. This paper discusses this contingent capital (CoCo) bond instrument and presents a pricing methodology based on firm value models that calibrate exactly the credit term structure of the issuer either through credit default swaps or corporate bonds data. Decorrelation between the capital conversion trigger and credit quality is introduced. The equity value for the issuer is derived in closed form with a barrier option type formula. A stress test of model parameters is illustrated to account for potential model risk and the obtained prices are compared to the price obtained from a market source. Finally, a brief overview of how the instrument valuation performs compared to pure corporate bonds and a discussion involving the CDS bond basis are presented.},
  keywords = {AT1P model,Basel III,Bonds (Finance),CoCo bonds,Contingent capital,conversion time,Credit,credit default swap calibration,default time,Enterprise value,Equity,Financial crises,Financial institutions,firm value models,hybrid credit-equity products,Liquidity (Economics),nosource,Pricing,systemic risk}
}

@article{brimbleTailoredFinancialLiteracy2013,
