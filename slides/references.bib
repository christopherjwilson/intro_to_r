@incollection{loewMoralResponsibilityLeadership2012,
  title = {Moral Responsibility and Leadership: {{How}} Managers Deal with Practical Moral Conflicts},
  booktitle = {Reframing Financial Literacy: {{Exploring}} the Value of Social Currency.},
  author = {Loew, Jennifer},
  editor = {Lucey, Thomas A and Laney, James D},
  date = {2012},
  pages = {125--147},
  publisher = {IAP Information Age Publishing},
  location = {Charlotte, NC},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2012-18170-007{&}site=ehost-live},
  abstract = {This chapter addresses a central element of a German dissertation project, currently being conducted by this chapter's author. The endeavor generally aims at gaining insights into how corporate managers do justice to that normative claim (to be more responsible) and assume moral responsibility, especially when dealing with practical moral conflicts. Although research in the moral psychological domain has revealed many insights into how people deal with morally relevant situations, there are still too many ambiguities and inconsistencies. Hence, there is a need for a better understanding, especially of the cognitive processing of moral conflicts in order to develop precise practical recommendations for moral education in economic contexts. The central intent of this chapter is to outline the theoretical framework of the mentioned research project, which, in turn, is based on an integration of existing theories and empirical findings in order to overcome a single-sided perspective and to generate a well-grounded foundation for the empirical study. For this purpose, the next section of this chapter draws upon existing empirical findings that concern managers' moral decision-making and consequential implications for the adopted research approach of the project; it then presents some deliberations that regard the central relevance of the responsibility concept. Kohlberg and Candee's (1984) model of the relationship of moral judgment to moral action is then introduced, followed by theoretical and practical suggestions with regard to business education. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-1-61735-719-0},
  keywords = {Conflict,corporate managers,Decision Making,Leadership,Management Personnel,moral conflicts,moral decision-making,moral leadership,moral responsibility,Morality,nosource,Responsibility}
}

