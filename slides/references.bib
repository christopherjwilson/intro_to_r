@article{slovicAffectHeuristic2007,
  title = {The Affect Heuristic},
  author = {Slovic, Paul and Finucane, Melissa L. and Peters, Ellen and MacGregor, Donald G.},
  date = {2007-03},
  journaltitle = {European Journal of Operational Research},
  shortjournal = {European Journal of Operational Research},
  volume = {177},
