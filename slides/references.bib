@article{ablerAbnormalRewardSystem2008,
  title = {Abnormal {{Reward System Activation}} in {{Mania}}},
  author = {Abler, Birgit and Greenhouse, Ian and Ongur, Dost and Walter, Henrik and Heckers, Stephan},
  date = {2008-08},
  journaltitle = {Neuropsychopharmacology},
  shortjournal = {Neuropsychopharmacol},
  volume = {33},
  number = {9},
  pages = {2217--2227},
  publisher = {Nature Publishing Group},
