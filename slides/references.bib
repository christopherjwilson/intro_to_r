  author = {Peckham, Andrew D. and Johnson, Sheri L. and Tharp, Jordan A.},
  date = {2016-12},
  journaltitle = {International Journal of Cognitive Therapy},
  volume = {9},
  number = {4},
  pages = {295--312},
  publisher = {Guilford Publications Inc.},
  issn = {1937-1209},
  doi = {10.1521/ijct_2016_09_12},
  url = {https://guilfordjournals.com/doi/abs/10.1521/ijct_2016_09_12},
  urldate = {2023-10-02},
  abstract = {Research has yielded mixed findings regarding whether bipolar disorder is related to attentional bias for emotionally relevant stimuli, yet little research has utilized advances in eye-tracking technology to study attention in this population. The current study used a free-viewing eye-tracking paradigm to test whether people with remitted bipolar disorder show preferential attention to positive faces, and to test if comorbid anxiety or emotion regulation strategies are related to attention bias. Twenty-nine adults with bipolar I disorder and 28 control participants viewed images of emotionally valenced faces while their gaze was tracked, and participants completed self-report measures of emotion regulation. Contrary to hypotheses, people with bipolar disorder did not differ from control participants in attention to positive stimuli, and both anxiety comorbidity and emotion regulation were unrelated to attentional indices. Unlike some findings in unipolar depression, these results suggest that attention to valenced faces may not be characteristic of remitted bipolar disorder.},
  keywords = {attention bias,bipolar disorder,emotion regulation,eye tracking},
  file = {/home/chris/Zotero/storage/43IFS3PS/Peckham et al_2016_Eye Tracking of Attention to Emotion in Bipolar I Disorder.pdf;/home/chris/Zotero/storage/AE9ZW2IA/Peckham et al_2016_Eye Tracking of Attention to Emotion in Bipolar I Disorder.pdf}
}

@article{peetzPredictionsGoPrevalence2016,
  title = {Predictions on the Go: {{Prevalence}} of Spontaneous Spending Predictions},
  shorttitle = {Predictions on the Go},
  author = {Peetz, Johanna and Simmons, Melanie and {Jingwen Chen} and Buehler, Roger},
  date = {2016-01-01},
  journaltitle = {Judgment and Decision Making},
  shortjournal = {Judgment and Decision Making},
  volume = {11},
  pages = {48--61},
  abstract = {The present research examines the prevalence of predictions in daily life. Specifically we examine whether spending predictions for specific purchases occur spontaneously in life outside of a laboratory setting. Across community samples and student samples, overall self-report and diary reports, three studies suggest that people make spending predictions for about two-thirds of purchases in everyday life. In addition, we examine factors that increase the likelihood of spending predictions: the size of purchase, payment form, time pressure, personality variables, and purchase decisions. Spending predictions were more likely for larger, more exceptional purchases and for item and project predictions rather than time periods.}
}

@article{peetzWhenDistancePays2012,
  title = {When Distance Pays off: {{The}} Role of Construal Level in Spending Predictions},
  shorttitle = {When Distance Pays Off},
  author = {Peetz, Johanna and Buehler, Roger},
  date = {2012-01-01},
  journaltitle = {Journal of Experimental Social Psychology},
  shortjournal = {Journal of Experimental Social Psychology},
  volume = {48},
  number = {1},
  pages = {395--398},
  issn = {0022-1031},
  doi = {10.1016/j.jesp.2011.07.016},
  url = {https://www.sciencedirect.com/science/article/pii/S0022103111001995},
  urldate = {2021-03-08},
  abstract = {Self predictions are often optimistically biased, even for recurrent events. People could generate more realistic predictions by using information about past experiences, however they tend to disregard this cognitive approach. Drawing on Construal Level Theory, we propose that increases in construal level facilitate the use of information from past experience, and thereby increase prediction accuracy. This proposal was tested in two studies examining predictions of personal spending. Consistent with the hypotheses, individuals induced to construe the prediction target at a higher level of abstraction generated more accurate predictions (Study 1) and the effect of increased construal level on prediction was attributable to a greater reliance on past experience (Studies 1 and 2). The findings indicate that high-level construal can sometimes benefit prediction accuracy.},
  langid = {english},
  keywords = {Construal level,Optimistic bias,Prediction,Spending behavior},
  file = {/home/chris/Zotero/storage/H5HQAVK5/Peetz and Buehler - 2012 - When distance pays off The role of construal leve.pdf;/home/chris/Zotero/storage/HQQJI3ZJ/Peetz_Buehler_2012_When distance pays off.pdf;/home/chris/Zotero/storage/JIIF6LNY/Peetz_Buehler_2012_When distance pays off.pdf;/home/chris/Zotero/storage/JSXVPZSN/S0022103111001995.html}
}

