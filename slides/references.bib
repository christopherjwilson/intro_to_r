@article{mittonKnowledgeTransferExchange,
  title = {Knowledge {{Transfer}} and {{Exchange}}: {{Review}} and {{Synthesis}} of the {{Literature}}},
  author = {Mitton, Craig and Adair, Carol E and Mckenzie, Emily and Patten, Scott B and Perry, Brenda Waye},
  pages = {40},
  abstract = {Knowledge transfer and exchange (KTE) is as an interactive process involving the interchange of knowledge between research users and researcher producers. Despite many strategies for KTE, it is not clear which ones should be used in which contexts. This article is a review and synthesis of the KTE literature on health care policy. The review examined and summarized KTE's current evidence base for KTE. It found that about 20 percent of the studies reported on a realworld application of a KTE strategy, and fewer had been formally evaluated. At this time there is an inadequate evidence base for doing “evidence-based” KTE for health policy decision making. Either KTE must be reconceptualized, or strategies must be evaluated more rigorously to produce a richer evidence base for future activity.},
  langid = {english},
  keywords = {nosource},
  file = {/home/chris/Zotero/storage/VUWA6VU2/Mitton et al. - Knowledge Transfer and Exchange Review and Synthe.pdf}
}

