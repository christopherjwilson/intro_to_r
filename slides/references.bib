@article{lopez-fernandezPreventingHarmfulInternet2020,
  title = {Preventing {{Harmful Internet Use-Related Addiction Problems}} in {{Europe}}: {{A Literature Review}} and {{Policy Options}}},
  author = {Lopez-Fernandez, O and family=Kuss, given=DJ, given-i=DJ},
  date = {2020-06},
  journaltitle = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
  volume = {17},
  number = {11},
  issn = {1660-4601},
  doi = {10.3390/ijerph17113797},
  abstract = {Internet use-related addiction problems are increasingly being recognized on a European scale due to international health organizations considering gaming addiction. In April 2013, the American Psychiatric Association recognized Internet Gaming Disorder in the fifth Diagnostic and Statistical Manual of Mental Disorders, and in April 2018, the World Health Organization included Gaming Disorder in the eleventh International Classification of Diseases. However, findings on these problems within this period are lacking in Europe, and a preventive approach is missing globally. A detailed critical literature review was conducted using PsycINFO and Web of Science in this five-year period. A total of 19 studies were reviewed and problems identified were: generalized Internet addiction and online gaming and gambling addictions across seven European countries (i.e., Spain, Germany, France, Italy, Greece, The Netherlands, and Denmark). The individuals with problematic use were found to be educated adolescents, usually young males with comorbid disorders, and gaming and gambling disorders were implicated in the most severe cases. Cognitive behavioral therapy was the main treatment, sometimes combined with a systemic approach for adolescents. Prevalence, high-risk populations, and factors contributing to these addiction problems are discussed, and a set of policy options are developed for this region. The implications for early detection, diagnosis, treatment, and prevention in Europe are considered.},
  langid = {english},
  keywords = {ADOLESCENTS,CRITERIA,Europe,GAMING DISORDER,generalized Internet addiction,Internet addiction,METAANALYSIS,online gambling addiction,online gaming addiction,PERSONALITY,policy option,PREVALENCE,prevention,problematic Internet use,public health,SAMPLE,SEVERITY,VALIDATION,VALIDITY},
  file = {/home/chris/Zotero/storage/YMCD7BXM/Lopez-Fernandez and Kuss - 2020 - Preventing Harmful Internet Use-Related Addiction Problems in Europe A Literature Review and Policy.pdf}
}

@article{lopez-gonzalezGamblinglikeFeaturesFan2023,
