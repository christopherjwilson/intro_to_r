  url = {https://www.degruyter.com/document/doi/10.2202/1935-1704.1440/html},
  urldate = {2022-10-07},
  abstract = {In repeated games, equilibrium often requires that any deviation be punished in the continuation, regardless of whether it is beneficial to the other players. It seems against the nature of non-cooperative game theory for the other players to decide what to do based on what one player did, rather than on the well-being of themselves. We introduce a new solution concept called a forgiving-proof equilibrium that recommends continuing as if nothing had happened after a player deviates without harming the others. A folk theorem is established to characterize the set of forgiving-proof equilibrium payoffs when players are sufficiently patient. The concept of forgiving-proof equilibrium significantly reduces the set of equilibrium outcomes in many repeated games.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Aramendia et al_2008_Forgiving-Proof Equilibrium in Infinitely Repeated Games.pdf}
}

