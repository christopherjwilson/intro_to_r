@article{PasmantierDiLiberto2012,
  title = {Financial {{Illiteracy}}: {{The Need}} to {{Educate Students}} on the {{Financial Implications}} of {{Withdrawing}} or {{Dropping}} a {{College Course}}.},
  author = {Pasmantier, Anita B and Di Liberto, Maryann J Fogarty},
  date = {2012-01},
  journaltitle = {Proceedings of the Northeast Business \& Economics Association},
  pages = {257--260},
  publisher = {{Northeast Business \& Economics Association}},
  issn = {1936203X},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=121051540{&}site=bsi-live},
  abstract = {Since the financial crisis of 2007-2009, there has been an increased awareness of the need for financial literacy among the young adult population. Recent efforts to address this problem have been made by many state education administrators, who are establishing guidelines and programs designed for K-12 students. College educators have also begun to deal with this challenge in their student population by creating financial literacy programs. The financial literacy curriculum at the college level typically focuses on personal finance topics, such as banking, budgeting, and credit management. A topic often ignored by these personal finance programs, however, is paying for college. For many students, the responsibility of financing college is handled by their parents/guardians. Increasing college costs are outpacing a family's ability to pay expenses out of current income or savings, thereby increasing student loan debt and extending the burden of payment for college into the future. While much of the cost of college is outside of students' control, they are accountable for additional costs due to withdrawing or dropping a course. This paper reviews the additional long-term costs as well as the many short-term consequences that can be immediate and severe for both the students and their parents. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Business education,College teachers,course withdrawal,Curricula (Courses of study),Finance education,Financial literacy,higher education,personal finance,Personal finance}
}

