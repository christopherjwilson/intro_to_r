@article{ChawlaEtAl2017,
  title = {Convexity and Correlation Effects in Expected Credit Loss Calculations for {{IFRS9}}/{{CECL}} and Stress Testing.},
  author = {Chawla, Gaurav and Forest Jr., Lawrence R and Aguais, Scott D},
  date = {2017},
  journaltitle = {Journal of Risk Management in Financial Institutions},
  volume = {10},
  number = {1},
  pages = {99--110},
  publisher = {{Henry Stewart Publications LLP}},
  issn = {17528887},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=121741127{&}site=ehost-live},
  abstract = {This paper demonstrates that the convexity of PD functions as well as the correlation among probability of default (PD), loss given default (LGD) and exposure at default (EAD) utcomes impart skewness to the credit-loss, probability-distribution function (PDF) and thereby increase the expected values of credit losses (ECLs) by as much as 20 per cent or more according to estimates presented later. With regard to convexity, the magnitude of the effect on ECLs depends on the amount of convexity in PD functions as well as the extent of the random dispersion in the credit-risk factors that affect PDs. With regard to correlation, the magnitude of the effect depends on the amount of correlated variation in PD, LGD and EAD outcomes. In accounting for these effects, one may apply credit-cycle indices in modifying the existing PD, LGD and EAD models so that they produce point-in-time (PIT) estimates that move together over time in the way implied by common, credit-cycle effects. Having done that, an institution can account for convexity and correlation effects in producing the unbiased estimates of ECLs needed in determining losses under stress scenarios or impairments under IFRS9/CECL. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Credit,Credit risk,Default (Finance),Financial institution management,International Financial Reporting Standards,Stress tests (Finance)}
}

