  doi = {10.3390/jcm10030549},
  url = {https://www.semanticscholar.org/paper/aca0c00cd8caf41962e60a93beda91e08ca8d3bc},
  abstract = {Assessing the harmful consequences of gambling is an area of active investigation. One measure intended to capture gambling-related harm is the 10-item short gambling harm screen (SGHS). Although good psychometric properties have been reported, it has been suggested that the screen\^a\texteuro\texttrademark s less severe probes may not represent genuinely harmful consequences, but rather may reflect rational opportunity costs. Consequently, it has been argued that the screen may lead to overestimation of the extent of gambling-related harm in the population. The current study sought to examine the psychometric performance of three less severe suspect items in the SGHS. Associations between each of these items and a specially constructed scale of relatively severe \^a\texteuro\oe unimpeachable\^a\texteuro  gambling harms were calculated from archival data from 5551 Australian and New Zealand gamblers. All three suspect items, both individually and upon aggregation, predicted greater endorsement of \^a\texteuro\oe unimpeachable\^a\texteuro  harms, and indicated the presence of gambling problems. Moreover, the SGHS as a whole is highly correlated with \^a\texteuro\oe unimpeachable\^a\texteuro  gambling harms. Including suspect items in the SGHS was found to improve predictions of low- and moderate-risk gambling status, but slightly decreased predictions of severe gambling problems. The results are inconsistent with the notion that SGHS harm probes capture either inconsequential consequences or opportunity costs. They confirm prior findings that harm symptomatology is unidimensional, and that the report of multiple more prevalent, but less severe, harms serves as an effective indicator of the spectrum of experienced harm.},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Boyle et al_2021_Opportunity costs or not.pdf}
}

@article{Achtziger2015,
  title = {Debt out of Control: {{The}} Links between Self-Control, Compulsive Buying, and Real Debts},
  author = {Achtziger, Anja},
  date = {2015},
  journaltitle = {Journal of Economic Psychology},
  pages = {9},
  abstract = {In a representative sample of the German population (n = 946), we explored the links between self-control, compulsive buying, and debts. Participants completed the self-control scale (Tangney, Boone, \& Baumeister, 2004) and the German Addictive Buying Scale (Raab, Neuner, Reisch, \& Scherhorn, 2005). Additionally, they gave information about their real debts. It was observed that self-control was negatively related to debts while compulsive buying was positively related to debts. Detailed analyses revealed that the link between self-control and debts was fully mediated by compulsive buying. Finally, there was a gender effect on compulsive buying: women were more prone to compulsive buying than men. Age also was significantly negatively related to compulsive buying and positively linked to self-control. Household income was not linked to self-control, compulsive buying, and debts. Implications for practice, policy, and research are discussed. \'O 2015 Elsevier B.V. All rights reserved.},
  langid = {english},
  keywords = {\#nosource,Compulsive buying,Consumer debts,Indebtedness factors,Self-control},
  file = {C\:\\Users\\Owner\\Dropbox\\Papers\\Achtziger et al_2015_Debt out of control.pdf;C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Achtziger et al_2015_Debt out of control.pdf;C\:\\Users\\wilso\\Zotero\\storage\\UTAYPRXP\\Achtziger - 2015 - Debt out of control The links between self-contro.pdf;C\:\\Users\\wilso\\Zotero\\storage\\QWARI57N\\S0167487015000471.html}
}

@article{AcquistiEtAl2013,
