@incollection{agnelloMappingFinancialFutures2012,
  title = {Mapping {{Financial Futures}} and {{Developing Social Capital}}},
  booktitle = {… {{Financial Literacy}}: {{Exploring}} the {{Value}} …},
  author = {family=Agnello, given=MF, given-i=MF and family=Knapp, given=AL, given-i=AL},
  editor = {Lucey, Thomas A and Laney, James D},
  date = {2012},
  pages = {235--252},
  publisher = {IAP Information Age Publishing},
  location = {Charlotte, NC},
  url = {http://books.google.com/books?hl=en{&}lr={&}id=LAMwl06UaXQC{&}oi=fnd{&}pg=PA235{&}dq=otter+teachers'+background+and+capacity+to+teach+personal+finance+results+of+a+national+study{%}22{&}ots=HyafZzWfYH{&}sig=q-zwSh4S5uoxbcHWpXiIShKgLWQ},
  abstract = {Economic literacy is an important aspect of education for the American populace. Unfortunately, K-12 schools fare poorly in their efforts to teach children and youth about related tenets (Bernanke, 2006). Even though policymakers argue that financial literacy is important, national economic policies and practices represent determinants of the general public's financial possibilities. Pursuing financial literacy, in and of itself, represents an insufficient strategy for improving society because the economic decisions made by key policymakers affect the financial decision-making contexts for all. Professionals in the discipline of economics see a need for economic literacy, in essence, a strong grasp within the field and in the public of domestic and international economic systems and their interrelationships (The Federal Research Bank of Minneapolis, 2011). The Jump\$tart Coalition for Personal Financial Literacy (2007b) defines financial literacy as 'the ability to use knowledge and skills to manage one's financial resources effectively for lifetime financial security' (p. 1). However, while the term itself is easily defined, implementation of the underlying concepts is not. This chapter focuses on the evolution of financial literacy teacher education, particularly informed by four standards from the Council for Economic Education and Jump\$tart that align well with a discussion of social capital, a concept developed by Pierre Bourdieu (1986). It is posited that youth can be coached and prepared to develop their social currency that leads to sounder financial decision making. It is believed that K-12 students with financial literacy knowledge, skills, and dispositions are more prepared to be self-sustaining and productive citizen workers. The chapter concludes by relating the standards described herein to the need for social networking as a critical component of social capital development. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-1-61735-719-0},
  keywords = {Decision Making,Economics,Elementary School Students,Finance,financial decision making,financial literacy,Financial Literacy,Jump\\$tart,Jump\$tart,K-12 students,nosource,Secondary Education,social capital,Social Capital,social networking,Social Networks,teacher education,Teacher Education}
}

@article{agnewAssetAllocationInformation2008,
  title = {Asset {{Allocation}} and {{Information Overload}}: {{The Influence}} of {{Information Display}}, {{Asset Choice}} and {{Investor Experience}}},
  author = {Agnew, Julie R. and Szykman, Lisa},
  date = {2008},
  journaltitle = {Ssrn},
  volume = {6},
  number = {2},
  pages = {57--70},
  publisher = {Lawrence Erlbaum},
  location = {{Agnew, Julie R., College of William and Mary, School of Business Administration, P.O. Box 8795, Williamsburg, VA, US, 23187}},
  issn = {1542-7560},
  doi = {10.2139/ssrn.1142932},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2005-05963-002{&}site=ehost-live http://julie.agnew@business.wm.edu},
  abstract = {This paper investigates three common differences among DC plans that may lead to varying degrees of information overload. We hypothesize that information overload is one reason DC participants often choose the default options. In two experiments, we manipulate the display of the investment information, the number of choices offered, and the similarity of these choices. In addition, we measure the financial knowledge of the participants. We test how these factors influence the participant's feelings of information overload, decision satisfaction and choice of the default. The main contribution of this analysis is that it explores the interaction between the individual's tested financial knowledge and the manipulated plan features. In our study, women with relatively lower salaries and less education tend to fall into our low knowledge category. Our findings do show that changes to plan design can help some individuals. We find individuals with above average financial knowledge do report significantly less overload when given fewer investment choices. This confirms previous research that plan design is important. Our results also show that financial knowledge plays a large role in who opts for the default. We find that low knowledge individuals opt for the default allocation more often than high knowledge individuals (experiment one: 20\% vs. 2\%). Our findings suggest individuals with below average knowledge are simply overwhelmed by the investment decision in general. Altering the plan by offering investment information in a more easily comparable format or by reducing the choices offered does not attenuate the low knowledge individuals' feelings of overload. The findings suggest that the success of certain plan features depends strongly on the financial background of the participant. The results emphasize the importance of plan design, especially the careful selection of plan default options, and the need to improve the financial literacy of participants.},
  keywords = {401(k),financial knowledge,information overload,investments,nosource},
  file = {/home/chris/Zotero/storage/T26498IF/Agnew and Szykman - 2008 - Asset Allocation and Information Overload The Influence of Information Display, Asset Choice and In.pdf}
}

