@online{fifeEightStepsData2019,
  title = {The {{Eight Steps}} of {{Data Analysis}}: {{A Graphical Framework}} to {{Promote Sound Statistical Analysis}}},
  shorttitle = {The {{Eight Steps}} of {{Data Analysis}}},
  author = {Fife, Dustin},
  date = {2019-09-19},
  eprinttype = {OSF},
  doi = {10.31234/osf.io/r8g7c},
  url = {https://osf.io/r8g7c},
  urldate = {2024-10-28},
  abstract = {Data analysis is a risky endeavor, particularly among those unaware of its dangers. In the words of Cook and Campbell (1976; see also Cook, Campbell, and Shadish 2002), “Statistical Conclusions Validity” threatens all experiments that subject themselves to the dark arts of statistical magic. Although traditional statistics classes may advise against certain practices (e.g., multiple comparisons, small sample sizes, violating normality), they may fail to cover others (e.g., outlier detection and violating linearity). More common, perhaps, is that researchers may fail to remember them. In this paper, rather than rehashing old warnings and diatribes against this practice or that, I instead advocate a general statistical analysis strategy. This graphically-based eight step strategy promises to resolve the majority of statistical traps researchers may fall in without having to remember large lists of problematic statistical practices. These steps will assist in preventing both Type I and Type II errors and yield critical insights about the data that would have otherwise been missed. I conclude with an applied example that shows how the eight steps highlight data problems that would not be detected with standard statistical practices.},
  langid = {american},
  pubstate = {prepublished},
  keywords = {confirmatory data analysis,exploratory data analysis,fishing,flexplot,graphical data analysis,NHST,p-hacking,rough CDA,significance testing,statistical assumptions},
  file = {/home/chris/Zotero/storage/I439SKXH/Fife_2019_The Eight.pdf}
}

