  title = {\textbf{Tclust} : {{An}} {{\emph{R}}} {{Package}} for a {{Trimming Approach}} to {{Cluster Analysis}}},
  shorttitle = {\textbf{Tclust}},
  author = {Fritz, Heinrich and Garc\'ia-Escudero, Luis A. and Mayo-Iscar, Agust\'in},
  date = {2012},
  journaltitle = {Journal of Statistical Software},
  shortjournal = {J. Stat. Soft.},
  volume = {47},
  number = {12},
  issn = {1548-7660},
  doi = {10.18637/jss.v047.i12},
  url = {http://www.jstatsoft.org/v47/i12/},
  urldate = {2022-10-07},
  abstract = {This introduction to the R package tclust is a (slightly) modified version of Fritz et al. (2012), published in the Journal of Statistical Software. Outlying data can heavily influence standard clustering methods. At the same time, clustering principles can be useful when robustifying statistical procedures. These two reasons motivate the development of feasible robust model-based clustering approaches. With this in mind, an R package for performing non-hierarchical robust clustering, called tclust, is presented here. Instead of trying to ``fit'' noisy data, a proportion {$\alpha$} of the most outlying observations is trimmed. The tclust package efficiently handles different cluster scatter constraints. Graphical exploratory tools are also provided to help the user make sensible choices for the trimming proportion as well as the number of clusters to search for.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Fritz et al_2012_btclust-b.pdf}
}

@article{FrostEtAl2016,
  title = {Social Support Networks among Diverse Sexual Minority Populations},
  author = {Frost, David M. and Meyer, Ilan H. and Schwartz, Sharon},
  date = {2016},
  journaltitle = {American Journal of Orthopsychiatry},
  volume = {86},
  number = {1},
  pages = {91--102},
  publisher = {{Educational Publishing Foundation}},
  location = {{Frost, David M., School of Psychology, University of Surrey, Guildford, United Kingdom, GU2 7XH}},
  issn = {19390025},
  doi = {10.1037/ort0000117},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=pdh{&}AN=2016-00321-005{&}site=ehost-live http://d.frost@surrey.ac.uk},
  abstract = {This article reports a study of the function and composition of social support networks among diverse lesbian, gay, and bisexual (LGB) men and women (n = 396) in comparison to their heterosexual peers (n = 128). Data were collected using a structured social support network matrix in a community sample recruited in New York City. Our findings show that gay and bisexual men may rely on "chosen families" more than lesbian and bisexual women. Both heterosexuals and LGBs relied less on family and more on other people (e.g., friends, coworkers) for everyday social support (e.g., recreational and social activities, talking about problems). Providers of everyday social support were most often of the same sexual orientation and race/ethnicity as participants. In seeking major support (e.g., borrowing large sums of money), heterosexual men and women along with lesbian and bisexual women relied primarily on their families, but gay and bisexual men relied primarily on other LGB individuals. Racial/ethnic minority LGBs relied on LGB similar others at the same rate as did White LGBs but, notably, racial/ethnic minority LGBs reported receiving fewer dimensions of support. (PsycINFO Database Record},
  keywords = {\#nosource,Families of choice,LGB,Minority stress,Social support networks}
}

@article{FrydmanCamerer2016,
  title = {The {{Psychology}} and {{Neuroscience}} of {{Financial Decision Making}}},
  author = {Frydman, Cary and Camerer, Colin F.},
  date = {2016-09},
  journaltitle = {Trends in Cognitive Sciences},
  volume = {20},
  number = {9},
  eprint = {15334406},
  eprinttype = {arxiv},
  pages = {661--675},
  publisher = {{Elsevier Current Trends}},
  location = {{Frydman, Cary}},
  issn = {1879307X},
  doi = {10.1016/j.tics.2016.07.003},
  url = {https://www.sciencedirect.com/science/article/pii/S1364661316300997{#}fig0005 http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-40254-008{&}site=ehost-live http://camerer@caltech.edu http://cfrydman@marshall.usc.edu},
  abstract = {Financial decisions are among the most important life-shaping decisions that people make. We review facts about financial decisions and what cognitive and neural processes influence them. Because of cognitive constraints and a low average level of financial literacy, many household decisions violate sound financial principles. Households typically have underdiversified stock holdings and low retirement savings rates. Investors overextrapolate from past returns and trade too often. Even top corporate managers, who are typically highly educated, make decisions that are affected by overconfidence and personal history. Many of these behaviors can be explained by well-known principles from cognitive science. A boom in high-quality accumulated evidence\textendash especially how practical, low-cost `nudges' can improve financial decisions\textendash is already giving clear guidance for balanced government regulation.},
  arxivid = {15334406},
  isbn = {1879-307X (Electronic)\textbackslash r1364-6613 (Linking)},
  mendeley-tags = {financial decisions RELEVANT,financial decisions cognitive processes},
  keywords = {\#nosource,bubbles,decision making,finance,financial decisions cognitive processes,financial decisions RELEVANT,neuroeconomics,stock market,trading biases}
}

