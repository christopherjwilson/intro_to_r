  abstract = {Cross-sectional data reveal alarming financial situations among 2009 MSW graduates from 25 states and their loan decisions (N=260). More than a quarter of the participants owe at least \$40,000 in educational loans from their MSW degree, and 30\% borrowed at least \$30,000 of their total college education debt. Expensive credit cards are used more commonly than any private educational loan to finance their professional education, and a quarter of all participants have at least a \$500 monthly payment obligation to the plastic money. Thus, 31\% of the participants are either very or extremely burdened by noneducational loans even before they have educational loan repayment obligations. This study suggests individual, discipline- specific, and public interventions to promote their financial well-being. [PUBLICATION ABSTRACT]; Cross-sectional data reveal alarming financial situations among 2009 MSW graduates from 25 states and their loan decisions (N=260). More than a quarter of the participants owe at least \$40,000 in educational loans from their MSW degree, and 30\% borrowed at least \$30,000 of their total college education debt. Expensive credit cards are used more commonly than any private educational loan to finance their professional education, and a quarter of all participants have at least a \$500 monthly payment obligation to the plastic money. Thus, 31\% of the participants are either very or extremely burdened by noneducational loans even before they have educational loan repayment obligations. This study suggests individual, discipline-specific, and public interventions to promote their financial well-being. Adapted from the source document.},
  keywords = {\#nosource,ACADEMIC achievement,ANALYSIS of variance,CHI-squared test,CREDIT,CROSS-sectional method,DEBT,DESCRIPTIVE statistics,ENDOWMENTS,GRADUATE students,INTERNET,QUESTIONNAIRES,RESEARCH,SOCIAL workers -- United States,STRESS (Psychology),STUDENTS -- United States,UNITED States,WAGES}
