  author = {Chan, Chi C. and Alter, Sharon and Hazlett, Erin A. and Shafritz, Keith M. and Yehuda, Rachel and Goodman, Marianne and Haznedar, M. Mehmet and Szeszko, Philip R.},
  date = {2023-04},
  journaltitle = {Neuroscience and Biobehavioral Reviews},
