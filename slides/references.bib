@article{ZuckermanEtAl1983,
  title = {The Egocentric Bias: {{Seeing}} Oneself as Cause and Target of Others' Behavior},
  author = {Zuckerman, Miron and Kernis, Michael H and Guarnera, Salvatore M and Murphy, John F and Rappoport, Lauren},
  date = {1983},
  journaltitle = {Journal of Personality},
  volume = {51},
  number = {4},
  pages = {621},
  url = {http://search.epnet.com/login.aspx?direct=true{&}db=aph{&}an=7380772{&}loginpage=login.asp{&}site=ehost},
  abstract = {Discusses the egocentric bias or the tendency to see oneself as both cause and target of another person's behavior, in the context of a small group interaction. Correlation between overall egocentric bias scores and the subject's level of self-esteem; Cognitive and motivational processes that may account for the bias.ABSTRACT FROM AUTHOR The egocentric bias-the tendency to see oneself as both cause and target of another person's behavior-was examined in the context of a small group interaction. Pairs of subjects plus a confederate conducted a short discussion, their goal being to achieve consensus on a specific topic. The discussion was interrupted by the experimenter when the confederate summarized his/her opinion. It was found that subjects were more likely to see themselves as a cause as well as a target of the confederate's last statement compared to the way they were seen by other group members. Subjects were also more likely to exaggerate the amount of attention they received from the confederate. The overall egocentric bias scores were correlated with subjects' level of self-esteem. Cognitive and motivational processes that may account for this bias were discussed.ABSTRACT FROM AUTHOR},
  keywords = {\#nosource,ATTENTION,COGNITION,EGOISM,HUMAN behavior,MOTIVATION (Psychology),PREJUDICES,PSYCHOLOGY,SELF-esteem}
}

