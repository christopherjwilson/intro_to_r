@article{renaudUsingImmersiveVirtual2013,
  title = {Using Immersive Virtual Reality and Ecological Psychology to Probe into Child Molesters' Phenomenology},
  author = {Renaud, Patrice and Chartier, Sylvain and Rouleau, Joanne-Lucine and Proulx, Jean and Goyette, Mathieu and Trottier, Dominique and Fedoroff, Paul and Bradford, John-P. and Dassylva, Benoît and Bouchard, Stéphane},
