  shorttitle = {Is Default Risk Acceptable When Purchasing Insurance?},
  author = {Zimmer, Anja and Schade, Christian and Gründl, Helmut},
  date = {2009-02},
  journaltitle = {Journal of Economic Psychology},
  shortjournal = {Journal of Economic Psychology},
  volume = {30},
