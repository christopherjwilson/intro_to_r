@article{Soderberg2013,
  title = {Relationships between Advisor Characteristics and Consumer Perceptions.},
  author = {S\"oderberg, Inga-Lill},
  date = {2013-05},
  journaltitle = {International Journal of Bank Marketing},
  volume = {31},
  number = {3},
  pages = {147--166},
  issn = {02652323},
  url = {http://10.0.4.84/02652321311315276 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=87116142{&}site=bsi-live},
  abstract = {Purpose \textendash{} This paper aims to investigate the relationships between advisor characteristics and consumer risk perception, willingness to follow advice and perception of advisor credibility in a financial services context. It answers calls for more knowledge about financial advisors' influence on financial decision-making among consumers. Design/methodology/approach \textendash{} An experimental study, displaying financial advice together with photographs of advisors, was completed by convenience sampling of 200 Swedish consumers and analysis using statistical techniques to compare groups: two-way between-groups ANOVA. Findings \textendash{} This study shows that advisor gender affected consumer risk perceptions, willingness to follow advice and perception of advisor credibility in a financial services context, whereas advisor mood affected only consumer willingness to follow advice. No biases depending on buyer\textendash seller similarity were found. Research limitations/implications \textendash{} The study focuses on consumer perceptions \textendash{} not real-life investment choices. Conclusions are drawn from a relatively small sample. However, the policy implications are important, suggesting that characteristics other than those of consumers (e.g. gender, educational level, occupation, financial literacy) can be of relevance for policymakers in their attempts to improve consumer protection. Practical implications \textendash{} The findings provide useful insights for marketing practitioners that could help adjust information disseminated to consumer segments and that could have implications for marketing and hiring practices in the financial sector. Originality/value \textendash{} This paper illustrates the role of advisor characteristics in consumer financial decision-making and calls for more research on financial advisory services. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Buyer seller relations,Consumer behavior,Consumer behaviour,Convenience sampling (Statistics),Dealers (Retail trade),Decision making,Financial advice,Financial advisor,Financial planners,Financial services,Financial services industry,Lay consumer,Purchasing agents,Risk perception,Sweden}
}

