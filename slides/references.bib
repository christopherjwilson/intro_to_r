@incollection{SabriZakaria2015,
  title = {Financial {{Well-Being}} among {{Young Employees}} in {{Malaysia}}},
  booktitle = {Handbook of Research on Behavioral Finance and Investment Strategies: {{Decision}} Making in the Financial Industry.},
  author = {Sabri, Mohamad Fazli and Zakaria, Nurul Farhana},
  editor = {Copur, Zeynep},
  date = {2015},
  series = {Advances in Finance, Accounting, and Economics ({{AFAE}}) Book Series; {{ISSN}}: 2327-5677 ({{Print}}), 2327-5685 ({{Electronic}})},
  pages = {221--235},
  publisher = {{Business Science Reference/IGI Global}},
  location = {{Hershey, PA}},
  doi = {10.4018/978-1-4666-7484-4.ch013},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2015-24115-013{&}site=ehost-live},
  abstract = {The purpose of this study is to identify the levels of financial literacy, money attitude, self-esteem, financial capability and financial well-being of young employees, to explore the differences in financial well-being based on demographic characteristics of young employees and to identify the determinants of financial well-being among young employees. The sample consists of 508 of young employees aged 40 and under in central zone of Malaysia, which selected through multi stage sampling technique. Data were collected through self-administered questionnaires. Financial literacy, domains in money attitude and financial capability had significant influence toward financial well-being whereby financial capability become a major contributing factor to the financial well-being. By understanding more about the determinants of financial well-being, it is hoped to help young employees to become financial prudence and in the long-run could decrease the number of young employees declared bankruptcy. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {2327-5677},
  keywords = {\#nosource,Demographic Characteristics,Finance,financial literacy,financial well-being,Income (Economic),Money,money attitude,Self-Esteem,Socioeconomic Status,young employees}
}

