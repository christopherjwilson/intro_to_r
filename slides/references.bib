@article{shahScarcityFramesValue2015,
  title = {Scarcity {{Frames Value}}},
  author = {Shah, Anuj K. and Shafir, Eldar and Mullainathan, Sendhil},
  date = {2015-04-01},
  journaltitle = {Psychological Science},
  shortjournal = {Psychol Sci},
  volume = {26},
