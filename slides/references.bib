  title = {{{ADHD}} Symptomatology and Risky Health, Driving, and Financial Behaviors in College: {{The}} Mediating Role of Sensation Seeking and Effortful Control},
  shorttitle = {{{ADHD}} Symptomatology and Risky Health, Driving, and Financial Behaviors in College},
