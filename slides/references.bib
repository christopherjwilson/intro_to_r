  keywords = {benchmark evaluation,information retrieval (IR) systems,rapid automatic keyword extraction (RAKE),stoplist generation},
  file = {/home/chris/Zotero/storage/A8MTW42T/Rose et al. - 2010 - Automatic Keyword Extraction from Individual Documents.pdf;/home/chris/Zotero/storage/68ME7R6G/9780470689646.html}
