  urldate = {2022-10-07},
  abstract = {A mastery quiz is a miniquiz given at the start and end of a lecture period used to signal key lecture concepts. It also provides an incentive for focused attention and regular and punctual attendance. Students earn points toward their final grades for submitting correct responses at either or both testings. Introductory psychology students showed significant improvement in knowledge of mastery quiz content as assessed by pre–post lecture comparisons. Credits earned on mastery quizzes also predicted performance on course examination questions measuring signaled concepts and other concepts from lectures on days that mastery quizzes were administered.},
