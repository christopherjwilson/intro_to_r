@article{rayyan-471359767,
  title = {Gambling-like Digital Assets and Gambling Severity: {{A}} Correlational Study with {{U}}.{{S}}. Sports Bettors Consuming Cryptocurrencies, {{NFTs}}, and Fan Tokens.},
