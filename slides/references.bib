@article{Routledge2010,
  title = {Intangibles and Credit Decisions : Results from an Experiment {{Bino Catasu Jan-Erik Gro}}},
  author = {Routledge, Publisher},
  date = {2010-07},
  journaltitle = {European Accounting Review},
  volume = {12},
  number = {919027209},
  pages = {327--355},
  publisher = {{Routledge}},
  issn = {09638180},
  doi = {10.1080/0963818032000089418},
  url = {http://10.0.4.56/0963818032000089418 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=9757641{&}site=ehost-live},
  abstract = {The question in this paper is whether the inclusion of intangibles is meaningful in a credit decision context. To examine this issue we conducted an experiment with forty loan officers. The loan officers were presented with a situation of a company that required a credit of 5 million Swedish kronor. Half of the loan officers were given a traditional annual statement in which intangibles were treated as costs while the other half received a balance sheet in which brand, R\&D and education were capitalized. The loan officers were asked to give their opinion regarding the credit decision and the importance of extra information. They were also confronted with four short cases where extra information about the company appeared. Statistical analysis revealed that none of three hypotheses relating to the statement that 'accounting for intangibles does not matter' could be falsified. Still, the acquired qualitative data that emerged from the study makes it possible to suggest another finding. The study shows that accounting for intangibles is accepted if the accounts were seen as reliable. The conclusion is that if it is possible to create reliable data about intangibles, accounting for intangibles is meaningful for credit decisions. [ABSTRACT FROM AUTHOR]},
  isbn = {0963818032000},
  keywords = {\#nosource,Credit,Decision making,Intangible property,Loan officers,Loans}
}

