@article{PaulusYu2012,
  title = {Emotion and Decision-Making: Affect-Driven Belief Systems in Anxiety and Depression},
  shorttitle = {Emotion and Decision-Making},
  author = {Paulus, Martin P. and Yu, Angela J.},
  date = {2012-09-01},
  journaltitle = {Trends in Cognitive Sciences},
  shortjournal = {Trends in Cognitive Sciences},
  volume = {16},
  number = {9},
  pages = {476--483},
  issn = {1364-6613},
  doi = {10.1016/j.tics.2012.07.009},
  url = {https://www.sciencedirect.com/science/article/pii/S1364661312001751},
  urldate = {2022-10-03},
  abstract = {Emotion processing and decision-making are integral aspects of daily life. However, our understanding of the interaction between these constructs is limited. In this review, we summarize theoretical approaches that link emotion and decision-making, and focus on research with anxious or depressed individuals to show how emotions can interfere with decision-making. We integrate the emotional framework based on valence and arousal with a Bayesian approach to decision-making in terms of probability and value processing. We discuss how studies of individuals with emotional dysfunctions provide evidence that alterations of decision-making can be viewed in terms of altered probability and value computation. We argue that the probabilistic representation of belief states in the context of partially observable Markov decision processes provides a useful approach to examine alterations in probability and value representation in individuals with anxiety and depression, and outline the broader implications of this approach.},
  langid = {english},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Paulus_Yu_2012_Emotion and decision-making.pdf;C\:\\Users\\wilso\\Zotero\\storage\\NEHRR5H2\\S1364661312001751.html}
}

