@article{CorrMcNaughton2012,
  title = {Neuroscience and Approach/Avoidance Personality Traits: {{A}} Two Stage (Valuation\textendash Motivation) Approach},
  shorttitle = {Neuroscience and Approach/Avoidance Personality Traits},
  author = {Corr, Philip J. and McNaughton, Neil},
  date = {2012-11-01},
  journaltitle = {Neuroscience \& Biobehavioral Reviews},
  shortjournal = {Neuroscience \& Biobehavioral Reviews},
  volume = {36},
  number = {10},
  pages = {2339--2354},
  issn = {0149-7634},
  doi = {10.1016/j.neubiorev.2012.09.013},
  url = {https://www.sciencedirect.com/science/article/pii/S0149763412001662},
  urldate = {2022-04-13},
  abstract = {Many personality theories link specific traits to the sensitivities of the neural systems that control approach and avoidance. But there is no consensus on the nature of these systems. Here we combine recent advances in economics and neuroscience to provide a more solid foundation for a neuroscience of approach/avoidance personality. We propose a two-stage integration of valuation (loss/gain) sensitivities with motivational (approach/avoidance/conflict) sensitivities. Our key conclusions are: (1) that valuation of appetitive and aversive events (e.g. gain and loss as studied by behavioural economists) is an independent perceptual input stage \textendash{} with the economic phenomenon of loss aversion resulting from greater negative valuation sensitivity compared to positive valuation sensitivity; (2) that valuation of an appetitive stimulus then interacts with a contingency of presentation or omission to generate a motivational `attractor' or `repulsor', respectively (vice versa for an aversive stimulus); (3) the resultant behavioural tendencies to approach or avoid have distinct sensitivities to those of the valuation systems; (4) while attractors and repulsors can reinforce new responses they also, more usually, elicit innate or previously conditioned responses and so the perception/valuation\textendash motivation/action complex is best characterised as acting as a `reinforcer' not a `reinforcement'; and (5) approach\textendash avoidance conflict must be viewed as activating a third motivation system that is distinct from the basic approach and avoidance systems. We provide examples of methods of assessing each of the constructs within approach\textendash avoidance theories and of linking these constructs to personality measures. We sketch a preliminary five-element reinforcer sensitivity theory (RST-5) as a first step in the integration of existing specific approach\textendash avoidance theories into a coherent neuroscience of personality.},
  langid = {english},
  keywords = {Anxiety,Aversion,Behavioural approach system,Behavioural inhibition,Conflict,Economics,Fear,Fight\textendash flight\textendash freeze system,Loss,Personality,Reinforcement sensitivity theory,Risk},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Corr_McNaughton_2012_Neuroscience and approach-avoidance personality traits.pdf;C\:\\Users\\wilso\\Zotero\\storage\\D9QWBVCJ\\S0149763412001662.html}
}

