  title = {Dynamic Inter-Brain Synchrony in Real-Life Inter-Personal Cooperation: {{A}} Functional near-Infrared Spectroscopy Hyperscanning Study},
  shorttitle = {Dynamic Inter-Brain Synchrony in Real-Life Inter-Personal Cooperation},
  author = {Li, Rihui and Mayseless, Naama and Balters, Stephanie and Reiss, Allan L.},
