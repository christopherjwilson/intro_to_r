@article{priceLecturersVsStudents2007,
  title = {Lecturers’ vs. Students’ Perceptions of the Accessibility of Instructional Materials},
  author = {Price, Linda},
  date = {2007-07},
  journaltitle = {Instructional Science},
  shortjournal = {Instr Sci},
  volume = {35},
