@article{McLean-MeyinsseEtAl2018,
  title = {Exploring {{Links}} between {{Health Perceptions}} and {{Financial Knowledge}}.},
  author = {McLean-Meyinsse, Patricia E and Lazard, Patrice V and Taylor, Shervia S},
