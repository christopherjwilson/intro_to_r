@article{mhrgnEtAl1385,
  title = {No {{Titleبررسی}} رابطه علی بین نرخ بهره و نرخ تورم :با استفاده از داده های تابلویی},
  author = {مهرگان, نادر and عزتی, مرتضی and اصغر پور, حسین},
  date = {1385-05},
  journaltitle = {فصلنامه پژوهشهاي اقتصادي},
  volume = {3},
  number = {3},
  pages = {254--256},
  publisher = {{Oxford University Press / USA}},
  issn = {00378046},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=pbh{&}AN=5273456{&}site=ehost-live},
  abstract = {This article presents a study, which examined the effects of compulsive gambling on the family in the U.S. The consequences of compulsive gambling can have devastating effects on gamblers' families. Economically, there is the loss of money required to pay for essentials. Family members may be threatened by loan sharks, acquisitions may be repossessed, or evictions may occur. Socially, family members may see themselves as outcasts because of their shame; they expect criticism and thus withdraw from family contacts and friends. Medically, the constant stress may lead to health problems and, when lack of money prevents purchasing proper food or medical attention, additional physical troubles may ensue. Implications for practice in identifying compulsive gambling and helping the wife through social work contact have been described. Use of self-help groups, for all family members, is underscored. Social agencies will need to provide adequate staff training to deal with the rising incidence of gambling and its consequences for all concerned. The extent of compulsive gambling in the society is a reality that must be faced.},
  keywords = {\#nosource,COMPULSIVE behavior,COMPULSIVE gambling,FAMILIES,GAMBLING behavior,SOCIAL services,SOCIAL workers -- Training of,STRESS (Psychology)}
}

