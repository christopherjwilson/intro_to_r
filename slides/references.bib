@article{WestWorthington2018,
  title = {Synthesizing an {{Index}} of {{Financial Literacy Using Not-For-Purpose Survey Data}}.},
  author = {West, Tracey and Worthington, Andrew C},
  date = {2018-07},
  journaltitle = {Economic Notes},
  volume = {47},
  number = {2/3},
  pages = {331--352},
  issn = {03915026},
  abstract = {We use Australian household survey data to formulate a measure of financial literacy. First, we use household responses to questions regarding financial stress and savings habits to derive a factor variable that proxies as an index of financial literacy. Second, the sample is clustered into categories of financial literacy according to their financial literacy index and other household characteristics. Third, we test for the significance of household characteristics on the financial literacy index. We find the methodologies form similar groups and yield comparable estimates. Being young, female, a single parent, in poor health, unemployed and with low income and wealth increases the likelihood of low levels of financial literacy. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Financial literacy,Household surveys,Income,Personal finance,Socioeconomic factors,Wealth}
}

