@article{raueHowFarDoes2015,
  title = {How Far Does It Feel? {{Construal}} Level and Decisions under Risk},
  shorttitle = {How Far Does It Feel?},
  author = {Raue, Martina and Streicher, Bernhard and Lermer, Eva and Frey, Dieter},
  date = {2015-09-01},
  journaltitle = {Journal of Applied Research in Memory and Cognition},
  shortjournal = {Journal of Applied Research in Memory and Cognition},
  series = {Modeling and {{Aiding Intuition}} in {{Organizational Decision Making}}},
  volume = {4},
  number = {3},
  pages = {256--264},
  issn = {2211-3681},
  doi = {10.1016/j.jarmac.2014.09.005},
  url = {https://www.sciencedirect.com/science/article/pii/S2211368114000825},
  urldate = {2022-06-23},
  abstract = {Research has shown that framing decisions as gains or losses distorts human judgment. Human judgment is also assumed to be influenced by the actual level of construal. Whether decisions are construed in a more detailed manner (low level construal) or in a more abstract manner (high level construal) can depend on perceived psychological distance. In the present studies, we examined the influence of framing and psychological distance on risk taking. In three studies with students (n=65), physicians (n=60), and hotel managers (n=39), we found evidence that construal level influences risk seeking in gain situations, but not in loss situations. Furthermore, the framing effect could be replicated in psychologically close situations, and was eliminated (Studies 1 and 2) or reversed (Study 3) in psychologically distant situations. Our findings illuminate the interplay of framing and construal level, and points out their applicability in organizational decision making.},
  langid = {english},
  keywords = {Construal level,Decision making,Framing,Prospect theory,Psychological distance,Risk},
  file = {/home/chris/Zotero/storage/3QP58EJC/Raue et al. - 2015 - How far does it feel Construal level and decision.pdf;/home/chris/Zotero/storage/7QWWDJKC/Raue et al_2015_How far does it feel.pdf;/home/chris/Zotero/storage/BGZKW8QH/Raue et al_2015_How far does it feel.pdf;/home/chris/Zotero/storage/9YF9WU4B/S2211368114000825.html;/home/chris/Zotero/storage/N4GYS24C/S2211368114000825.html}
}

