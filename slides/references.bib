@article{HauserSchwarz,
  title = {It's a {{Trap}}! {{Instructional Manipulation Checks Prompt Systematic Thinking}} on ``{{Tricky}}'' {{Tasks}}},
  author = {Hauser, David J and Schwarz, Norbert},
  journaltitle = {SAGE Open},
  pages = {6},
  abstract = {Instructional manipulation checks (IMCs) have become popular tools for identifying inattentive participants in online studies. IMCs function by attempting to trick inattentive participants into responding incorrectly. However, from a conversational perspective, question characteristics are part of the researcher's contribution to the conversation, and IMCs may teach participants that there is ``more than meets the eye,'' prompting systematic thinking on subsequent tricky-seeming questions in an attempt to avoid being tricked. In two online studies, participants responded to a simple task either before or after completing an IMC. As expected, answering an IMC prior to the task improved performance on items that benefit from increased systematic thinking\textemdash namely, the Cognitive Reflection Test (Study 1), and a probabilistic reasoning task (Study 2). We conclude that IMCs change attention rather than merely measure attention and discuss implications for their use in online studies.},
  langid = {english},
  keywords = {\#nosource}
}

