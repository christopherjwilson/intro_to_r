@article{liHemisphericMPFCAsymmetry2019,
  title = {Hemispheric {{mPFC}} Asymmetry in Decision Making under Ambiguity and Risk: {{An fNIRS}} Study},
  shorttitle = {Hemispheric {{mPFC}} Asymmetry in Decision Making under Ambiguity and Risk},
  author = {Li, Yuhua and Chen, Rui and Zhang, Shuyue and Turel, Ofir and Bechara, Antoine and Feng, Tingyong and Chen, Hong and He, Qinghua},
  date = {2019-02-01},
  journaltitle = {Behavioural Brain Research},
