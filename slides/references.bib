@article{wankeAvailabilityHeuristicRevisited1995,
  title = {The Availability Heuristic Revisited: {{Experienced}} Ease of Retrieval in Mundane Frequency Estimates},
  shorttitle = {The Availability Heuristic Revisited},
  author = {Wänke, Michaela and Schwarz, Norbert and Bless, Herbert},
  date = {1995-06},
