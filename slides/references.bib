@article{FloresVieira2014,
  title = {Propensity toward Indebtedness: {{An}} Analysis Using Behavioral Factors},
  shorttitle = {Propensity toward Indebtedness},
  author = {Flores, Silvia Am\'elia Mendon\c{c}a and Vieira, Kelmara Mendes},
  date = {2014-09-01},
  journaltitle = {Journal of Behavioral and Experimental Finance},
  shortjournal = {Journal of Behavioral and Experimental Finance},
  volume = {3},
  pages = {1--10},
  issn = {2214-6350},
  doi = {10.1016/j.jbef.2014.05.001},
  url = {http://www.sciencedirect.com/science/article/pii/S2214635014000276},
  urldate = {2019-10-11},
  abstract = {This study aims to construct a model of propensity toward indebtedness using behavioral factors from 1046 inhabitants in Santa Maria (RS), Brazil. A questionnaire comprising 90 questions was administered. The questionnaire addressed demographic and cultural variables and seven behavioral factors: financial literacy, risk perception, risk behavior, emotion, materialism, indebtedness, and money-related values. Results indicate high risk perception, conservative risk behavior, and low levels of indebtedness and materialism. The tests reveal a significant difference in the level of debt according to age, gender, marital status, education, religion, religious principles, occupation, family income, credit card, and dependence on credit. In structural equation modeling, eight of the 10 original hypotheses are confirmed and three new ones inserted. The results also indicate positive influences from the constructs materialism and risk behavior and negative influences from the constructs risk perception, emotion, and value of money.},
  keywords = {Behavioral factors,Behavioral finance,Propensity to indebtedness},
  file = {C\:\\Users\\Owner\\Dropbox\\Papers\\Flores_Vieira_2014_Propensity toward indebtedness.pdf;C\:\\Users\\wilso\\Zotero\\storage\\XAALNS9T\\S2214635014000276.html}
}

