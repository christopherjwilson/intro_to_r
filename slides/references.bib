@article{JappelliPadula2013,
  title = {Investment in Financial Literacy and Saving Decisions.},
  author = {Jappelli, Tullio and Padula, Mario},
  date = {2013-08},
  journaltitle = {Journal of Banking \& Finance},
  volume = {37},
  number = {8},
  pages = {2779--2792},
  issn = {03784266},
  url = {http://10.0.3.248/j.jbankfin.2013.03.019 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=89113092{&}site=bsi-live},
  abstract = {Abstract: We present an intertemporal consumption model of investment in financial literacy. Consumers benefit from such investment because financial literacy allows them to increase the returns on wealth. Since literacy depreciates over time and has a cost in terms of current consumption, the model delivers an optimal investment in literacy. Furthermore, literacy and wealth are determined jointly, and are positively correlated over the life-cycle. The model drives our empirical approach to the analysis of the effect of financial literacy on wealth and saving and indicates that the stock of financial literacy early in life is a valid instrument in the regression of wealth on financial literacy. Using microeconomic and aggregate data, we find strong support for the model's predictions. [Copyright \&y\& Elsevier]},
  keywords = {\#nosource,Consumption (Economics),Decision making,Economic models,Financial literacy,Human capital,Industrial costs,Investments,Saving,Saving \{\textbackslash\&\} investment}
}

