@article{rayyan-471360488,
  title = {A Comparison of Pathological and Problem Gambling between College Students and College Athletes.},
  author = {{Rockey}},
  date = {1999-04},
  journaltitle = {Dissertation Abstracts International Section A: Humanities and Social Sciences},
  volume = {59},
  number = {10},
  pages = {3967--3967},
  publisher = {ProQuest Information \& Learning},
  issn = {0419-4209},
  url = {https://research.ebsco.com/plink/f58bc0a8-5c0d-3ccf-931c-53771a328247},
  abstract = {This investigation compared the prevalence rates of pathological and problem gambling between college athletes and college students. The effects of college student accessibility to casino gambling destinations on pathological and problem gambling rates were also investigated. The relationships between alcohol abuse and pathological and problem gambling were also investigated. Extensive descriptive data was also collected to provide a baseline for further gambling research. Nine hundred-fifty four subjects, who were enrolled in First Aid or Health and Safety classes from nine universities belonging to the Southeastern Conference, volunteered to complete the survey instrument. The survey was based on the South Oaks Gambling Screen, which is an instrument used to measure pathological gambling. Chi-square goodness of fit tests were used to measure significant associations between groups. Spearman Rho correlations were used to measure the relationships between driving distances, alcohol abuse, and the prevalence rates of pathological gambling. No significant associations existed between students and athletes in terms of pathological gambling. However, significant associations between athletes' and students' rates of problem gambling were found (p ¡ 0.02). Significant associations also were found in the prevalence rates of pathological gambling between males and females (p ¡ 0.00), grade point average (p ¡ 0.04), and age (p ¡ 0.04). Significant associations between students with Greek affiliation and independent' students and pathological gambling were also found particularly in athletes. In terms of accessibility, a significant positive relationship was found between lost time to work (school) and pathological gambling, but no significant relationship was found between pathological gambling rates and family income or between pathological gambling rates and driving distance to the nearest casino destination. A significant positive correlation was found between the rates of pathological gambling and alcohol abuse. This study concluded that gambling is a problem that is facing college athletes. Additional education is needed to educate coaches and athletes into the dangers of problem gambling. Recommendations for future studies were also included. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  langid = {english},
  keywords = {Adulthood (18 yrs & older),Alcohol Abuse,College Athletes,College Students,Female,Gambling,Male,Young Adulthood (18-29 yrs)}
}

