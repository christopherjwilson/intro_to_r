@article{sahniIncorporatingPerceptionsFinancial1994,
  title = {Incorporating {{Perceptions}} of {{Financial Control}} in {{Purchase Prediction}} - an {{Empirical-Examination}} of the {{Theory}} of {{Planned Behavior}}},
