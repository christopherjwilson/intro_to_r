  keywords = {Consumer attitudes,Consumer behavior,Consumer goods -- Economic aspects,Consumption (Economics) -- Forecasting,Financial literacy,Intention,Likelihood ratio tests,nosource,Personal finance,Planned behavior theory,Social control,Social norms,Theory of reasoned action}
