  author = {Chen, Qi and Feng, Yuqiang and Liu, Luning and Tian, Xianyun},
  date = {2019-02-01},
  journaltitle = {International Journal of Information Management},
  shortjournal = {International Journal of Information Management},
  volume = {44},
