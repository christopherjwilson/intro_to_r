@article{GerransEtAl2021,
  title = {Fintech and Responsibility: {{Buy-now-pay-later}} Arrangements},
  shorttitle = {Fintech and Responsibility},
  author = {Gerrans, Paul and Baur, Dirk G and Lavagna-Slater, Shane},
  date = {2021-07-21},
  journaltitle = {Australian Journal of Management},
