@article{hadwinInfluenceChildrensSelfreport2003,
  title = {The Influence of Children's Self-Report Trait Anxiety and Depression on Visual Search for Emotional Faces: {{Childhood}} Anxiety and Depression and Visual Search for Emotional Faces},
  shorttitle = {The Influence of Children's Self-Report Trait Anxiety and Depression on Visual Search for Emotional Faces},
