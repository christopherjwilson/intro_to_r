@article{mylonasDelegateSmartphoneUser2013,
  title = {Delegate the Smartphone User? {{Security}} Awareness in Smartphone Platforms},
  shorttitle = {Delegate the Smartphone User?},
  author = {Mylonas, Alexios and Kastania, Anastasia and Gritzalis, Dimitris},
  date = {2013-05},
  journaltitle = {Computers \& Security},
  shortjournal = {Computers \& Security},
