@article{vazWorkingMemoryChildren2010,
  title = {Working Memory in Children Assessed by the {{Brown-Peterson Task}}},
  author = {Vaz, Ivanilde Aparecida and Cordeiro, Priscila Maria and family=Macedo, given=Elizeu Coutinho, prefix=de, useprefix=false and Lukasova, Katerina},
  date = {2010-06},
