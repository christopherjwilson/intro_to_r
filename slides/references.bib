@incollection{WoodEtAl2016,
  title = {Cognitive {{Factors}} to {{Financial Crime Victimization}}},
  booktitle = {Financial Crimes: {{Psychological}}, Technological, and Ethical Issues.},
  author = {Wood, Stacey and Hanoch, Yaniv and Woods, George W.},
  editor = {Dion, Michel and Weisstub, David and Richet, Jean-Loup},
  date = {2016},
  series = {International Library of Ethics, Law, and the New Medicine; {{Vol}} 68},
  volume = {68},
  pages = {129--139},
  publisher = {{Springer International Publishing}},
  location = {{Wood, Stacey, Scripps College, Claremont, CA, US}},
  doi = {10.1007/978-3-319-32419-7_6},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-29550-006{&}site=ehost-live http://gwoods@georgewoodsmd.com http://Yaniv.Hanoch@gmail.com http://swood@scrippscollege.edu},
  abstract = {This chapter will address cognitive factors that result in susceptibility to financial crimes including financial literacy, numeracy, and deliberative reasoning. Financial literacy has been found to be a strong predictor of retirement savings, FICO scores, and savings accounts. Perhaps more importantly, financial literacy has been found to be a strong predictor of debt and vulnerability to predatory lending. Individuals low in numeracy, or literacy for numbers, tend to be more likely to employ heuristics such as loss aversion, sunk costs, and confirmatory bias in the financial decision making. Dual process models of decision making explain that decision making can be deliberative and analytical or emotional and impulsive. In general, investment schemers tend to employ techniques to engage more emotional or impulsive decision making. Factors that increase the likelihood of impulsive decision-making versus deliberative decision-making will be discussed (stress, ego depletion, cognitive impairment). (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-3-319-32418-0},
  keywords = {\#nosource,Cognitive Ability,cognitive factors,Crime,financial crime victimization,Financial Services,heuristics,Heuristics,Risk Factors,Victimization}
}

