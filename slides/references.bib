  issn = {01674870},
  doi = {10.1016/j.joep.2008.09.001},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0167487008000858},
  urldate = {2022-10-07},
  abstract = {We experimentally analyze consumers’ reactions to insurance default risk. Consistent with earlier studies, we find that insurance with default risk is extremely unattractive to most individuals. A considerable fraction of consumers completely refuse to accept any default risk; others ask for large reductions in insurance premiums. These findings are robust against several variations of the setup: probability representations (verbal and numeric), reasons for default (insolvency and claim settlement practices), framing (positively and negatively expressed probability of default), and comparisons between the policy’s level of default and that of an alternative (default free and small default risk). The major driver of willingness to pay is level of security concern and decisions are sensitive to the default probability. All other effects on willingness to pay are unsystematic.},
  langid = {english},
  keywords = {Concern,Framing,Insurance default risk,Verbal probabilities},
  file = {/home/chris/Zotero/storage/5MJHLYGA/Zimmer et al_2009_Is default risk acceptable when purchasing insurance.pdf;/home/chris/Zotero/storage/PED5QHJM/Zimmer et al_2009_Is default risk acceptable when purchasing insurance.pdf;/home/chris/Zotero/storage/Q8F7WCK3/Zimmer et al_2009_Is default risk acceptable when purchasing insurance.pdf;/home/chris/Zotero/storage/BR9WJBPT/S0167487008000858.html}
}

