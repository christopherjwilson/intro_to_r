@article{wuContinuanceIntentionUse2017,
  title = {Continuance Intention to Use {{MOOCs}}: {{Integrating}} the Technology Acceptance Model ({{TAM}}) and Task Technology Fit ({{TTF}}) Model},
  shorttitle = {Continuance Intention to Use {{MOOCs}}},
  author = {Wu, Bing and Chen, Xiaohui},
  date = {2017-02-01},
  journaltitle = {Computers in Human Behavior},
