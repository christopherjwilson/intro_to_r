@incollection{Lucey2012,
  title = {Conceptualizing Financial Morality},
  booktitle = {Reframing Financial Literacy: {{Exploring}} the Value of Social Currency.},
  author = {Lucey, Thomas A},
  editor = {Lucey, Thomas A and Laney, James D},
  date = {2012},
  pages = {47--63},
  publisher = {{IAP Information Age Publishing}},
  location = {{Charlotte, NC}},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2012-18170-003{&}site=ehost-live},
  abstract = {Financial morality represents the intersection of financial and moral conceptions. It concerns the extent to which patterns of financial decision making occur within a moral conception. Whether and how individuals and corporate entities position themselves in relation to this conceptual conundrum bears greatly on the integrity of their financial decision making. This chapter invites a scholarly dialogue about the abstract and material dimensions of these issues. It explores the nature of financial morality in both its broad and narrow forms by relating it to financial literacy and classism. These topics are important to the education community because of the existent curricular emphasis on economic-centered production content, rather than human-centered values content. The current reductionist climate, which integrates social studies into literacy and mathematics instruction in the elementary grades, constrains social studies thinking to a narrow perspective that aims at the development of responsible and participatory citizens (Carr, 2008; Lucey, in press; Westheimer \& Kahne, 2004). A participatory democracy also requires development of citizens that respect various points of view, and it builds from the different perspectives to create a system where all people are valued. By presenting these topics and a broader perspective on citizenship preparation, this chapter offers an opportunity to examine the concept of financial morality, modify this interpretation, and relate the notion to instructional practice. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-1-61735-719-0},
  keywords = {\#nosource,citizenship,Citizenship,classism,Curriculum,education,Education,Finance,Financial Literacy,financial morality,instructional practice,Morality,Socioeconomic Class Attitudes}
}

@article{LucianoEtAl2011,
  title = {A {{Relational Frame Analysis}} of {{Defusion Interactions}} in {{Acceptance}} and {{Commitment Therapy}}. {{A Preliminary}} and {{Quasi-Experimental Study}} with {{At-Risk Adolescents}}},
  author = {Luciano, Carmen and Ruiz, Francisco J and Torres, Rosa M Vizca\'ino and Mar, Vanessa S\'anchez},
  date = {2011},
  journaltitle = {International Journal of Psychology},
  pages = {18},
  abstract = {The present study aims to analyze the interactions involved in some of the Defusion exercises that are typical of Acceptance and Commitment Therapy according to a Relational Frame Theory analysis. Two protocols were compared. Defusion I protocol was built with deictic framing trials while Defusion II protocol added hierarchical framing plus the function of regulating one's own behavior. Fifteen adolescents (12-15 years old) with high scores in the impulsivity or in the emotional subscales of the Behavior Assessment System for Children (BASC) volunteered to participate during the three tutorial classes formally available. In a first session, after responding to questionnaires on psychological inflexibility (AFQ-S) and on problematic behaviors, the three classes followed a valuesoriented session. Two weeks later, 9 Low-risk participants (with less than 6 problematic behaviors) received either the Defusion I (n= 4) or the Defusion II (n= 5) protocols. Six High-risk participants (more than 6 problematic behaviors) received the Defusion II protocol. The comparison of both protocols with Low-risk participants showed that only Defusion II produced relevant changes that were improved at the 4-month follow-up. High-risk participants only received the Defusion II protocol and the results obtained replicated, in part, the effect obtained with Low-risk participants. The limitations of this preliminary study are indicated and further studies are emphasized.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Haun, Tomasello_2011_Conformity to Peer Pressure in Preschool Children(3).pdf}
}

