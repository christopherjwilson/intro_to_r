@article{HadarEtAl2013,
  title = {Subjective {{Knowledge}} in {{Consumer Financial Decisions}}},
  author = {Hadar, Liat and Sood, Sanjay and Fox, Craig R.},
  date = {2013-06},
  journaltitle = {Journal of Marketing Research},
  volume = {50},
  number = {3},
  eprint = {87734970},
  eprinttype = {pmid},
  pages = {303--316},
  publisher = {{American Marketing Association}},
  issn = {0022-2437},
  doi = {10.1509/jmr.10.0518},
  url = {http://10.0.5.229/jmr.10.0518 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=87734970{&}site=ehost-live http://journals.ama.org/doi/abs/10.1509/jmr.10.0518},
  abstract = {The authors propose that attempts to increase consumers' objective knowledge (OK) regarding financial instruments can deter willingness to invest when such attempts diminish consumers' subjective knowledge (SK). In four studies, the authors use different SK manipulations and investment products to show that investment decisions are influenced by SK, independent of OK. Specifically, they find that (1) willingness to pursue a risky investment increases when SK is high (vs. low) relative to a prior investment choice (Study 1); (2) willingness to enroll in a retirement saving program is enhanced by asking consumers an easy (vs. difficult) question about finance, thereby increasing SK (Study 2); (3) technically elaborating information about a mutual fund diminishes SK regarding that investment and decreases choice of that fund (Study 3); and (4) consumers invest less money in funds when missing information is made salient, holding the objective investment information constant (Study 4). Furthermore, the effects in Studies 2\textendash 4 are mediated by participants' self-rated SK. The authors propose that effective financial education must focus not only on imparting relevant information and enhancing OK but also on promoting higher levels of SK.},
  isbn = {00222437},
  mendeley-tags = {financial decisions subjective knowledge},
  keywords = {Certainty,comparative ignorance,consumer choice,Decision making,financial decision making,financial decisions subjective knowledge,financial education,Financial literacy,Financial planning,Ignorance (Theory of knowledge),Individual retirement accounts,Investment products,Judgment (Psychology),Objectivity,Personal finance,Saving \{\textbackslash\&\} investment -- Study \{\textbackslash\&\} teaching,Saving \& investment -- Study \& teaching,subjective knowledge,Subjectivity -- Psychological aspects,Uncertainty},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Hadar et al_2013_Subjective Knowledge in Consumer Financial Decisions.pdf}
}

