@article{RovettiEtAl2019,
  title = {Functional {{Near-Infrared Spectroscopy}} as a {{Measure}} of {{Listening Effort}} in {{Older Adults Who Use Hearing Aids}}},
  author = {Rovetti, Joseph and Goy, Huiwen and Pichora-Fuller, M. Kathleen and Russo, Frank A.},
  date = {2019-01-01},
  journaltitle = {Trends in Hearing},
  shortjournal = {Trends in Hearing},
  volume = {23},
  pages = {2331216519886722},
  publisher = {{SAGE Publications Inc}},
  issn = {2331-2165},
  doi = {10.1177/2331216519886722},
  url = {https://doi.org/10.1177/2331216519886722},
  urldate = {2022-07-06},
  abstract = {Listening effort may be reduced when hearing aids improve access to the acoustic signal. However, this possibility is difficult to evaluate because many neuroimaging methods used to measure listening effort are incompatible with hearing aid use. Functional near-infrared spectroscopy (fNIRS), which can be used to measure the concentration of oxygen in the prefrontal cortex (PFC), appears to be well-suited to this application. The first aim of this study was to establish whether fNIRS could measure cognitive effort during listening in older adults who use hearing aids. The second aim was to use fNIRS to determine if listening effort, a form of cognitive effort, differed depending on whether or not hearing aids were used when listening to sound presented at 35\,dB SL (flat gain). Sixteen older adults who were experienced hearing aid users completed an auditory n-back task and a visual n-back task; both tasks were completed with and without hearing aids. We found that PFC oxygenation increased with n-back working memory demand in both modalities, supporting the use of fNIRS to measure cognitive effort during listening in this population. PFC oxygenation was weakly and nonsignificantly correlated with self-reported listening effort and reaction time, respectively, suggesting that PFC oxygenation assesses a dimension of listening effort that differs from these other measures. Furthermore, the extent to which hearing aids reduced PFC oxygenation in the left lateral PFC was positively correlated with age and pure-tone average thresholds. The implications of these findings as well as future directions are discussed.},
  langid = {english},
  keywords = {aging,hearing loss,n-back task,neuroimaging,working memory},
  file = {C:\Users\wilso\Zotero\storage\FF6B3KXX\Rovetti et al_2019_Functional Near-Infrared Spectroscopy as a Measure of Listening Effort in Older.pdf}
}

@article{RoweEtAl2001,
  title = {Imaging the Mental Components of a Planning Task},
  author = {Rowe, J. B. and Owen, A. M. and Johnsrude, I. S. and Passingham, R. E.},
  date = {2001-01-01},
  journaltitle = {Neuropsychologia},
  shortjournal = {Neuropsychologia},
  volume = {39},
  number = {3},
  pages = {315--327},
  issn = {0028-3932},
  doi = {10.1016/S0028-3932(00)00109-3},
  url = {https://www.sciencedirect.com/science/article/pii/S0028393200001093},
  urldate = {2023-09-06},
  abstract = {The Tower of London task (TOL) has been widely used to assess the ability to plan. We used H2O15-positron emission tomography to isolate some of the cognitive components of the task. Ten male volunteers were scanned twice in each of six conditions. In two conditions (plan) the subjects had to plan the best solution to TOL problems. In two other conditions (plan\textendash control) the subjects were required to generate four moves without being constrained by a goal. In plan and plan\textendash control tasks the subjects either planned the moves and then executed them (MOVE conditions) or imagined the necessary moves (IMAGINE conditions). The plan and plan\textendash control tasks were matched for the working memory load and `initial thinking time'. A visuomotor control task and rest served as baseline conditions. Performance on the plan tasks, in contrast to the baseline conditions, was associated with activation in the dorsal prefrontal cortex, premotor and parietal cortex, and cerebellum. Performance of the plan\textendash control tasks was associated with activation of the same areas. Contrasting the plan with the plan\textendash control tasks revealed no residual activation in the prefrontal cortex. These data show that the activity of the dorsolateral prefrontal cortex on the TOL can be accounted for by the components of generating, selecting and/or remembering mental moves. The task of relating the moves to the goal involves a comparison with a representation of the goal in posterior association areas. We did not find evidence that activation of the dorsal prefrontal cortex is specifically related to the evaluation of a path towards a specified goal, a key component of planning.},
  keywords = {PET,Plan,Prefrontal cortex,Tower of London},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Rowe et al_2001_Imaging the mental components of a planning task.pdf;C\:\\Users\\wilso\\Zotero\\storage\\EPA3VQAP\\S0028393200001093.html}
}

@incollection{RoyZeckhauser2016,
  title = {Ignorance: {{Literary}} Light on Decision's Dark Corner},
  booktitle = {Routledge {{Handbook}} of {{Behavioral Economics}}},
  author = {Roy, Devjani and Zeckhauser, Richard},
  editor = {Frantz, Roger and Chen, Shu-Heng and Dopfer, Kurt and Heukelom, Floris and Mousavi, Shabnam},
  date = {2016},
  series = {Routledge International Handbooks},
  pages = {230--249},
  publisher = {{Routledge/Taylor \& Francis Group}},
  location = {{New York, NY}},
  doi = {10.4324/9781315743479},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2016-20971-017{&}site=ehost-live},
  abstract = {Rational decision theory requires that the decision maker attach von Neumann-Morgenstern utilities to possible outcomes. Each outcome represents the combination of the state of the world and a decision taken. In a broad range of decision problems, however, the decision maker is unable to identify important outcomes, hence potential significant outcomes remain unknown. Ignorance represents a situation in which some potential outcomes cannot be identified. Ignorance has received surprisingly scant attention in the behavioral economics literature. This chapter examines the concept of ignorance and identifies the behavioral propensities that arise when it is present\textemdash some well known and others specific to decision situations that involve ignorance. It also introduces a new methodological approach to behavioral decision, drawing on the choices of characters in great literature as qualitative evidence of human. (PsycINFO Database Record (c) 2017 APA, all rights reserved)},
  isbn = {978-1-315-74347-9},
  keywords = {\#nosource,Ability Level,behavioral economics,Behavioral Economics,decision making,Decision Making,Financial Literacy,ignorance,literacy}
}

