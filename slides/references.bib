@article{hurleyEgoDepletionApplications2015,
  title = {Ego Depletion: {{Applications}} and Implications for Auditing Research},
  shorttitle = {Ego Depletion},
  author = {Hurley, Patrick J.},
  date = {2015-10-31},
  journaltitle = {Journal of Accounting Literature},
  shortjournal = {Journal of Accounting Literature},
  volume = {35},
  number = {1},
  pages = {47--76},
  issn = {0737-4607},
  doi = {10.1016/j.acclit.2015.10.001},
  url = {https://www.emerald.com/insight/content/doi/10.1016/j.acclit.2015.10.001/full/html},
  urldate = {2022-10-07},
  abstract = {In this paper, I synthesize the prior psychology literature on ego depletion and apply this literature to an auditing setting. Ego depletion refers to a reduced desire or ability to use self-control in task performance due to using self-control on prior tasks. I focus on the likely causes and consequences of depletion in an auditing setting, as well as means of mitigating depletion and recovering self-control resources. While ego depletion theory is prevalent in the psychology literature, little is known about whether or how ego depletion affects professionals on meaningful task performance. As a result, this synthesis is aimed at stimulating future ego depletion research in accounting, and specifically auditing, by surveying existing literature and applying this literature to an auditing setting. Further, I develop 13 questions for future research to investigate. My synthesis reveals that ego depletion likely has a pervasive effect in an auditing setting, and can hinder auditors’ judgment and decision-making (JDM) quality. Therefore, this synthesis helps to provide a greater understanding of the impact of auditing tasks on individuals, and refines both auditor JDM and ego depletion theories.},
  langid = {english},
  keywords = {Audit quality,Auditing,Ego depletion,Judgment and decision-making,nosource,Self-control},
  file = {/home/chris/Zotero/storage/9CV4D6Q3/Hurley_2015_Ego depletion.pdf;/home/chris/Zotero/storage/CDDN6JU8/Hurley_2015_Ego depletion.pdf;/home/chris/Zotero/storage/NGQQV888/Hurley - 2015 - Ego depletion Applications and implications for a.pdf;/home/chris/Zotero/storage/KRQMV8ZX/S0737460715000154.html}
}

@report{hurleyReconceptualizingEgoDepletion2021,
  type = {SSRN Scholarly Paper},
  title = {Reconceptualizing {{Ego Depletion}} as {{Transient Cognitive Fatigue}}},
  author = {Hurley, Patrick J.},
  date = {2021-03-03},
  institution = {Social Science Research Network},
  location = {Rochester, NY},
  doi = {10.2139/ssrn.3797263},
  url = {https://papers.ssrn.com/abstract=3797263},
  urldate = {2021-04-28},
  abstract = {Ego depletion is embroiled in a crisis that has cast doubts over the legitimacy of the phenomenon itself and its theoretical explanation. I first summarize and analyze the strength model of self- control as cohesive theoretical explanations of the phenomenon and highlight the difficulties it creates for depletion researchers. I conclude that the strength model is not the best theoretical explanation for the depletion phenomenon. Rather, I propose reconceptualizing the ego depletion effect as transient cognitive fatigue (TCF). To support this theoretical shift, I highlight how both the classic and disparate findings in the depletion literature cleanly map into the literature on cognitive fatigue, and how considering depletion to be TCF accommodates existing theoretical alternatives to the strength model.},
  eid = {ID 3797263},
  langid = {english},
  keywords = {ego depletion,mental fatigue,motivation,self-control,self-regulation,transient cognitive fatigue},
  file = {/home/chris/Zotero/storage/DRLDRALS/Hurley - 2021 - Reconceptualizing Ego Depletion as Transient Cogni.pdf;/home/chris/Zotero/storage/Z67DXRH3/papers.html}
}

