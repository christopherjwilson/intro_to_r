@article{wangExploringComplexRelationship2024,
  title = {Exploring the Complex Relationship between Depression and Risky Decision-Making: {{A}} Meta-Analysis},
  shorttitle = {Exploring the Complex Relationship between Depression and Risky Decision-Making},
  author = {Wang, Tao and Zeng, Jianmin and Yuan, Yujie and He, Ying and Zhu, Jiayi and Lin, Beitong and Yin, Qiao and Peng, Peiru},
  date = {2024-04-01},
  journaltitle = {Journal of Affective Disorders Reports},
  shortjournal = {Journal of Affective Disorders Reports},
  volume = {16},
  pages = {100771},
  issn = {2666-9153},
  doi = {10.1016/j.jadr.2024.100771},
  url = {https://www.sciencedirect.com/science/article/pii/S266691532400057X},
  urldate = {2025-11-05},
  abstract = {Numerous studies have examined the association between depression and risky decision-making, but the results are mixed. To address this issue, we conducted a meta-analysis of risky decision-making in individuals with current Major depressive disorder (MDD). Patients with MDD exhibit divergent performances in risky decision-making across various tasks. Specifically, MDD patients tend to select the disadvantageous decks in the Iowa Gambling Task (SMD = 0.40; 95\%CI = 0.09 to 0.70; p = 0.011), make fewer pumps on the balloon in the Balloon Analog Risk Task (SMD = -0.29; 95\%CI = -0.47 to -0.12; p {$<$} 0.01), and demonstrate similar performance in the Cambridge Gambling Task and the Game of Dice Task when compared to healthy controls. The meta-regression analysis revealed that age exhibits a significant correlation with the effect size in the Balloon Analog Risk Task (z = 2.375, p = 0.018, 95\%CI = [0.004,0.043]). The subgroup analysis showed a significant difference in effect sizes among age groups within both the Iowa Gambling Task (Q = 9.34, df = 3, p = 0.025) and the Balloon Analog Risk Task (Q = 6.48, df = 1, p = 0.011). These findings indicate that MDD might impair the distinct process of risky decision-making, and age may paly vital role in the performance of MDD patients in risky decision-making. Understanding this could potentially facilitate more effective clinical interventions, thus reducing the burden on society.},
  keywords = {Age,Depression,Risky decision-making,The Balloon Analog Risk Task,The Iowa Gambling Task},
  file = {/home/chris/Zotero/storage/57PGEMQP/Wang et al. - 2024 - Exploring the complex relationship between depression and risky decision-making A meta-analysis.pdf;/home/chris/Zotero/storage/C2DRZZ8L/S266691532400057X.html}
}

@article{wangFamiliarityPopoutVisual1994,
  title = {Familiarity and Pop-out in Visual Search},
  author = {Wang, Qinqin and Cavanagh, Patrick and Green, Marc},
  date = {1994-09},
  journaltitle = {Perception \& Psychophysics},
  shortjournal = {Perception \& Psychophysics},
  volume = {56},
  number = {5},
  pages = {495--500},
  issn = {0031-5117, 1532-5962},
  doi = {10.3758/BF03206946},
  url = {http://link.springer.com/10.3758/BF03206946},
  urldate = {2022-10-07},
  abstract = {In this paper, we report that when the low-level features of targets and distractors are held constant, visual search performance can be strongly influenced by familiarity. In the first condition, a Open image in new window was the target amid Open image in new window as distractors, and vice versa. The response time increased steeply as a function of number of distractors (82 msec/item). When the same stimuli were rotated by 90° (the second condition), however, they became familiar patterns— Open image in new window and Open image in new window —and gave rise to much shallower search functions (31 msec/item). In the third condition, when the search was for a familiar target, Open image in new window (or Open image in new window ), among unfamiliar distractors, Open image in new window (or Open image in new window ), the slope was about 46 msec/item. In the last condition, when the search was for an unfamiliar target, Open image in new window (or Open image in new window ), among familiar distractors, Open image in new window s (or Open image in new window s), parallel search functions were found with a slope of about 1.5 msec/item. These results show that familiarity speeds visual search and that it does so principally when the distractors, not the targets, are familiar.},
  langid = {english},
  keywords = {Parallel Search,Primitive Feature,Quarterly Journal ofExperimental Psychology,Search Rate,Visual Search},
  file = {/home/chris/Zotero/storage/3MHYZH49/Wang et al_1994_Familiarity and pop-out in visual search.pdf;/home/chris/Zotero/storage/AJKIMHSD/Wang et al_1994_Familiarity and pop-out in visual search.pdf;/home/chris/Zotero/storage/SH753W3U/Wang et al_1994_Familiarity and pop-out in visual search.pdf}
}

@article{wangHighSelfControlReduces2019,
  title = {High {{Self-Control Reduces Risk Preference}}: {{The Role}} of {{Connectivity Between Right Orbitofrontal Cortex}} and {{Right Anterior Cingulate Cortex}}},
  shorttitle = {High {{Self-Control Reduces Risk Preference}}},
  author = {Wang, Mengmeng and Chen, Zhiyi and Zhang, Shunmin and Xu, Ting and Zhang, Rong and Suo, Tao and Feng, Tingyong},
  date = {2019-03-11},
  journaltitle = {Frontiers in Neuroscience},
  shortjournal = {Front. Neurosci.},
  volume = {13},
  publisher = {Frontiers},
  issn = {1662-453X},
  doi = {10.3389/fnins.2019.00194},
  url = {https://www.frontiersin.org/journals/neuroscience/articles/10.3389/fnins.2019.00194/full},
  urldate = {2024-06-27},
  abstract = {{$<$}p{$>$}Risk preference, the preference for risky choices over safe alternatives, has a great impact on many fields, such as physical health, sexual safety and financial decision making. Ample behavioral research has attested that inadequate self-control can give rise to high risk preference. However, little is known about the neural substrates underlying the effect of self-control on risk preference. To address this issue, we combined voxel-based morphometry (VBM) with resting-state functional connectivity (RSFC) analyses to explore the neural basis underlying the effect of self-control on risk preference across two independent samples. In sample 1 (99 participants; 47 males; 20.37 ± 1.63 years), the behavioral results indicated that the scores of self-control were significantly and negatively correlated with risk preference (indexed by gambling rate). The VBM analyses demonstrated that the higher risk preference was correlated with smaller gray matter volumes in right orbitofrontal cortex (rOFC) and right posterior parietal cortex. In the independent sample 2 (80 participants; 33 males; 20.33 ± 1.83 years), the RSFC analyses ascertained that the functional connectivity of rOFC and right anterior cingulate cortex (rACC) was positively associated with risk preference. Furthermore, the mediation analysis identified that self-control mediated the impact of functional connectivity of rOFC-rACC on risk preference. These findings suggest the functional coupling between the rOFC and rACC might account for the association between self-control and risk preference. The present study extends our understanding on the relationship between self-control and risk preference, and reveals possible neural underpinnings underlying this association.{$<$}/p{$>$}},
  langid = {english},
  keywords = {Mediation,Resting-state functional connectivity,Risk preference,Self-Control,voxel-based morphometry},
  file = {/home/chris/Zotero/storage/ADWCX56N/Wang et al_2019_High Self-Control Reduces Risk Preference.pdf}
}

