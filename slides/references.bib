  abstract = {In this paper the authors formulate probabilistic models for the credit granting policy of a firm. At first, a single-period analysis for the credit-granting problem is presented. Then, for the same problem a multi-period analysis is presented, showing that the single-period analysis ignores important future benefits. The multi-period analysis contains a Bayesian approach to revisions of the probability of collection as collection experience is gained. The performance index, which has to be maximized with respect to the decision on how much credit to offer to credit applicants of different risk categories, contains some information of the future observations. Dynamic programming is used to take into account the future effects of present actions. A specific algorithm is derived which seems to be appropriate in terms of computational feasibility for this type of problems. (English) [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Credit,Decision making,Dynamic programming,Mathematical models,Probability theory,Risk}
}

