@article{MielitzEtAl2018,
  title = {Financial {{Literacy Education}} in a {{Work Release Program}} for an {{Incarcerated Sample}}.},
  author = {Mielitz, Katherine (Kate) S and MacDonald, Maurice and Lurtz, Meghaan},
  date = {2018-07},
  journaltitle = {Journal of Financial Counseling \& Planning},
  volume = {29},
  number = {2},
  pages = {316--327},
  issn = {10523073},
  url = {http://10.0.7.99/1052-3073.29.2.316 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=133112350{&}site=bsi-live},
  abstract = {We obtained 180 pre- and post-test surveys to investigate how an established financial literacy program may have increased financial knowledge of residents in a work release program in Augusta, Georgia. Paired t tests analyzed changes in subjective and objective financial knowledge, understanding of banking and credit, and financial attitudes. OLS regressions of pre- and post-test financial knowledge were guided by human capital theory to learn which program participant characteristics were associated with greater increase in knowledge and infer why. Education, age, and use of financial tools were significant predictors in the pretest. Controlling for pretest knowledge, there were significant, positive differences from pre- to post-test, regardless of race. Implications for further research and specific suggestions for financial education content for the incarcerated are provided. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,financial education,financial knowledge,Financial literacy,Financial management,Financial planning,Human capital,human capital theory,incarcerated,Prisoners,work release}
}

