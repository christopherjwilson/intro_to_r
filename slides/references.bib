@article{krishnamurthyAttributeFramingGoal2001,
  title = {Attribute {{Framing}} and {{Goal Framing Effects}} in {{Health Decisions}}},
  author = {Krishnamurthy, Parthasarathy and Carter, Patrick and Blair, Edward},
  date = {2001-07},
  journaltitle = {Organizational Behavior and Human Decision Processes},
  shortjournal = {Organizational Behavior and Human Decision Processes},
  volume = {85},
