  author = {\cyrchar\CYRCH\cyrchar\CYRU\cyrchar\CYRL\cyrchar\CYRK\cyrchar\CYRO\cyrchar\CYRV, \cyrchar\CYRA\cyrchar\cyrl\cyrchar\cyre\cyrchar\cyrk\cyrchar\cyrs\cyrchar\cyra\cyrchar\cyrn\cyrchar\cyrd\cyrchar\cyrr{} \cyrchar\CYRS\cyrchar\cyre\cyrchar\cyrr\cyrchar\cyrg\cyrchar\cyre\cyrchar\cyre\cyrchar\cyrv\cyrchar\cyri\cyrchar\cyrch},
