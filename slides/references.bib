  urldate = {2026-09-11},
  abstract = {The theory of bounded rationality suggests that maximization is often unrealistic and irrational in real-world decision-making due to environmental complexity and limitations in information processing. Despite its irrationality, the pursuit of maximization remains a prevalent phenomenon. This research explores whether maximization may stem from threatened self-esteem. Four studies were conducted to test these predictions. Studies 1–2 (n~=~831 adults combined) examined the relationships between threatened self-esteem (both internal and external) and maximization (both goal and strategy). Study 3 (n~=~332 adults) investigated the mediating role of the need for social status, while Study 4 (n~=~638 adults) explored the compensation effect of a maximizing mindset for self-esteem by manipulating decision mindsets. The findings revealed that individuals with a greater vulnerability to self-esteem threats, as well as those facing external self-esteem threats, demonstrated stronger maximizing tendencies, which were mediated by an increased need for social status. Additionally, adopting a maximizing mindset effectively enhanced state self-esteem in response to a self-esteem threat. These results suggest that maximization may function as a form of self-esteem regulation, acting as a compensatory mechanism to restore or strengthen threatened self-esteem.},
  keywords = {Compensation effect,Maximization,Need for social status,Self-enhancement,Threatened self-esteem},
  file = {/home/chris/Zotero/storage/TXNNJNML/S0191886925002739.html}
}

@article{huangSexualRisktakingBehaviors2010,
  title = {Sexual Risk-Taking Behaviors, Gambling, and Heavy Drinking among {{U}}.{{S}}. {{College}} Athletes.},
  author = {Huang, Jiun-Hau and Jacobs, Durand F and Derevensky, Jeffrey L},
  date = {2010-06-01},
