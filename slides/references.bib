  author = {Pennay, Amy and Livingston, Michael and Cook, Megan and Room, Robin and Dwyer, Robyn and MacLean, Sarah and O'Brien, Niamh and Nicholson, Matthew and Kuntsche, Emmanuel},
  date = {2021-08-01},
  journaltitle = {Addiction Research \& Theory},
  shortjournal = {Addiction Research \& Theory},
  volume = {29},
  number = {4},
  pages = {316--326},
  publisher = {Taylor \& Francis Ltd},
  location = {Philadelphia, Pennsylvania},
  issn = {1606-6359},
  doi = {10.1080/16066359.2020.1830071},
  url = {https://research.ebsco.com/linkprocessor/plink?id=4db8a3b2-b171-3d1d-b8fb-e3940f6ee05e},
  abstract = {Informed by literature on venue design and 'nudging' in the context of choice architecture, the purpose of this article is to investigate the physical design of, and practices enacted within, sports bars to provide some indication as to whether these venues are spaces that encourage risky drinking and betting. Our analysis draws on three arms of data collection: (i) website review of licensed venues in Victoria, Australia that promoted sports telecasting; (ii) observational data collection including site visits to 50 venues in Victoria that promoted sport telecasting, and more intensive sessions of observation during six sporting matches; and (iii) in situ interviews with 200 sports bar patrons. We identified three types of sports bars: (i) prototypical sports bars; (ii) venues that have a sports bar section; and (iii) venues that televise sport on occasion. Sports bar attendees reported moderately heavy drinking at sports bars and frequent engagement in sports betting. We identified two distinct groups of sports bettors. Prototypical sports bars and venues that televise sport on occasion attracted younger men who bet the least frequently but in the highest amounts, while venues that have a sports bar section attracted older men who bet more often but in smaller amounts. We identified several design elements across the three types of venues, each 'nudging' sports betting and drinking in different ways. Any focused public health work in relation to sports bars will need to consider the social and physical design elements of different sports betting environments.},
  langid = {english},
  keywords = {Advertising,Alcohol Drinking,Environment,Facility Design and Construction Victoria,Gambling,Human,Interviews,Public Health,Risk Taking Behavior,Sports,Victoria}
}

