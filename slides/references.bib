@article{Cheak-zamoraEtAl2017,
  title = {Financial {{Capabilities Among Youth}} with {{Autism Spectrum Disorder}}},
  author = {Cheak-zamora, Nancy C. and Teti, Michelle and Peters, Clark and Maurer-batjer, Anna},
  date = {2017-05},
  journaltitle = {Journal of Child and Family Studies},
  volume = {26},
  number = {5},
  pages = {1310--1317},
  publisher = {{Springer Nature B.V.}},
  location = {{New York, Netherlands}},
  issn = {10621024},
  doi = {10.1007/s10826-017-0669-9},
  url = {https://www.proquest.com/docview/1886217614/abstract/B9D80CF0963B4582PQ/1},
  urldate = {2023-07-13},
  abstract = {Youth with Autism Spectrum Disorder (ASD) experience significant difficulties assuming adult responsibilities and achieving independence. Little is known about their desire or ability to manage their own finances. This study explored the financial circumstances, money management skills, and desires for financial independence among 27 youth with ASD. Youth took part in 30-60min semi-structured interviews about independence. Strategies of theme analysis identified three critical themes about finances and emerging adulthood for youth with ASD. Youth (1) defined independence by being able to manage their finances, (2) worried about their lack of money management skills, and (3) cited poor financial skills as barrier to independence. Results suggest youth with ASD understand the importance of financial capability and strive for financial independence, but lack the skills and support needed to achieve their financial goals. This study provides preliminary information for clinicians, educators, and researchers to develop financial capability modules for youth with ASD.},
  langid = {english},
  pagetotal = {1310-1317},
  keywords = {Autism spectrum disorder,Financial capabilities,Independence,Money management,Qualitative methods,Youth/young adults},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Cheak-zamora et al_2017_Financial Capabilities Among Youth with Autism Spectrum Disorder.pdf}
}

