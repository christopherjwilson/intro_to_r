@article{Healey,
  title = {Attention and {{Visual Memory}} in {{Visualization}} and {{Computer Graphics}}},
  author = {Healey, Christopher G},
  journaltitle = {IEEE TRANSACTIONS ON VISUALIZATION AND COMPUTER GRAPHICS},
  pages = {20},
  abstract = {A fundamental goal of visualization is to produce images of data that support visual analysis, exploration, and discovery of novel insights. An important consideration during visualization design is the role of human visual perception. How we ``see'' details in an image can directly impact a viewer's ef\`Aciency and effectiveness. This article surveys research on attention and visual perception, with a speci\`Ac focus on results that have direct relevance to visualization and visual analytics. We discuss theories of low-level visual perception, then show how these \`Andings form a foundation for more recent work on visual memory and visual attention. We conclude with a brief overview of how knowledge of visual attention and visual memory is being applied in visualization and graphics. We also discuss how challenges in visualization are motivating research in psychophysics.},
  langid = {english},
  keywords = {\#nosource}
}

@article{HealeyEtAl2010,
  title = {The Research\textendash Teaching Nexus: A Case Study of Students' Awareness, Experiences and Perceptions of Research},
  shorttitle = {The Research\textendash Teaching Nexus},
  author = {Healey, Mick and Jordan, Fiona and Pell, Barney and Short, Chris},
  date = {2010-05},
  journaltitle = {Innovations in Education and Teaching International},
  shortjournal = {Innovations in Education and Teaching International},
  volume = {47},
  number = {2},
  pages = {235--246},
  issn = {1470-3297, 1470-3300},
  doi = {10.1080/14703291003718968},
  url = {http://www.tandfonline.com/doi/abs/10.1080/14703291003718968},
  urldate = {2022-10-07},
  abstract = {This paper presents a case study of students\quotedblbase{} awareness, experiences and perceptions of research in a ,,new\quotedblbase{} university in the UK. The findings are based on a questionnaire of almost 200 students and five small group interviews. Many of the students participating in this research perceived clear benefits to their learning from staff research, including being taught by enthusiastic staff, enhanced staff credibility, and the reflected glory of being taught by well-known researchers. However, they also perceived disadvantages, particularly with regard to staff availability and did not believe that staff research should take priority over their needs as learners. They recognised that their awareness of the nature of research and the development of research skills increased most when they were actively involved in undertaking research projects. Several students also perceived benefits for future employment from their participation in research activities. The questionnaire has been used by several other universities around the world to benchmark their practices.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Healey et al_2010_The research–teaching nexus.pdf}
}

