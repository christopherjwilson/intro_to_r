  author = {{Jiun-Hau Huang} and Huang, Jiun-Hau and {Durand F. Jacobs} and Jacobs, Durand F. and {Jeffrey L. Derevensky} and Derevensky, Jeffrey L. and {Rina Gupta} and Gupta, Rina and {Thomas S. Paskus} and Paskus, Thomas S.},
  date = {2007-05-01},
  journaltitle = {Journal of Adolescent Health},
