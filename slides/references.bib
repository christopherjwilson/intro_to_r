@article{leaderMatchingToSampleRespondentTypeTraining2001,
  title = {Matching-{{To-Sample}} and {{Respondent-Type Training}} as {{Methods}} for {{Producing Equivalence Relations}}: {{Isolating The Critical Variable}}},
