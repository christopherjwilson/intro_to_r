@article{Javine2013,
  title = {Financial {{Knowledge}} and {{Student Loan Usage}} in {{College Students Department}} of {{Economics}} and {{Finance Mitchell College}} of {{Business University}} of {{South Alabama}}},
  author = {Javine, Victoria},
  date = {2013},
  journaltitle = {Numeracy},
  volume = {6},
  number = {2},
  pages = {1--27},
  publisher = {{Academy of Financial Services}},
  issn = {0016-8033},
  doi = {10.1190/1.1442988},
  url = {http://scholarcommons.usf.edu/numeracy/vol6/iss2/art1},
  abstract = {We give a two-dimensional (2-D) velocity-stress finite-difference\textbackslash n(vs-fd) formulation for the multipole borehole acoustic logging problem.\textbackslash nIrregular boreholes, horizontal bedding, and axially varying alternation\textbackslash nare encompassed by the model. Excellent agreement is obtained with\textbackslash ntransform techniques for constant radius boreholes and homogeneous\textbackslash nformations. The method is used to generate waveforms for many positions\textbackslash nof transmitter and receiver array relative to beds and washouts as in\textbackslash nlogging. First motion and semblance techniques are applied to the\textbackslash nwave-forms to extract formation slownesses, resulting in synthetic\textbackslash nmultiple logs which demonstrate the response of ideal multipole logging\textbackslash ntools and signal processing to several environmental effects.\textbackslash nFor monopole, compressional, first-motion logs, residual slowness errors\textbackslash nremain at borehole washouts after borehole compensation. These errors\textbackslash nincrease as the effective measure point in the waveforms is moved back\textbackslash nin time from true first motion, admitting greater interference from\textbackslash nreflected and mode-converted waves. Errors at bed boundaries are\textbackslash ntypically smaller than those at washouts. Stoneley slowness logs are\textbackslash nobtained by narrow-band filtering of low frequency monopole waveforms\textbackslash nand application of the semblance slowness extraction algorithm STC. \textbackslash nSimilar processing applied to low frequency dipole waveforms yields\textbackslash nflexural mode slowness logs. A small correction satisfactorily accounts\textbackslash nfor flexural mode dispersion properties, yielding formation shear\textbackslash nslowness. Slowness errors for both Stoneley and dipole shear logs at\textbackslash nwashouts and bed boundaries are quite small, typically on the order of a\textbackslash nfew percent. Borehole compensation is of marginal benefit for both of\textbackslash nthese logs since they are based on modes of the borehole rather than\textbackslash nheadwaves.},
  keywords = {\#nosource,financial literacy,student loan debt}
}

@article{JeffreyEtAl2020,
  title = {Anonymised and Aggregated Crowd Level Mobility Data from Mobile Phones Suggests That Initial Compliance with {{COVID-19}} Social Distancing Interventions Was High and Geographically Consistent across the {{UK}}},
  author = {Jeffrey, Benjamin and Walters, Caroline E. and Ainslie, Kylie E. C. and Eales, Oliver and Ciavarella, Constanze and Bhatia, Sangeeta and Hayes, Sarah and Baguelin, Marc and Boonyasiri, Adhiratha and Brazeau, Nicholas F. and Cuomo-Dannenburg, Gina and FitzJohn, Richard G. and Gaythorpe, Katy and Green, William and Imai, Natsuko and Mellan, Thomas A. and Mishra, Swapnil and Nouvellet, Pierre and Unwin, H. Juliette T. and Verity, Robert and Vollmer, Michaela and Whittaker, Charles and Ferguson, Neil M. and Donnelly, Christl A. and Riley, Steven},
  date = {2020-07-17},
  journaltitle = {Wellcome Open Research},
  shortjournal = {Wellcome Open Res},
  volume = {5},
  eprint = {32954015},
  eprinttype = {pmid},
  issn = {2398-502X},
  doi = {10.12688/wellcomeopenres.15997.1},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7479499/},
  urldate = {2020-11-04},
  abstract = {Background: Since early March 2020, the COVID-19 epidemic across the United Kingdom has led to a range of social distancing policies, which have resulted in reduced mobility across different regions. Crowd level data on mobile phone usage can be used as a proxy for actual population mobility patterns and provide a way of quantifying the impact of social distancing measures on changes in mobility.,  Methods: Here, we use two mobile phone-based datasets (anonymised and aggregated crowd level data from O2 and from the Facebook app on mobile phones) to assess changes in average mobility, both overall and broken down into high and low population density areas, and changes in the distribution of journey lengths.,  Results: We show that there was a substantial overall reduction in mobility, with the most rapid decline on the 24th March 2020, the day after the Prime Minister's announcement of an enforced lockdown. The reduction in mobility was highly synchronized across the UK. Although mobility has remained low since 26th March 2020, we detect a gradual increase since that time. We also show that the two different datasets produce similar trends, albeit with some location-specific differences. We see slightly larger reductions in average mobility in high-density areas than in low-density areas, with greater variation in mobility in the high-density areas: some high-density areas eliminated almost all mobility.,  Conclusions: These analyses form a baseline from which to observe changes in behaviour in the UK as social distancing is eased and inform policy towards the future control of SARS-CoV-2 in the UK.},
  pmcid = {PMC7479499},
  file = {C:\Users\wilso\Zotero\storage\SHIIISQA\Jeffrey et al. - 2020 - Anonymised and aggregated crowd level mobility dat.pdf}
}

