@article{Conklin2017,
  title = {Financial {{Literacy}}, {{Broker}}\textendash{{Borrower Interaction}} and {{Mortgage Default}}},
  author = {Conklin, James N.},
  date = {2017-04},
  journaltitle = {Real Estate Economics},
  volume = {45},
  number = {2},
  pages = {376--414},
  publisher = {{Wiley-Blackwell}},
  issn = {15406229},
  doi = {10.1111/1540-6229.12140},
  url = {http://doi.wiley.com/10.1111/1540-6229.12140 http://10.0.4.87/1540-6229.12140 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=122561925{&}site=bsi-live},
  abstract = {This article examines the relationship between broker\&\#8211;borrower interaction in the origination process and subsequent mortgage performance. I show that face\&\#8208;to\&\#8208;face interaction between a mortgage broker and borrower before the loan funds is associated with lower levels of ex postdefault. The relation between face\&\#8208;to\&\#8208;face broker\&\#8211;borrower interaction and mortgage performance holds only for borrowers that have characteristics associated with low levels of financial literacy. Specifically, face\&\#8208;to\&\#8208;face interaction is negatively related to default for minorities, borrowers located in areas with low levels of education, low\&\#8208;income borrowers and borrowers with low FICO scores. My results suggest that face\&\#8208;to\&\#8208;face interaction between the mortgage broker and borrower may reduce problems associated with financial illiteracy.},
  keywords = {\#nosource,Financial literacy,Housing finance,Housing market,Mortgage loans,Mortgages,Real estate agents}
}

