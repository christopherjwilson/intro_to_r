@article{bellImpactFinancialResources2014,
  title = {The {{Impact}} of {{Financial Resources}} on {{Soldiers}}' {{Well-Being}}},
  author = {Bell, Mary and Nelson, Jeffery and Spann, Scott and Molloy, Callie and Britt, Sonya and Goff, Briana},
  date = {2014-01},
  journaltitle = {Journal of Financial Counseling and Planning},
  volume = {25},
