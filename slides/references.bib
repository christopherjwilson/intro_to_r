@article{Schmidt2009,
  title = {Shall We {{Really}} Do It {{Again}}? {{The Powerful Concept}} of {{Replication}} Is {{Neglected}} in the {{Social Sciences}}},
  shorttitle = {Shall We {{Really}} Do It {{Again}}?},
  author = {Schmidt, Stefan},
  date = {2009-06},
  journaltitle = {Review of General Psychology},
  shortjournal = {Review of General Psychology},
  volume = {13},
  number = {2},
  pages = {90--100},
  issn = {1089-2680, 1939-1552},
  doi = {10.1037/a0015108},
  url = {http://journals.sagepub.com/doi/10.1037/a0015108},
  urldate = {2022-10-07},
  abstract = {Replication is one of the most important tools for the verification of facts within the empirical sciences. A detailed examination of the notion of replication reveals that there are many different meanings to this concept and the relevant procedures, but hardly any systematic literature. This paper analyzes the concept of replication from a theoretical point of view. It demonstrates that the theoretical demands are scarcely met in everyday work within the social sciences. Some demands are just not feasible, whereas others are constricted by restrictions relating to publication. A new classification scheme based on a functional approach that distinguishes between different types of replication is proposed. Next, it will be argued that replication addresses the important connection between existing and new knowledge. To do so it has to be applied explicitly and systematically. The paper ends with a description of procedures how this could be done and a set of recommendations how to handle the concept of replication in the future to exploit its potential to the full.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\McCracken, Yang_2006_The role of values in a contextual cognitive-behavioral approach to chronic pain(4).pdf}
}

@article{SchmidtEtAl2017,
  title = {Work First Then Play: {{Prior}} Task Difficulty Increases Motivation-Related Brain Responses in a Risk Game},
  shorttitle = {Work First Then Play},
  author = {Schmidt, Barbara and Mussel, Patrick and Osinsky, Roman and Rasch, Bj\"orn and Debener, Stefan and Hewig, Johannes},
  date = {2017-05-01},
  journaltitle = {Biological Psychology},
  shortjournal = {Biological Psychology},
  volume = {126},
  pages = {82--88},
  issn = {0301-0511},
  doi = {10.1016/j.biopsycho.2017.04.010},
  url = {http://www.sciencedirect.com/science/article/pii/S0301051117300765},
  urldate = {2019-03-01},
  abstract = {Task motivation depends on what we did before. A recent theory differentiates between tasks that we want to do and tasks that we have to do. After a have-to task, motivation shifts towards a want-to task. We measured this shift of motivation via brain responses to monetary feedback in a risk game that was used as want-to task in our study. We tested 20 healthy participants that were about 28 years old in a within-subjects design. Participants worked on a Stroop task (have-to task) or an easier version of the Stroop task as a control condition and played a risk game afterwards (want-to task). After the Stroop task, brain responses to monetary feedback in the risk game were larger compared to the easier control task, especially for feedback indicating higher monetary rewards. We conclude that higher amplitudes of feedback-related brain responses in the risk game reflect the shift of motivation after a have-to task towards a want-to task.},
  keywords = {\#nosource,Decision making,Depletion,FRN,Motivation,Self-control},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Schmidt et al. - 2017 - Work first then play Prior task difficulty increa.pdf;C\:\\Users\\wilso\\Zotero\\storage\\377YNST3\\S0301051117300765.html}
}

