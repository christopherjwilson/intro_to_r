@article{hseeAffectionEffectInsurance2000,
  title = {The {{Affection Effect}} in {{Insurance Decisions}}},
  author = {Hsee, Christopher K},
  date = {2000-03-01},
  journaltitle = {Journal of Risk and Uncertainty},
  shortjournal = {Journal of Risk and Uncertainty},
