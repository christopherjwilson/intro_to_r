@article{martinGameYearGambling2016,
  title = {Game {{On}}: {{Past Year Gambling}}, {{Gambling-Related Problems}}, and {{Fantasy Sports Gambling Among College Athletes}} and {{Non}}-Athletes},
  shorttitle = {Game {{On}}},
  author = {Martin, Ryan J. and Nelson, Sarah E. and Gallucci, Andrew R.},
  date = {2016-06-01},
  journaltitle = {Journal of Gambling Studies},
