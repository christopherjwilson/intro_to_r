@article{ParkSela2018,
  title = {Not {{My Type}}: {{Why Affective Decision Makers Are Reluctant}} to {{Make Financial Decisions}}.},
  author = {Park, Jane Jeongin and Sela, Aner},
  date = {2018-08},
  journaltitle = {Journal of Consumer Research},
  volume = {45},
  number = {2},
  pages = {298--319},
  publisher = {{Oxford University Press / USA}},
  issn = {00935301},
  url = {http://10.0.4.69/jcr/ucx122 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=130894889{&}site=bsi-live},
  abstract = {Why are people often uncomfortable dealing with financial decisions? We propose that people perceive financial decisions\textemdash more so than decisions in many other equally complex and important domains\textemdash as compatible with a cold, analytical mode of thinking and as highly incompatible with feelings and emotions. Consequently, the more people perceive themselves as inclined to rely on affect in their decisions, the more they experience self-concept incongruity with financial decisions (i.e., feeling that financial decisions are ``not them''), and consequently show an increased tendency to avoid such decisions. Five studies demonstrate this phenomenon, using both consequential and hypothetical decisions; provide evidence for the proposed mechanism; and rule out alternative accounts, including perceived financial knowledge, expertise and self-efficacy perceptions, decision confidence, and preference for numerical information. The findings contribute to research on thinking styles and decision avoidance, and they underscore a unique characteristic of financial decisions that makes them stand out among many other decision types. In addition to their theoretical significance, the findings have practical implications for the communication of financial products and services. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Affect (Psychology),affective and analytical thinking styles,decision avoidance,Decision making,financial decision making,Financial literacy,Personal finance,self-concept incongruity,Self-perception}
}

