  keywords = {10/20,dorsolateral prefrontal cortex,EEG,EEG electrode placement,Neurology},
  file = {/home/chris/Zotero/storage/R75S8NLR/Pàmies-Vilà et al. - 2023 - Analysis of the Dorsolateral Prefrontal Cortex MNI Coordinates.pdf}
