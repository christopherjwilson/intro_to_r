@article{diaconFramingEffectsRisk2007,
  title = {Framing Effects and Risk Perception: {{The}} Effect of Prior Performance Presentation Format on Investment Fund Choice},
  shorttitle = {Framing Effects and Risk Perception},
  author = {Diacon, Stephen and Hasseldine, John},
