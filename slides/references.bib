@article{degrootNonclinicalAutisticTraits2020,
  title = {Non-Clinical Autistic Traits Correlate with Social and Ethical but Not with Financial and Recreational Risk-Taking},
  author = {De Groot, Kristel},
  date = {2020-03-11},
  journaltitle = {Frontiers in Psychology},
  shortjournal = {Frontiers in Psychology},
  volume = {11},
  publisher = {Frontiers Media S.A.},
  issn = {1664-1078},
  doi = {10.3389/fpsyg.2020.00360},
  abstract = {Previous research into uncertain and risky decision-making in autism spectrum disorder (ASD) has been inconclusive, with some studies reporting less uncertain and risky decisions by persons with ASD compared to neurotypicals, but other studies failing to find such effects. A possible explanation for these inconsistent findings is that aberrant decision-making in ASD is domain-specific, and only manifests itself in domains related to autism symptomatology. The present study examines this premise by correlating self-reported autistic traits to individuals’ intention to engage in risky behaviours, their perception of how risky these behaviours are, and the amount of benefit they expect to obtain from engaging in them; all for five separate domains of decision-making: social, ethical, recreational, health/safety, and financial. In line with the hypotheses, persons with higher autistic traits reported reduced intention to engage in risky social behaviours and increased intention to engage in risky ethical behaviours. Furthermore, a positive correlation was found between autistic traits and risk perception in the social domain, indicating that persons with higher autistic traits perceive social behaviours as riskier than do persons with lower autistic traits. Correlations between autistic traits and individuals’ intention to engage in risky recreational and financial behaviours were small, and supported the null hypothesis (as shown by Bayes Factors). Given that most studies on uncertain and risky decision-making take place in a financial context, the present results could explain previous inconsistent findings on decision-making in ASD. Therefore, future studies should also examine decision-making outside the financial realm. (PsycInfo Database Record (c) 2022 APA, all rights reserved)},
  keywords = {autism spectrum disorder,Autism Spectrum Disorders,Autism-Spectrum Quotient,Autistic Traits,decision making,Decision Making,Domain-Specific Risk-Taking scale,Ethics,Intention,Personal Finance,Risk Perception,risk taking,Risk Taking,Social Behavior,Symptoms,uncertainty},
  file = {/home/chris/Zotero/storage/FR3T8Q2B/De Groot_2020_Non-clinical autistic traits correlate with social and ethical but not with.pdf;/home/chris/Zotero/storage/URZ2PNXI/De Groot_2020_Non-clinical autistic traits correlate with social and ethical but not with.pdf}
}

