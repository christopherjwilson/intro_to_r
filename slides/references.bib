@article{Jackson-smithEtAl2003,
  title = {The {{Contribution}} of {{Financial Management Training}} and {{Financial Performance}}},
  author = {Jackson-smith, Douglas and Trechter, David and Splett, Nate},
  date = {2003},
  journaltitle = {Review of Agricultural Economics},
  volume = {26},
  number = {1},
  pages = {132--147},
  publisher = {{Oxford University Press / USA}},
  issn = {10587195},
  doi = {10.1111/j.1467-9353.2003.00166.x},
  url = {http://10.0.4.87/j.1467-9353.2003.00166.x http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=12228521{&}site=ehost-live},
  abstract = {Cooperative Extension and other institutions (e.g., technical colleges, on-line self study programs, university short courses, etc.) frequently stress the importance of financial management education for successful farming operations. The research reported in this paper attempts to quantify the contributions of such training to the financial performance of dairy farms in Wisconsin. Our results suggest a link between a deeper understanding of financial concepts and greater financial returns but that it is a relatively weak one. Moreover, simple exposure to farm management training programs and self-confidence in farm financial decision-making ability are not significantly related to farm financial outcomes. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Agricultural education,Agricultural productivity,Cooperative agriculture,Dairy farms,Decision making,Financial management,Financial performance,United States,Wisconsin}
}

