@article{KhenferEtAl2017,
  title = {Interventionist External Agents Make Specific Advice Less Demotivating},
  author = {Khenfer, Jamel and Laurin, Kristin and Tafani, Eric and Roux, Elyette and Kay, Aaron C.},
  date = {2017-11-01},
  journaltitle = {Journal of Experimental Social Psychology},
  shortjournal = {Journal of Experimental Social Psychology},
  volume = {73},
  pages = {189--196},
  issn = {0022-1031},
  doi = {10.1016/j.jesp.2017.07.003},
  url = {http://www.sciencedirect.com/science/article/pii/S0022103116307491},
  urldate = {2019-09-19},
  abstract = {Across four experiments, we explored how reminders of powerful external agents\textemdash interventionist Gods and reliable corporate institutions\textemdash influence people's motivation in the realm of financial goals. We found evidence that when people receive specific financial advice, they feel demotivated by the overwhelming flow of concrete instructions for achieving success. We found further that, under these circumstances specifically, reminders of interventionist agents bolster motivation, but that these same agents under different circumstances (i.e., when people receive vague advice) instead undermine motivation. Our findings shed light on the effects of specific (versus vague) goal focus, and on the dynamics of compensatory control in consumer settings.},
  keywords = {{Advice, external agency},Banks,Control,Motivation,Religion,Savings goal},
  file = {C\:\\Users\\Owner\\Dropbox\\Papers\\Khenfer et al_2017_Interventionist external agents make specific advice less demotivating.pdf;C\:\\Users\\wilso\\Zotero\\storage\\GWIBMJFH\\S0022103116307491.html}
}

