  title = {Improvements in Self-Control from Financial Monitoring},
  author = {Oaten, Megan and Cheng, Ken},
  date = {2007-08-01},
  journaltitle = {Journal of Economic Psychology},
  shortjournal = {Journal of Economic Psychology},
  volume = {28},
  number = {4},
  pages = {487--501},
  issn = {0167-4870},
  doi = {10.1016/j.joep.2006.11.003},
  url = {http://www.sciencedirect.com/science/article/pii/S0167487006001012},
  urldate = {2019-10-03},
  abstract = {We tested whether the repeated practice of self-control could improve regulatory strength over time. Regulatory performance was assessed at baseline, then at monthly intervals for a period of four months using a visual tracking task. Perceived stress, emotional distress and self-efficacy were assessed by questionnaire. Participants entered a four-month self-control exercise drill designed to increase regulatory strength: a financial monitoring program. Participants showed significant improvement in self-regulatory capacity as measured by an enhanced performance on the visual tracking task following a thought-suppression task. Perceived stress, emotional distress and self-efficacy remained stable. A control group not participating in any self-control exercise showed no signs of improvement over the same time span.},
  keywords = {Depletion,Saving,Self-control,Self-regulation,Spending},
  file = {C\:\\Users\\Owner\\Dropbox\\Papers\\Oaten_Cheng_2007_Improvements in self-control from financial monitoring.pdf;C\:\\Users\\wilso\\Zotero\\storage\\Q3YRGB5Q\\S0167487006001012.html}
}

