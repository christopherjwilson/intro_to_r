  url = {https://www.semanticscholar.org/paper/c775ce088003a0b9de5e2e52cd638372979499be},
  abstract = {S2 TL;DR: This study represents one of the first attempts to assess gambling-related harm through a public health perspective and the results are informative for policy-making, resource allocation, and service planning.}
