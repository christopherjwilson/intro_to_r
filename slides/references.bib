@article{KaplanDamphousse1997,
  title = {Reciprocal Relationships between Life Events and Psychological Distress},
  author = {Kaplan, Howard B. and Damphousse, Kelly R.},
  date = {1997-04},
  journaltitle = {Stress Medicine},
  volume = {13},
  number = {2},
  pages = {75--90},
  publisher = {{John Wiley \& Sons}},
  issn = {07488386},
  doi = {10.1002/(SICI)1099-1700(199704)13:2<75::AID-SMI717>3.0.CO;2-L},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=1997-06336-001{&}site=ehost-live},
  abstract = {Longitudinally explored the relationship between psychological distress and life events. 4,397 Ss were tested in the 7th grade (T1) and as young adults (T4), and the LISREL 8 program was used to estimate a structural model with latent variables. Life events in the aggregate mediated and partially decomposed the relationship between psychological distress during adolescence and young adulthood. T1 psychological distress had significant positive effects on getting fired, getting married, having a child, having someone in the household become seriously ill, becoming pregnant outside of marriage, getting a divorce, moving out of the parents' home, having an abortion and getting arrested, and had significant negative effects on graduating from junior high, starting and graduating from high school, starting college, starting a job, getting promoted and borrowing money. The following life events had significant positive effects on T4 psychological distress: having someone in the household become seriously ill, getting fired, starting high school and divorce. The following life events had significant negative effects on T4 psychological distress: graduating junior high school, graduating from high school, starting college, getting promoted, receiving more income and borrowing money. (PsycINFO Database Record (c) 2015 APA, all rights reserved)},
  keywords = {\#nosource,Life events,Mediating processes,Psychological distress,Stressors}
}

