  author = {Liu, Yichuan and Piazza, Elise A. and Simony, Erez and Shewokis, Patricia A. and Onaral, Banu and Hasson, Uri and Ayaz, Hasan},
  date = {2017-02-27},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
