@article{MacManus1992,
  title = {Government Contracting and Procurement: {{A}} Critical Process for Both the Public and Private Sectors},
  author = {MacManus, Susan A.},
  date = {1992-08},
  journaltitle = {International Journal of Public Administration},
  volume = {15},
  number = {5},
  pages = {1213--1240},
  issn = {15324265},
  doi = {10.1080/01900699208524756},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=12143405{&}site=ehost-live},
  abstract = {The costs and benefits of government purchases of goods and services from businesses are examined from the perspective of both public and private sector officials. Generally, governments see more benefits than costs, often because of fiscal stress. Businesses, especially newer, smaller firms, are more likely to see more costs than benefits. Changes projected to occur in public procurement systems by the year 2000 include: 1. expansion of current vendor pools, 2. adoption of standardized forms and procedures for getting and staying on government vendor lists, 3. the mainstreaming of purchasing into the government financial management system, 4. more rigorous training requirements for government purchasing personnel, 5. increased use of public-private task forces to reform procurement policies and practices, 6. increased efforts to include quality dimensions in cost estimates, and 7. increased tension and litigation over protectionism in public procurement.},
  keywords = {\#nosource,ADMINISTRATION AND ECONOMY,Contracting and Procurement,Free trade,Government purchasing,Government spending policy,Industrial procurement,Public administration,Public spending}
}

