  url = {http://10.0.3.248/j.irfa.2011.05.002 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=67625855{&}site=ehost-live},
  abstract = {Purpose \textendash{} The purpose of this paper is to investigate the relevance of credit supply for corporate capital structure decisions of manufacturing firms in Pakistan. Design/methodology/approach \textendash{} The implicit assumption in much of the work on capital structure is that for a firm, the availability of incremental capital depends solely on its characteristics. However, the capital market frictions suggest that suppliers of credit may also affect firms' ability to borrow. The authors investigated this intuition by employing dynamic panel data estimators using 8,984 firm-year observations for the period 1990-2010. Findings \textendash{} The results show that short-term debt is a major source of financing in these firms. Further, credit supply plays a significant role in these firms' capital structure decisions and hence, they increase their short-term debt (main financing source) with an increase in credit supply in the market while payoff their long-term debt with internal funds. Practical implications \textendash{} The findings of thi...},
  keywords = {\#nosource,Business cycles,Business enterprises,Capital structure,Credit,Credit rationing,Decision making,Financing,Japan,Market volatility,Pecking order hypothesis,Recessions,Trade-off theory}
