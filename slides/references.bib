@article{MichaelCollinsOdders-White2015,
  title = {A {{Framework}} for {{Developing}} and {{Testing Financial Capability Education Programs Targeted}} to {{Elementary Schools}}.},
  author = {Michael Collins, J and Odders-White, Elizabeth},
  date = {2015-01},
  journaltitle = {Journal of Economic Education},
  volume = {46},
  number = {1},
  pages = {105--120},
  publisher = {{Taylor \& Francis Ltd}},
  issn = {00220485},
  url = {http://10.0.4.56/00220485.2014.976325 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=100826278{&}site=bsi-live},
  abstract = {Concerns about consumers' ability to manage their finances have triggered a range of proposals, including interventions aimed at elementary school students. The goal of these approaches is to improve lifelong economic decision making, but the evidence supporting their efficacy is thin. In this article, the authors discuss the trend toward elementary financial education and propose a framework for developing evidence-based programs. They emphasize the need for understanding the underlying mechanisms that facilitate the translation of student knowledge into the ability to make sound economic decisions over the life course. The framework illustrates the importance of articulating the intended mechanisms and effects of education programs. This focus on mechanisms will not only facilitate the evaluation of individual programs, but also the synthesis of evidence across interventions. [ABSTRACT FROM PUBLISHER]},
  keywords = {\#nosource,A21,D14,Economics education in elementary schools,Educational programs,elementary education,Evidence-based education,Finance education (Early childhood),financial capability,financial education,Financial literacy,I21,program evaluation}
}

@article{MichaelCollinsUrban2014,
  title = {The {{Dark Side}} of {{Sunshine}}: {{Regulatory Oversight}} and {{Status Quo Bias}}},
  shorttitle = {The {{Dark Side}} of {{Sunshine}}},
  author = {Michael Collins, J. and Urban, Carly},
  date = {2014-11},
  journaltitle = {Journal of Economic Behavior \& Organization},
  series = {Empirical {{Behavioral Finance}}},
  volume = {107},
  pages = {470--486},
  issn = {0167-2681},
  doi = {10.1016/j.jebo.2014.04.003},
  abstract = {As the mortgage foreclosure crisis accelerated in the U.S. in the late 2000s, state-level policymakers implemented measures designed to protect consumers and stem the tide of foreclosures. One form of policy was simply to require lenders to report on foreclosure prevention activities. Such policies represented a shift from the status quo for mortgage loan servicing firms operating under incomplete information\textemdash doing nothing with non-paying loans while waiting for more information to be revealed\textemdash to either foreclosing on the borrower or offering the borrower a modification of loan terms. Using a difference-in-difference-in-differences empirical strategy, we exploit one policy implemented in Maryland for a subset of mortgage servicers and find evidence that firms perform more loan modifications, as well as file more foreclosures. Increasing foreclosure filings was contrary to the intent of the policy, suggesting that policymakers should be aware of how firms exhibit systematic biases, much like individuals.},
  keywords = {\#nosource,Loss aversion,Mortgage foreclosure,Status quo bias}
}

@article{MicheliManzoni2010,
  title = {Strategic {{Performance Measurement}}: {{Benefits}}, {{Limitations}} and {{Paradoxes}}},
  shorttitle = {Strategic {{Performance Measurement}}},
  author = {Micheli, Pietro and Manzoni, Jean-Francois},
  date = {2010-08},
  journaltitle = {Long Range Planning},
  series = {Strategic {{Performance Measurement}}},
  volume = {43},
  number = {4},
  pages = {465--476},
  issn = {0024-6301},
  doi = {10.1016/j.lrp.2009.12.004},
  abstract = {Strategic Performance Measurement (SPM) can be both functional and dysfunctional for organisations. SPM can help organisations define and achieve their strategic objectives, align behaviours and attitudes and, ultimately, have a positive impact on organisational performance. However, SPM has also been criticised for several reasons, such as encouraging perverse behaviours, stifling innovation and learning, and having little effect on decision-making processes. If both perspectives are valid, how can organisations make SPM more of an asset and less of a liability? In this article, we argue that the design of an SPM system (SPMS) and the definition of its roles are fundamental factors determining its success and impact on business performance. Indeed, only by carefully considering characteristics and roles will managers reap the full benefits, and SPMSs make a substantial contribution to the achievement of organisations' strategic goals. Building on the papers selected for this Special Issue, we draw conclusions that are relevant for both the theory and the practice of SPM. First, the benefits and limits of SPM depend on the very definition of what SPM should be, and on whether the measurement of performance is linked to both formulation and implementation of strategy. Secondly, the types of behaviour promoted by the SPMS are determined primarily by the uses of the~system, particularly whether it is adopted for control or learning purposes. Thirdly, organisations should regard their SPMS as a means of fostering alignment to an existing strategy, but also of supporting empowerment and the continuous adaptation of strategy and tactics. Finally, in order for SPM to support decision-making processes and positively impact on organisational performance, targets and indicators have to be linked to strategy and considered in strategic reviews. Following an introductory section on the theme of SPM, we examine the benefits, limits and paradoxes of SPM. We conclude by arguing for intelligent and purposeful designs of performance measurement systems, and for research that breaks the barriers of academic silos and puts an end to sterile contrapositions between advocates and critics of SPM.},
  keywords = {\#nosource}
}

