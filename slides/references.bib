@article{baumeisterFreeWillConsumer2008,
  title = {Free Will in Consumer Behavior: {{Self}}-Control, Ego Depletion, and Choice},
  shorttitle = {Free Will in Consumer Behavior},
  author = {Baumeister, Roy F. and Sparks, Erin A. and Stillman, Tyler F. and Vohs, Kathleen D.},
  date = {2008},
  journaltitle = {Journal of Consumer Psychology},
  volume = {18},
  number = {1},
  pages = {4--13},
  issn = {1532-7663},
  doi = {10.1016/j.jcps.2007.10.002},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1016/j.jcps.2007.10.002},
  urldate = {2019-10-03},
  abstract = {Consumer behavior offers a useful window on human nature, through which many distinctively human patterns of cognition and behavior can be observed. Consumer behavior should therefore be of central interest to a broad range of psychologists. These patterns include much of what is commonly understood as free will. Our approach to understanding free will sidesteps metaphysical and theological debates. Belief in free will is pervasive in human social life and contributes to its benefits. Evolution endowed humans with a new form of action control, which is what people understand by free will. Its complexity and flexibility are suited to the distinctively human forms of social life in culture, with its abstract rules, expanded time span, diverse interdependent roles, and other sources of opportunities and constraints. Self-control, planful action, and rational choice are vital forms of free will in this sense. The capacity for self-control and intelligent decision making involves a common, limited resource that uses the body's basic energy supply. When this resource is depleted, self-control fails and decision making is impaired.},
  langid = {english},
  file = {/home/chris/Zotero/storage/AS2R7PER/Baumeister et al. - 2008 - Free will in consumer behavior Self-control, ego depletion, and choice.pdf;/home/chris/Zotero/storage/JQQ2E529/j.jcps.2007.10.html}
}

