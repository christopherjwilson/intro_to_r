  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=1992-19586-001{&}site=ehost-live},
  abstract = {Two studies with 109 Ss (aged 18-79 yrs) examined the problem of personal debt in the UK. Study 1 examined the lay classification of debt causes, and Study 2 investigated a perceived causal structure for personal debt. A number of personal factors emerged that concerned financial management, self-control, life-events, greed, and pleasure. Societal pressures included persuasive commercial pressures, workings of the credit system, external crises, and bad luck. A causal network was developed that operates as a series of knock-on effects. The system appears to gather momentum as it moves from distal to proximal causes, starting with advertising pressures, the expansion of credit, and social pressures, and ending in a person with no savings, under stress, with a fluctuating income, who uses careless budgeting. (PsycINFO Database Record (c) 2012 APA, all rights reserved).},
  keywords = {\#nosource,18\textendash 79 yr olds,Attribution,Costs and Cost Analysis,Financial Strain,lay classification \{\textbackslash\&\} perceived causal structure of,UK}
}

