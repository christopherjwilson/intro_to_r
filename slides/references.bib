@article{LoBueMatthews2014,
  title = {The Snake in the Grass Revisited: {{An}} Experimental Comparison of Threat Detection Paradigms},
  shorttitle = {The Snake in the Grass Revisited},
  author = {LoBue, Vanessa and Matthews, Kaleigh},
  date = {2014-01-02},
  journaltitle = {Cognition and Emotion},
