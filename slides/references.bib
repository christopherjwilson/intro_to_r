@article{KrieglmeyerDeutsch2010,
  title = {Comparing Measures of Approach\textendash Avoidance Behaviour: {{The}} Manikin Task vs. Two Versions of the Joystick Task},
  shorttitle = {Comparing Measures of Approach\textendash Avoidance Behaviour},
  author = {Krieglmeyer, Regina and Deutsch, Roland},
  date = {2010-08-01},
  journaltitle = {Cognition and Emotion},
  volume = {24},
  number = {5},
  pages = {810--828},
  issn = {0269-9931},
  doi = {10.1080/02699930903047298},
  url = {https://doi.org/10.1080/02699930903047298},
  urldate = {2019-02-28},
  abstract = {The present research compared three measures of approach\textendash avoidance behaviour with respect to their sensitivity and criterion-validity: moving a manikin on the screen towards and away from stimuli (manikin task), pulling and pushing a joystick (joystick task), and pulling and pushing a joystick causing the visual impression that the stimuli come closer or disappear (feedback-joystick task). When participants responded to stimulus valence, the manikin task was more sensitive to valence than the joystick task (Experiment 1). When participants responded to the grammatical category of valent words, the manikin and the feedback-joystick but not the joystick task were sensitive to valence (Experiment 2). Finally, the manikin task was more sensitive than the feedback-joystick task in assessing approach\textendash avoidance reactions towards spiders, and it was more strongly related to self-reported fear of spiders (Experiment 3). The likelihood of recategorisation of approach\textendash avoidance responses and the means of distance change are discussed as possible explanations for the differences.},
  keywords = {Approach-avoidance,Fear of spiders,Implicit measures,Unintentional evaluation},
  file = {C\:\\Users\\wilso\\Zotero\\storage\\DIQVIM74\\Krieglmeyer and Deutsch - 2010 - Comparing measures of approach–avoidance behaviour.pdf;C\:\\Users\\wilso\\Zotero\\storage\\5CGTG25A\\02699930903047298.html}
}

