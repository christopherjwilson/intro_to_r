  shorttitle = {Affective Life and Cultural Economy},
  author = {Anderson, Ben and Langley, Paul and Ash, James and Gordon, Rachel},
  date = {2020-06},
  journaltitle = {Transactions of the Institute of British Geographers},
  shortjournal = {Trans Inst Br Geogr},
  volume = {45},
  number = {2},
