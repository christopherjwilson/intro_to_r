@online{Onishi2021,
  title = {Economical {{Visual Attention Test}} for {{Elderly Drivers}}},
  author = {Onishi, Akinari},
  date = {2021-09-09},
  eprint = {2008.04723},
  eprinttype = {arxiv},
  eprintclass = {cs},
  url = {http://arxiv.org/abs/2008.04723},
  urldate = {2023-01-30},
  abstract = {Traffic accidents involving elderly drivers are an issue in a super-aging society. A quick and low-cost aptitude test is required to reduce the number of traffic accidents. This study proposed an oddball-serial visual search task that assesses the individual's performance by his or her responses to the presence of cued stimuli on the screen. Task difficulty varied by changing the number of simultaneous stimuli; Accordingly, low performers were detected. In addition, performance correlated with age. This implies that individual characteristics related to driving performance that decline with age can be detected by the proposed task. Since the task requires low-cost devices (computer and response button), it is feasible for use as a quick and low-cost aptitude test for elderly drivers.},
  pubstate = {preprint},
  keywords = {Computer Science - Human-Computer Interaction},
  file = {C\:\\Users\\wilso\\Zotero\\storage\\8WDRKBWQ\\Onishi - 2021 - Economical Visual Attention Test for Elderly Drive.pdf;C\:\\Users\\wilso\\Zotero\\storage\\9S2QJSJI\\Onishi - 2021 - Economical Visual Attention Test for Elderly Drive.html}
}

