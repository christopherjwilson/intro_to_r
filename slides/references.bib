@thesis{eitelFirstgenerationFemaleCollege2001,
  title = {First-Generation Female College Students' Financial Literacy: {{Barriers}} to Persistence and Degree Completion},
  booktitle = {Centre for {{Earth Observation Science}}},
  author = {Eitel, Susan J},
  date = {2001},
  volume = {68},
  number = {9-A},
  institution = {ProQuest Information \& Learning},
  url = {http://journals.cambridge.org/abstract{_}S0165115300023299},
  abstract = {The purpose of this two-phase, sequential, mixed methods research was to: (a) identify the financial literacy needs of first-generation female college students (FGFCS) and any related demographic and behavioral characteristics; (b) explore the differences in perceived and actual financial literacy needs of FGFCS; (c) examine the FGFCS's perception of barriers to and support of persistence and degree completion; and (d) develop an understanding of how financial knowledge, skills, and behaviors enhance or inhibit persistence and degree completion. Constructs of human and social capital informed the exploration of the financial literacy of FGFCS. Also examined, were the influence of efficacy in financial resource management and choice and decision-making processes to determine their potential to create barriers to persistence and degree completion. Quantitative analysis was used to explore the human capital of financial literacy using the 2006 Jump\$tart survey along with demographic and behavioral questions. A purposive sample of 204 undergraduate FGFCS completed the online survey. Focus groups to probe facets of financial literacy and potential barriers to persistence and degree completion informed the qualitative investigation. A total of 39 participants contributed to 1 of 4 focus groups. According to the results of the Jump\$tart survey, the FGFCS of this study were not financially literate. Adding the data analysis from the qualitative investigation it was apparent that some of the components in the lack of human capital stemmed from a lack of social capital extending from the family. However, many participants perceived issues related to other variables as more important than their inability to effectively manage the scarce resources on which they were dependent. Participants provided rich description for issues related to emotional and social support from their families; difficulty in navigating the processes of the university, including aspects of financial aid and academic advising, and constraints of money which resulted in compromise of career goals and the necessity of employment. However, the participants of this study provided insight to their veracious tenacity through sharing strategies that focused on organization and discipline that coupled with determination and perseverance increased their ability to persist and complete their undergraduate degrees.},
  isbn = {9780494535639},
  pagetotal = {386},
  keywords = {barriers,behavioral characteristics,College Students,degree completion,demographic characteristics,Demographic Characteristics,Educational Degrees,Finance,financial literacy,Financial Literacy,first-generation female college students,Literacy,nosource}
}

@article{ekanemInfluencesBehaviourBlack2013,
  title = {Influences on the Behaviour of Black and Minority Ethnic ({{BME}}) Communities towards Debt and Bankruptcy.},
