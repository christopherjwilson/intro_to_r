@article{AllcoatMuhlenen2018,
  title = {Learning in Virtual Reality: {{Effects}} on Performance, Emotion and Engagement},
  shorttitle = {Learning in Virtual Reality},
  author = {Allcoat, Devon and family=M\"uhlenen, given=Adrian, prefix=von, useprefix=false},
