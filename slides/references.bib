  author = {Beauchaine, Theodore P. and Ben-David, Itzhak and Sela, Aner},
  date = {2017-05},
  journaltitle = {PLoS ONE},
  volume = {12},
  number = {5},
  publisher = {Public Library of Science},
  location = {Beauchaine, Theodore P.},
  issn = {19326203},
  doi = {10.1371/journal.pone.0176933},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2017-27939-001{&}site=ehost-live http://beauchaine.1@osu.edu},
  abstract = {Delay discounting-often referred to as hyperbolic discounting in the financial literature-is defined by a consistent preference for smaller, immediate rewards over larger, delayed rewards, and by failure of future consequences to curtail current consummatory behaviors. Previous research demonstrates (1) excessive delay discounting among individuals with attention-deficit/hyperactivity disorder (ADHD), (2) common neural substrates of delay discounting and hyperactive-impulsive symptoms of ADHD, and (3) associations between delay discounting and both debt burden and high interest rate borrowing. This study extends prior research by examining associations between ADHD symptoms, delay discounting, and an array of previously unevaluated financial outcomes among 544 individuals (mean age 35 years). Controlling for age, income, sex, education, and substance use, ADHD symptoms were associated with delay discounting, late credit card payments, credit card balances, use of pawn services, personal debt, and employment histories (less time spent at more jobs). Consistent with neural models of reward processing and associative learning, more of these relations were attributable to hyperactive-impulsive symptoms than inattentive symptoms. Implications for financial decision-making and directions for future research are discussed.},
  keywords = {Adult,Attention Deficit Disorder with Hyperactivity,attention-deficit/hyperactivity disorder,Behavior,delay discounting,Delay Discounting,Female,Finance,Financing,Financing Personal,Humans,Male,nosource,Personal,Risk Factors,risky financial behavior,self-report,Self-Report},
  file = {/home/chris/Zotero/storage/PES6PD3B/Beauchaine et al_2017_Attention-deficit-hyperactivity disorder, delay discounting, and risky.pdf}
}

