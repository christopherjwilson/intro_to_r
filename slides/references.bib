@article{GalleryEtAl2011c,
  title = {Framework for {{Assessing Financial Literacy}} and {{Superannuation Investment Choice Decisions}}.},
  author = {Gallery, Natalie and Newton, Cameron and Palm, Chrisann},
  date = {2011-07},
  journaltitle = {Australasian Accounting Business \& Finance Journal},
  volume = {5},
  number = {2},
  pages = {3--22},
  publisher = {{Australasian Accounting Business \& Finance Journal}},
  issn = {18342000},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=61481000{&}site=bsi-live},
  abstract = {There is a worldwide trend towards rapidly growing defined contribution pension funds in terms of assets and membership, and the choices available to individuals. This has shifted the decision-making responsibility to fund members for managing the investment of their retirement savings. This change has given rise to a phenomenon where most superannuation fund members are responsible for either actively choosing or passively relying on their funds' default investment options. Prior research identifies that deficiencies in financial literacy is one of the causes of inertia in financial decision-making and findings from international and Australian studies show that financial illiteracy is wide-spread. Given the potential significant economic and social consequences of poor financial decision-making in superannuation matters, this paper proposes a framework by which the various demographic, social and contextual factors that influence fund members' financial literacy and its association with investment choice decisions are explored. Enhanced theoretical and empirical understanding of the factors that are associated with active/passive investment choice decisions would enable development of well-targeted financial education programs. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Australia,Financial literacy,Investment analysis,Investment choice,Pension trust management,Retirement planning,Saving \{\textbackslash\textbackslash\textbackslash\&\} investment -- Social aspects,Saving \{\textbackslash\&\} investment -- Social aspects,Superannuation}
}

@article{GalloEtAl2018,
  title = {Individual Heterogeneity and Pension Choices: {{Evidence}} from {{Italy}}.},
  author = {Gallo, Giovanni and Torricelli, Costanza and family=Soest, given=Arthur, prefix=van, useprefix=true},
  date = {2018-04},
  journaltitle = {Journal of Economic Behavior \& Organization},
  volume = {148},
  pages = {260--281},
  issn = {01672681},
  url = {http://10.0.3.248/j.jebo.2018.02.016 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=129206461{&}site=bsi-live},
  abstract = {The 2007 Italian pension reform allowed transferring future severance pay contributions into a pension fund. Although this was accompanied by an information campaign advising employees to make the transfer, only a minority of them did so. We analyze the heterogeneity in employees' choices using micro panel data from the Bank of Italy household survey. Two are the main findings. First, the decision to transfer and pension fund participation after the reform are more likely for more (financially) educated and older individuals, with high household income and wealth, and less likely for female employees, in the South, and in small firms. Second, framing the analysis within the Elaboration Likelihood Model highlights that the cognitive processes underlying the decision on pension fund participation may be quite different. The decision consciousness is lower for employees working in small firms, where employers have an incentive to stimulate workers to deny the transfer. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,A12,C25,Cognitive skills,Consciousness,D03,D14,Decision making in economics,Elaboration likelihood model,Financial literacy,Labor incentives,Pension savings,Pension trusts,Severance pay,Women employees}
}

