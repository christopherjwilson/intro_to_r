  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2011-29809-012{&}site=ehost-live http://mohnishi@nagasaki-u.ac.jp},
  abstract = {Japan has a relatively high prevalence rate of death due to suicide, with more than 30 000 suicides every year since 1998. According to Nagasaki prefecture health office, in the last decade, there has been a high prevalence of suicide among middle-aged men, with debt and/or losing one's job being listed as one of the major causes. The authors conducted this study to determine to what extent bars and izakaya pubs can contribute to mitigating stress among middle-aged Japanese men by providing a place for them to de-stress. self-administered questionnaire was posted to masters of a total of 260 bars and izakaya pubs registered in Ohmura-city, Nagasaki prefecture, in December 2009. Regardless of respondent sex and age, those respondents with longer working histories in bars and izakaya pubs had a higher likelihood of experience of customers consulting them about debts/loans Having a place to complain and to receive counseling could potentially mitigate stress in critical situations. Bars and izakaya pubs with masters with more years of experience may function as one possible avenue of stress mitigation by providing such a place where middle-aged men could consult on various issues such as debts/loans, and thereby potentially play the role of gate-keeper to prevent suicide. (PsycINFO Database Record (c) 2012 APA, all rights reserved)},
  keywords = {Adult,bars,death,Hospitality Industry,Human Males,Humans,izakaya pubs,Japan,Male,mental health,Mental Health,Middle Aged,middle aged Japanese men,Mortality Rate,nosource,Psychological,Restaurants,Social Support,Stress,suicide,Suicide},
