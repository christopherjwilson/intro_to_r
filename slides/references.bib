@article{edsonLargescaleProspectiveStudy2023,
  title = {A Large-Scale Prospective Study of Big Wins and Their Relationship with Future Involvement and Risk among Actual Online Sports Bettors.},
  author = {Edson, Timothy C. and Louderback, Eric R. and Tom, Matthew A. and Philander, Kahlil S. and Slabczynski, John M. and Lee, Taylor G. and LaPlante, Debi A.},
  date = {2023-05-01},
  journaltitle = {Computers in Human Behavior},
  shortjournal = {Computers in Human Behavior},
  volume = {142},
  pages = {N.PAG-N.PAG},
  publisher = {Pergamon Press - An Imprint of Elsevier Science},
  issn = {0747-5632},
  doi = {10.1016/j.chb.2023.107657},
  url = {https://research.ebsco.com/linkprocessor/plink?id=89b98f69-1010-3e50-97c7-1dc9969efc3d},
  abstract = {Clinicians have proposed that big wins early in a gambler's betting experience can lead to increased involvement, and eventually problematic gambling. Understanding how this effect manifests in online sports betting is important, as this form of gambling has grown increasingly popular worldwide and continues to expand. Using matched pair analysis and other methods (e.g., survival analysis, fixed effects regression), we examined big wins' ability to predict future gambling involvement and behavior using bet level data from 36,328 sports gamblers who subscribed to a large, European online gambling operator. Big wins were defined two ways. Big wins in sports betting were associated with increased engagement, losses, and risk in the following weeks, with the impact declining over time. The exact timing of when a big win occurs after subscribing does not appear to have a major effect on subsequent behaviors. These findings held for both definitions of big wins. This study supports the existence of a big win effect in online sports betting, but more research is needed to determine whether there is an "early" big win effect, and whether big wins are indeed associated with problematic gambling. • Clinicians suggest that subjectively large gambling wins ("big wins") can lead to excessive gambling involvement. • This study represents the first longitudinal assessment of the big win effect using online sports gambling records. • Big wins were associated with subsequently increased engagement, losses, and risk, however this effect declines over time. • Sensitivity analyses showed that our main findings on big win effects were robust. • Operators should alert gamblers about the importance of using responsible gambling strategies after a big win..},
  langid = {english},
  keywords = {Gambling,Human,Internet Addiction Risk Factors,Prospective Studies}
}

