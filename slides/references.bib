@article{manciniPredictingProblemGambling2025,
  title = {Predicting {{Problem Gambling}} in {{Young Men}}: {{The Impact}} of {{Sports Gambling Frequency}} and {{Internalizing Symptoms}}},
  shorttitle = {Predicting {{Problem Gambling}} in {{Young Men}}},
  author = {Mancini, Vincent O. and Brett, Jack D. and Heirene, Robert M. and Fisher, Krista and Nevill, Thom P. and Mitrou, Francis},
  date = {2025-06-11},
  journaltitle = {Journal of Gambling Studies},
  shortjournal = {J Gambl Stud},
  publisher = {Human Sciences Press, Inc},
  location = {United States},
  issn = {1573-3602},
  doi = {10.1007/s10899-025-10403-0},
  url = {https://doi.org/10.1007/s10899-025-10403-0},
  urldate = {2025-07-03},
  abstract = {Young men aged 18–25~years are at disproportionately increased risk for gambling problems compared to their older or female counterparts. The unique mechanisms that precipitate these problems in this group remain unclear. Data from the largest longitudinal cohort study on Australian men’s health (the Ten to Men Study) were used to identify the psychosocial, health-related, and gambling-related behavioral predictors of problem gambling severity in 265 young men aged 18–25~years. Hierarchical multiple ordinal logistic regression analyses found these predictors to explain a moderate proportion of variance in problem gambling severity. Four of the 17 predictors included accounted for unique variance. Specifically, higher levels of problem gambling severity were explained by lower levels of anxiety, higher levels of depression, and a higher frequency of prior engagement in sports gambling and fantasy sports gambling. Other psychosocial factors (e.g., masculine norm adherence), health-related behaviors (e.g., problem alcohol use), and gambling-related behaviors (e.g., casino or electronic gaming machines) did not explain any further variance. These findings are the first to longitudinally examine the risk factors for problem gambling severity in Australian men aged 18–25~years. The findings highlight unique developmental and sociocultural factors that may increase young men’s vulnerability to problem gambling. Whilst mental health difficulties are a known risk factor for gambling pathology, the identification of sports and fantasy sports gambling frequency as the greatest risks for later gambling problems emphasizes a need for initiatives that can identify and support young men susceptible to this form of gambling.},
  langid = {english},
  keywords = {Gambling,Gambling Addiction,Male factor infertility,Male health,Mens' Studies,Mental health,Risk Factors,Sport Analytics,Sport Psychology,Sports gambling,Young men},
  file = {/home/chris/Zotero/storage/J8N4IZH7/Mancini et al. - 2025 - Predicting Problem Gambling in Young Men The Impact of Sports Gambling Frequency and Internalizing.pdf}
}

