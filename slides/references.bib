  pages = {1351--1354},
  issn = {1526-632X},
  doi = {10.1212/wnl.36.10.1351},
  url = {https://doi.org/10.1212/wnl.36.10.1351},
  urldate = {2022-07-19},
  abstract = {The neuronal regions affected and the neuropathologic features of ischemia and status epilepticus are similar. Experimentally, elevated plasma glucose levels, increasing brain lactate, are associated with more severe neuropathologic damage from cerebral ischemia. We therefore studied the cytologic features and cerebral content of lactate and glucose in the selectively vulnerable neurons of rat hippocampus after 2 hours of L-allylglycine-induced status epilepticus in rats with mean plasma glucose concentrations of 65, 250, and 480 mg/100 ml. Brain lactate concentration was elevated in status and maximal in the high-glucose group, but the maximum levels (8 mumol/g) were less than those thought to augment cell death in ischemia. Using multiple linear regressions, only time-in-status predicted neuropathologic damage.},
  langid = {english}
}

@incollection{swansonWorkingMemoryLearning2012,
  title = {Working Memory, Learning, and Academic Achievement},
  booktitle = {{{APA}} Educational Psychology Handbook, {{Vol}} 1: {{Theories}}, Constructs, and Critical Issues},
  author = {Swanson, H. Lee and Alloway, Tracy Packiam},
  date = {2012},
  series = {{{APA}} Handbooks in Psychology®},
  pages = {327--366},
  publisher = {American Psychological Association},
  location = {Washington, DC, US},
  doi = {10.1037/13273-012},
  abstract = {Memory is the ability to encode, process, and retrieve information that one has been exposed to. As a skill, memory is inseparable from learning and academic functioning. Although memory skills are linked to performance in several academic (e.g., reading) and cognitive areas (e.g., problem solving), memory is a critical area of focus in the field of education for two primary reasons. First, memory reflects applied cognition; that is, memory functioning reflects all the important aspects of learning. Second, memory skills used by children do not appear to exhaust, or even tap, their abilities, therefore we need to discover instructional procedures that capitalize on children's potential to remember and retrieve information. The purpose of this chapter is to selectively review past and current research on children's memory skills and their application to academic achievement. Several reviews have addressed the contribution of laboratory research on memory to such classroom issues as procedures for testing (e.g., McDaniel, Anderson, Derbish, \& Morrisette, 2007; Roediger \& Karpicke, 2006) and the acquisition and retention of information (e.g., Naveh-Benjamin, 1990). Because of the vastness of the topic, we have limited ourselves to one aspect of memory: working memory. (PsycInfo Database Record (c) 2022 APA, all rights reserved)},
  isbn = {978-1-4338-0997-2},
  keywords = {Academic Achievement,Learning,Short Term Memory},
  file = {/home/chris/Zotero/storage/Q67DHI3C/2011-11701-012.html}
}

@article{sweetYouFailedLife2018,
  title = {“{{Like}} You Failed at Life”: {{Debt}}, Health and Neoliberal Subjectivity},
  author = {Sweet, Elizabeth},
  date = {2018-09},
  journaltitle = {Social Science and Medicine},
  volume = {212},
  pages = {86--93},
  publisher = {Elsevier Science},
  location = {Sweet, Elizabeth, Department of Anthropology, University of Massachusetts Boston, 100 Morrissey Blvd., Boston, MA, US, 02125},
  issn = {18735347},
  doi = {10.1016/j.socscimed.2018.07.017},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2018-38172-012{&}site=ehost-live http://Elizabeth.Sweet@umb.edu},
  abstract = {The need to more explicitly incorporate political economy and neoliberalism into research on social inequalities in health has been acknowledged across disciplines. This paper explores neoliberalism as it relates to consumer financial debt and internalized feelings of personal responsibility and failure for adults in Boston, Massachusetts. Using data from a mixed-methods study (n = 286), findings show that endorsing a neoliberalized view of personal debt as failure is associated with significantly worse health across a range of measures, including blood pressure, adiposity, self-reported physical and emotional symptoms, depression, anxiety, and perceived stress, even when controlling for several socio-demographic confounders. Results are discussed within the context of both neoliberal economic policies that funnel consumers into chronic debt and neoliberal sociocultural ideologies that promote self-judgments of indebtedness as personal failure. Findings highlight the importance of neoliberalism as an important contemporary social determinant of health and suggest new directions for research to explore.},
  keywords = {Biocultural anthropology,Debt,Health inequality,Neoliberalism,nosource}
}

@article{sykesFactorInfluencingWomen2022,
  title = {Factor Influencing Women with Learning Disabilities Deciding to, and Accessing, Cervical and Breast Cancer Screening: {{Findings}} from a {{Q}} Methodology Study of Women with Learning Disabilities, Family and Paid Carers},
