@article{breversImplicitGamblingAttitudes2013a,
  title = {Implicit Gambling Attitudes in Problem Gamblers: {{Positive}} but Not Negative Implicit Associations},
  shorttitle = {Implicit Gambling Attitudes in Problem Gamblers},
  author = {Brevers, Damien and Cleeremans, Axel and Hermant, Christine and Tibboel, Helen and Kornreich, Charles and Verbanck, Paul and Noël, Xavier},
  date = {2013-03-01},
  journaltitle = {Journal of Behavior Therapy and Experimental Psychiatry},
  shortjournal = {Journal of Behavior Therapy and Experimental Psychiatry},
