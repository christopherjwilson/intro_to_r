@article{DAMEDAAndredasNeves;OTTErnani;ALVES2009,
  title = {O Uso Do Custo Corrente ( Fair Value ) Na Avalia\c{c}\~ao de Ativos de Empresas de Tecnologia Da Informa\c{c}\~ao},
  author = {DAMEDA, Andr\'e das Neves; OTT, Ernani; ALVES, Tiago Wickstrom},
  date = {2009-07},
  journaltitle = {THE USE OF CURRENT COST (FAIR VALUE) IN THE EVALUATION OF ASSETS IN INFORMATION TECHNOLOGY COMPANIES.},
  volume = {7},
  number = {3},
  pages = {1--13},
  publisher = {{Revista Universo Contabil}},
  issn = {18093337},
  url = {http://10.0.16.174/ruc.2011320 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=69700472{&}site=ehost-live},
  abstract = {In a context of convergence to international accounting standards, the Current Cost (Fair Value) gains strength as a method of assets evaluation and restarts the discussion on its implementation feasibility in terms of objectivity and practicality. Thus, the goal of this study was to verify the impact of using such methodology in Information Technology (IT) companies. To this end, it was promoted a brief review of the theory about the evaluation of assets at entry prices and methodological procedures were developed so as to identify and classify the assets' main items of the three companies which participated in the multi-case study, being them evaluated based on the historical costs and on current prices of items replacement under the same conditions that were found, whenever indentified in a corresponding secondary market. The procedures allowed the evaluation of approximately 50\% of the number of fixed assets' items, representing approximately 75\% of the total value of the pool. After the adjustment based on the current cost, it was found an average increase in the equity of the three companies of 36\%, having standard deviation of 13\%. This change is significant and relevant to the internal user in the management decisions, and to the external user in the investment or granting credit decisions. The procedure performed ensured an increase in informational capacity without the abandonment of objective criteria for evaluation. (English) [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Assets (Accounting),Assets evaluation,Avalia\~A\textsection\~A\textsterling o de ativos,Avalia\c{c}\~ao de ativos,Contabilidade gerencial.,Credit,Current cost,Current value accounting,Custo corrente,Decision making,Economic convergence,Fair value,Feasibility studies,Information technology,Management accounting,Managerial accounting,Market prices,Social context}
}

