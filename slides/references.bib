@article{Lakens2014,
  title = {Performing High-Powered Studies Efficiently with Sequential Analyses},
  author = {Lakens, Dani\"el},
  date = {2014},
  journaltitle = {European Journal of Social Psychology},
  volume = {44},
  number = {7},
  pages = {701--710},
  issn = {1099-0992},
  doi = {10.1002/ejsp.2023},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/ejsp.2023},
  urldate = {2023-10-10},
  abstract = {Running studies with high statistical power, while effect size estimates in psychology are often inaccurate, leads to a practical challenge when designing an experiment. This challenge can be addressed by performing sequential analyses while the data collection is still in progress. At an interim analysis, data collection can be stopped whenever the results are convincing enough to conclude that an effect is present, more data can be collected, or the study can be terminated whenever it is extremely unlikely that the predicted effect will be observed if data collection would be continued. Such interim analyses can be performed while controlling the Type 1 error rate. Sequential analyses can greatly improve the efficiency with which data are collected. Additional flexibility is provided by adaptive designs where sample sizes are increased on the basis of the observed effect size. The need for pre-registration, ways to prevent experimenter bias, and a comparison between Bayesian approaches and null-hypothesis significance testing (NHST) are discussed. Sequential analyses, which are widely used in large-scale medical trials, provide an efficient way to perform high-powered informative experiments. I hope this introduction will provide a practical primer that allows researchers to incorporate sequential analyses in their research. Copyright \textcopyright{} 2014 John Wiley \& Sons, Ltd.},
  langid = {english},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Lakens_2014_Performing high-powered studies efficiently with sequential analyses.pdf;C\:\\Users\\wilso\\Zotero\\storage\\TKP9749W\\ejsp.html}
}

@article{LamBoudreaux1983,
  title = {{{COMPENSATING BALANCES}}, {{DEFICIENCY FEES}}, {{AND LINES OF CREDIT}}.},
  author = {Lam, Chun H and Boudreaux, Kenneth J},
  date = {1983-09},
  journaltitle = {Journal of Banking \& Finance},
  volume = {7},
  number = {3},
  pages = {307--322},
  issn = {03784266},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=11490612{&}site=ehost-live},
  abstract = {An attempt to build a general model of deficiency fees applicable to the several dimensions and viewpoints for which deficiency fees are important, was made. Models of compensating balance decisions have implied that agreed-upon balances are not violated by borrowers. When compensating balance requirements can be deficient, the customer and bank must agree in advance what deficiency fee will be charged. The article developed boundary conditions for such fees, both with and without lines of credit and with balance requirements on unused lines. The process uncovered a number of important attributes of such fees, including dependence upon customer borrowing alternatives, situations of fee impossibility, and elements of practical application.},
  keywords = {\#nosource,Credit,Decision making,Finance,Loans,User charges}
}

