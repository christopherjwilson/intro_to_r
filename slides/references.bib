@article{flavellYoungChildrensKnowledge1981,
  title = {Young {{Children}}'s {{Knowledge}} about {{Visual Perception}}: {{Further Evidence}} for the {{Level}} 1-{{Level}} 2 {{Distinction}}.},
  booktitle = {Developmental {{Psychology}}},
  author = {Flavell, John H. and Everett, Barbara A. and Croft, Karen and Flavell, Eleanor R.},
