@article{rippIncidencePredictorsJob2011,
  title = {The Incidence and Predictors of Job Burnout in First-Year Internal Medicine Residents: {{A}} Five-Institution Study},
  author = {Ripp, Jonathan and Babyatsky, Mark and Fallar, Robert and Bazari, Hasan and Bellini, Lisa and Kapadia, Cyrus and Katz, Joel T. and Pecker, Mark and Korenstein, Deborah},
  date = {2011-10},
  journaltitle = {Academic Medicine},
  volume = {86},
  number = {10},
  pages = {1304--1310},
  publisher = {Lippincott Williams \& Wilkins},
  location = {Ripp, Jonathan, 1 Gustave L. Levy Place, Box 1216, New York, NY, US, 10029},
  issn = {10402446},
  doi = {10.1097/ACM.0b013e31822c1236},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2011-24950-027{&}site=ehost-live http://Jonathan.Ripp@mountsinai.org},
  abstract = {PURPOSE: Job burnout is prevalent among U.S. internal medicine (IM) residents and may lead to depression, suboptimal patient care, and medical errors. This study sought to identify factors predicting new burnout to better identify at-risk residents.\textbackslash n\textbackslash nMETHOD: The authors administered surveys to first-year IM residents at five institutions twice between June 2008 and June 2009, linking individual pre- and postresponses. Surveys measured job burnout, sleepiness, personality traits, and other characteristics. Burnout was defined using the most commonly identified definition and another stricter definition.\textbackslash n\textbackslash nRESULTS: Of 263 eligible residents, 185 (70\%) completed both surveys. Among 114 residents who began free of burnout and completed both surveys, 86 (75\%) developed burnout, with no differences across institutions. They were significantly more likely to report a disorganized personality style (9 versus 0; 11\% versus 0\%; P = .019) and less likely to report receiving regular performance feedback (34 versus 13; 63\% versus 87\%; P = .057). Using a stricter definition, 50\% (78/156) of residents developed burnout. They were less likely to plan to pursue subspecialty training (49 versus 63; 78\% versus 93\%; P = .016) or have a calm personality style (59 versus 70; 77\% versus 90\%; P = .029). There were no significant associations between burnout incidence and duty hours, clinical rotation, demographics, social supports, loan debt, or psychiatric history.\textbackslash n\textbackslash nCONCLUSIONS: This study identified a high burnout incidence. The associations observed between burnout incidence and personality style, lack of feedback, and career choice uncertainty may inform interventions to prevent burnout and associated hazards.},
  keywords = {Burnout,Female,Humans,Incidence,Internal Medicine,internal medicine residents,Internship and Residency,job burnout,Male,Medical,Medical Residency,nosource,Occupational Stress,Physicians,predictors,Professional,Prognosis,Retrospective Studies,Risk Factors,Students,Surveys and Questionnaires,United States}
}

