@article{BurrowsShortis2011,
  title = {An Evaluation of Semi-Automated, Collaborative Marking and Feedback Systems: {{Academic}} Staff Perspectives},
  shorttitle = {An Evaluation of Semi-Automated, Collaborative Marking and Feedback Systems},
  author = {Burrows, Steven and Shortis, Mark},
  date = {2011-11-27},
  journaltitle = {Australasian Journal of Educational Technology},
  shortjournal = {AJET},
  volume = {27},
