@article{FONSECAfonseca.raquel@uqam.caEtAl2012,
  title = {What {{Explains}} the {{Gender Gap}} in {{Financial Literacy}}? {{The Role}} of {{Household Decision Making}}.},
  author = {FONSECA fonseca.raquel@uqam.ca, RAQUEL1 and MULLEN kmullen@rand.org, KATHLEEN J.2 and ZAMARRO gzamarro@rand.org, GEMA3 and ZISSIMOPOULOS zissimop@healthpolicy.usc.edu, JULIE4},
  date = {2012},
  journaltitle = {Journal of Consumer Affairs},
  volume = {46},
  number = {1},
  pages = {90--106},
  publisher = {{Wiley-Blackwell}},
  issn = {00220078},
  url = {10.1111/j.1745-6606.2011.01221.x{%}5Cnhttp://search.ebscohost.com/login.aspx?direct=true{&}db=ofm{&}AN=73489784{&}site=ehost-live},
  abstract = {Using newly collected data from the RAND American Life Panel, we examine potential explanations for the gender gap in financial literacy, including the role of marriage and who within a couple makes the financial decisions. Blinder-Oaxaca decomposition reveals the majority of the gender gap in financial literacy is not explained by differences in the characteristics of men and women-but rather differences in coefficients, or how literacy is produced. We find that financial decision making of couples is not centralized in one spouse although it is sensitive to the relative education level of spouses. [ABSTRACT FROM AUTHOR]},
  keywords = {\#nosource,Couples,Financial literacy,Gender differences (Psychology),Marriage,Social conflict}
}

