@thesis{stanmyreNotJustSport2025,
  title = {Not Just for Sport: {{Gambling}} Risk among Athletes, Former Athletes, and Coaches.},
  author = {Stanmyre, Jackie F.},
  date = {2025-01-01},
  journaltitle = {Dissertation Abstracts International: Section B: The Sciences and Engineering},
  volume = {86},
  number = {5-B},
  url = {https://research.ebsco.com/linkprocessor/plink?id=b53a4a81-6719-3641-aafa-e98d29d0df55},
  abstract = {This dissertation reflects three separate papers that provide a better understanding of the gambling behaviors and problems of athletes and coaches, with attention to risk factors that drive increases in vulnerability. The body of literature generally has established that athletes are at higher risk for developing gambling problems than the general population, but there are substantial methodological limitations to existing research, which is largely non-generalizable and a theoretical; in addition, influential others such as coaches have been understudied. Rapid legal gambling expansion, particularly for sports betting, combined with the endorsement of gambling and gambling products by famous sports figures, top teams, and entire leagues, may place young athletes at additional risk for harm.Study 1 uses a systematic review and meta-analysis of the existing literature to provide a comprehensive study of the current body of work as well as its strengths and limitations. Study 2 uses risk factors, associated with problem gambling in the Revised Pathways Model of Problem Gambling (Nower, Blaszczynski, \&amp; Anthony, 2022) to identify subgroups of athletes with problem gambling symptoms in an epidemiological sample. Additionally, this study explores differences across resulting subgroups in relation to demographics, mental health, other addictions, and gambling behaviors and problem severity. Study 3 evaluates the gambling behavior and co-occurring correlates among current coaches, former coaches, and non-coaches who self-identify as athletes.Collectively, the results from this scholarship underscore the need for additional methodologically rigorous research with athletes and sports-involved populations; uniquely-tailored education, prevention, and intervention initiatives to help curb their problem gambling risk; and policies that both protect sports-involved groups from harm associated with the legal expansion of sports wagering, as well as policies that ensure that a treatment infrastructure is in place when gambling becomes unmanageable. (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
  langid = {english},
  keywords = {Adulthood (18 yrs & older),Athletes,Coaches,Gambling Disorder,Risk Factors,Sports}
}

