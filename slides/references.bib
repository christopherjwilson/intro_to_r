@article{LoRepin2002,
  title = {The {{Psychophysiology}} of {{Real-Time Financial Risk Processing}}.},
  author = {Lo, Andrew W and Repin, Dmitry V},
  date = {2002-04},
  journaltitle = {Journal of cognitive neuroscience},
  volume = {14},
  number = {3},
  eprint = {11970795},
  eprinttype = {pmid},
  pages = {323--39},
  publisher = {{MIT Press 238 Main St., Suite 500, Cambridge, MA 02142-1046 USA journals-info@mit.edu}},
  issn = {0898-929X},
  doi = {10.1162/089892902317361877},
  abstract = {A longstanding controversy in economics and finance is whether financial markets are governed by rational forces or by emotional responses. We study the importance of emotion in the decision-making process of professional securities traders by measuring their physiological characteristics (e.g., skin conductance, blood volume pulse, etc.) during live trading sessions while simultaneously capturing real-time prices from which market events can be detected. In a sample of 10 traders, we find statistically significant differences in mean electrodermal responses during transient market events relative to no-event control periods, and statistically significant mean changes in cardiovascular variables during periods of heightened market volatility relative to normal-volatility control periods. We also observe significant differences in these physiological responses across the 10 traders that may be systematically related to the traders' levels of experience.},
  langid = {english},
  keywords = {\#nosource,Blood Pressure,Cognition,Cognition: physiology,Commerce,Economic,Electromyography,Emotions,Emotions: physiology,Female,Galvanic Skin Response,Heart Rate,Humans,Investments,Male,Models,Risk-Taking}
}

@article{LouisTay1*CassondraBatz1*ScottParrigon1*LaurenKuykendall22016,
  title = {Debt and {{Subjective Well-being}}: {{The Other Side}} of the {{Income-Happiness Coin}}...: {{Books}}, {{Articles}}, \& {{More}}...},
  author = {{Louis Tay1 \textbullet{} Cassondra Batz1 \textbullet{} Scott Parrigon1 \textbullet{} Lauren Kuykendall2}},
  date = {2016-06},
  journaltitle = {Journal of Happiness Studies},
  volume = {18},
  number = {3},
  pages = {903--937},
  publisher = {{Springer Science \& Business Media B.V.}},
  issn = {13894978},
  url = {https://eds.b.ebscohost.com/eds/pdfviewer/pdfviewer?vid=1{&}sid=59ed1a43-23c6-44c3-a971-8633b5a5abdc{%}40pdc-v-sessmgr01},
  abstract = {To spur research on the topic of debt and its consequences, we conducted a systematic review to integrate the different conceptualizations of debt and to develop a conceptual model explaining mechanisms through which debt influences subjective well- being (SWB). Our conceptual model weaves two common themes from the prior literature: (a) a bottom-up spillover perspective where debt affects SWB via the financial domain (and possibly other life domains that are negatively affected through spillover); and (b) a resource perspective wherein debt is a strain on financial resources which, in turn, lowers SWB. Further, we review past empirical studies assessing the linkage between debt and SWB. A majority of associations (90 \%), from 20 studies, revealed at least one significant negative effect between debt and SWB. Further, a random effects meta-analysis of seven studies showed a small relationship between debt and SWB (r = -.07), although there also appear to be critical moderators such as levels of debt, source of debt, and overall financial resources. To test our conceptual model, we conduct a moderated mediation analysis of a large scale representative sample of college graduates with Internet access in the United States (N = 2781) to examine the effects of student loans on SWB. Debt and income accounted for 40 and 60 \% of the predicted variance of life satisfaction, respec- tively. In addition, the bottom-up perspective and resource perspectives were supported. One critical limitation is that there are not many studies on debt and SWB. Future areas for research are discussed.},
  keywords = {\#nosource,DEBT,FINANCE,HAPPINESS,SATISFACTION,WELL-being}
}

