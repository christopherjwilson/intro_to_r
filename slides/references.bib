@article{zolkwerVoluntarySelfexclusionContingency2023,
  title = {Voluntary Self-Exclusion and Contingency Management for the Treatment of Problematic and Harmful Gambling in the {{UK}}: {{An}} Exploratory Study},
  author = {Zolkwer, M.B. and Dymond, S. and Singer, B.F.},
  date = {2023},
  journaltitle = {Healthcare (Switzerland)},
  volume = {11},
  number = {19},
  publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
  location = {["School of Psychology, University of Sussex, Brighton, BN1 9RH, United Kingdom", "Great Ormond Street Institute of Child Health, University College London, London, WC1N 1EH, United Kingdom", "Mosaicism and Precision Medicine Laboratory, The Francis Crick Institute, London, NW1 1AT, United Kingdom", "School of Psychology, Swansea University, Swansea, SA2 8PP, United Kingdom", "Department of Psychology, Reykjavík University, Reykjavík, 102, Iceland", "Sussex Addiction Research and Intervention Centre and Sussex Neuroscience, University of Sussex, Brighton, BN1 9RH, United Kingdom"]},
  issn = {22279032 (ISSN)},
  doi = {10.3390/healthcare11192682},
  url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173880192&doi=10.3390%2fhealthcare11192682&partnerID=40&md5=ca95f48d043f42e9e38f1b6f80e93ec5},
  abstract = {Research into self-directed methods for reducing problematic and harmful gambling is still in its infancy. One strategy that individuals use to prevent gambling involves voluntary self-exclusion (VSE) programs. For example, VSE programs can make it challenging to access betting sites or enable banks to block gambling-related transactions. Although individual VSEs can be helpful when used alone, it is unclear whether their efficacy is enhanced when combined. Furthermore, it is unknown how VSE compliance can be improved. We propose that contingency management (CM), an evidence-based strategy to incentivise abstinence, could encourage continued VSE use, promoting long-lasting recovery from problematic or harmful gambling. Here, we conducted exploratory analyses on VSE use and CM for gambling in two populations (members of the UK general population recruited and students). Participants responded favourably regarding combined VSE use. They felt that providing vouchers exchangeable for goods/services could incentivise gambling abstinence during VSE. However, some were concerned about people potentially “gaming” the system. Participants believed supplementing VSE and CM with social support could encourage abstinence. These attitudes, and recent research on treatment providers’ opinions on CM for gambling, suggest that experimental evidence should be sought to determine the efficacy of combined VSE use and CM for gambling. © 2023 by the authors.},
  langid = {english},
  keywords = {contingency management,gambling,voluntary self-exclusion},
  file = {/home/chris/Zotero/storage/LKP2LKEI/Zolkwer et al. - 2023 - Voluntary self-exclusion and contingency management for the treatment of problematic and harmful gam.pdf}
}

@article{zopounidisPreferenceDisaggregationDecision2001,
