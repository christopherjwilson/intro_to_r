  issn = {1099-078X},
  doi = {10.1002/bin.1335},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bin.1335},
  urldate = {2023-10-06},
  abstract = {Over the past 60 years, applied behavior analysis (ABA) has made notable contributions to the literature involving populations with developmental disabilities. Practitioners and researchers have made impressive advances in addressing challenges posed by autism spectrum disorder (ASD), in particular. The focus on autism has resulted in an improved public image of ABA and, in turn, has helped highlight the need for increased awareness surrounding ASD. A summary of relevant research contributions is provided, and although the advances in autism are impressive, individuals with ASD constitute a minority portion of the educational system. A review of the existing literature, as well as a novel literature search, supports the suggestion that ABA has narrowed its focus to issues affecting populations with ASD, while concurrently being less attentive to problems faced by society as a whole, particularly general education. Copyright \textcopyright{} 2012 John Wiley \& Sons, Ltd.},
  langid = {english},
  file = {C\:\\Users\\wilso\\OneDrive - Teesside University\\Papers\\Axelrod et al_2012_Applied Behavior Analysis.pdf;C\:\\Users\\wilso\\Zotero\\storage\\V94ELNLE\\bin.html}
}

@article{AxelrodHamilton1981,
  title = {The {{Evolution}} of {{Cooperation}}},
  author = {Axelrod, Robert and Hamilton, William D},
  date = {1981},
  pages = {11},
  abstract = {Cooperation in organisms, whether bacteria or primates, has been a difficulty for evolutionary theory since Darwin. On the assumption that interactions between pairs of individuals occur on a probabilistic basis, a model is developed based on the concept of an evolutionarily stable strategy in the context of the Prisoner's Dilemma game. Deductions from the model, and the results of a computer tournament show how cooperation based on reciprocity can get started in an asocial world, can thrive while interacting with a wide range of other strategies, and can resist invasion once fully established. Potential applications include specific aspects of territoriality, mating, and disease.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Axelrod_Hamilton_1981_The Evolution of Cooperation.pdf}
}

@inproceedings{AyazEtAl2010,
  title = {Sliding-Window Motion Artifact Rejection for {{Functional Near-Infrared Spectroscopy}}},
  booktitle = {2010 {{Annual International Conference}} of the {{IEEE Engineering}} in {{Medicine}} and {{Biology}}},
  author = {Ayaz, Hasan and Izzetoglu, Meltem and Shewokis, Patricia A. and Onaral, Banu},
  date = {2010-08},
  pages = {6567--6570},
  issn = {1558-4615},
  doi = {10.1109/IEMBS.2010.5627113},
  abstract = {Functional Near-Infrared Spectroscopy (fNIR) is an optical brain monitoring technology that tracks changes in hemodynamic responses within the cortex. fNIR uses specific wavelengths of light, introduced at the scalp, to enable the noninvasive measurement of changes in the relative ratios of deoxygenated hemoglobin (deoxy-Hb) and oxygenated hemoglobin (oxy-Hb) during brain activity. This technology allows the design of portable, safe, affordable, noninvasive, and minimally intrusive monitoring systems that can be used to measure brain activity in natural environments, ambulatory and field conditions. However, for such applications fNIR signals can get prone to noise due to motion of the head. Improving signal quality and reducing noise, can be especially challenging for real time applications. Here, we study motion artifact related noise especially due to poor and changing sensor coupling. We have developed a simple and iterative method that can be used to automate the preprocessing of data to identify segments with such noise for exclusion and this method is also suitable for real time applications.},
  eventtitle = {2010 {{Annual International Conference}} of the {{IEEE Engineering}} in {{Medicine}} and {{Biology}}},
  keywords = {Adaptive optics,Detectors,Light sources,Signal to noise ratio,Spectroscopy,Wavelength measurement},
  file = {C:\Users\wilso\Zotero\storage\4FSIFWWG\Ayaz et al. - 2010 - Sliding-window motion artifact rejection for Funct.pdf}
}

