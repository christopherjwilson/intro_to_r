@article{HermesEtAl2012,
  title = {The {{Impact}} of {{Trade Credit}} on {{Customer Switching Behaviour}}: {{Evidence}} from the {{Tanzanian Rice Market}}},
  author = {Hermes, Niels and Kihanga, Ernest and Lensink, Robert and Lutz, Clemens},
  date = {2012-03},
  journaltitle = {Journal of Development Studies},
  volume = {48},
  number = {3},
  pages = {363--376},
  publisher = {{Routledge}},
  issn = {00220388},
  doi = {10.1080/00220388.2011.615921},
  url = {http://10.0.4.56/00220388.2011.615921 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=74009028{&}site=ehost-live},
  abstract = {We use primary survey data to analyse the relationship between trade credit and customer switching in the context of trade transactions between wholesalers and retailers in the Tanzanian rice market. Results reveal a negative relation of trade credit and customer switching, that is, trade credit acts as a switching barrier; retailers are reluctant to move to another supplier if they depend on trade credit as a source of external finance. This interpretation fits with the underdeveloped financial markets in Tanzania, in which access to external finance is poor among rice retailers. \textcopyright{} 2012 Copyright Taylor and Francis Group, LLC.},
  keywords = {\#nosource,Consumer behavior,Credit,Retail industry,Rice industry,Tanzania,Wholesale trade}
}

