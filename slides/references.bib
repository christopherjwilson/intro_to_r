  issn = {0027-8424, 1091-6490},
  doi = {10.1073/pnas.0905918106},
  url = {https://pnas.org/doi/full/10.1073/pnas.0905918106},
  urldate = {2022-10-07},
  abstract = {In a pairwise interaction, an individual who uses costly punishment must pay a cost in order that the opponent incurs a cost. It has been argued that individuals will behave more cooperatively if they know that their opponent has the option of using costly punishment. We examined this hypothesis by conducting two repeated two-player Prisoner's Dilemma experiments, that differed in their payoffs associated to cooperation, with university students from Beijing as participants. In these experiments, the level of cooperation either stayed the same or actually decreased when compared with the control experiments in which costly punishment was not an option. We argue that this result is likely due to differences in cultural attitudes to cooperation and punishment based on similar experiments with university students from Boston that found cooperation did increase with costly punishment.},
  langid = {english},
  file = {/home/chris/Zotero/storage/QXIY8FXG/Chamorro-Premuzic, Ahmetoglu, Furnham_2008_Little more than personality Dispositional determinants of test anxiety (the Big Five, cor(5).pdf;/home/chris/Zotero/storage/VSD8FLES/Chamorro-Premuzic, Ahmetoglu, Furnham_2008_Little more than personality Dispositional determinants of test anxiety (the Big Five, cor(5).pdf}
}

@article{wuNearwinsNearlossesGambling2015,
  title = {Near-Wins and near-Losses in Gambling: {{A}} Behavioral and Facial {{EMG}} Study},
  shorttitle = {Near-Wins and near-Losses in Gambling},
  author = {Wu, Yin and family=Dijk, given=Eric, prefix=van, useprefix=true and Clark, Luke},
  date = {2015},
  journaltitle = {Psychophysiology},
  volume = {52},
  number = {3},
  pages = {359--366},
  issn = {1469-8986},
  doi = {10.1111/psyp.12336},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/psyp.12336},
  urldate = {2026-09-28},
  abstract = {This study investigated responses to near-wins (i.e., nonwin outcomes that were close to a major win, and their counterpart, near-losses (nonwin outcomes that are proximal to a major loss) in a decision-making task, measuring (a) luck ratings, (b) adjustment of bet amount, and (c) facial muscle reactivity at zygomaticus and corrugator sites. Compared to full-misses, near-wins decreased self-perceived luck and near-losses increased self-perceived luck, consistent with the effects of upward versus downward counterfactual thinking, respectively. Wins and losses both increased zygomaticus reactivity, and losses selectively enhanced corrugator reactivity. Near-wins heightened zygomaticus activity, but did not affect corrugator activity, thus showing a similar response pattern to actual wins. There were no significant facial EMG effects of near-losses. We infer that near-wins engender some appetitive processing, despite their objective nonwin status.},
  langid = {english},
  keywords = {Cognitive distortion,Electromyography,Gambling,Near-miss,Risk taking},
  file = {/home/chris/Zotero/storage/6SLBLC32/Wu et al. - 2015 - Near-wins and near-losses in gambling A behavioral and facial EMG study.pdf;/home/chris/Zotero/storage/CHPW3ZAM/psyp.html}
}

@article{wuOnlineShoppingBehavior2015,
  title = {An {{Online Shopping Behavior Model Integrating Personality Traits}}, {{Perceived Risk}}, and {{Technology Acceptance}}},
  author = {Wu, Wann-Yih and Ke, Ching-Ching},
