}

@article{rayyan-471359600,
  title = {Reasons for Gambling in University Students, Loneliness? {{A}} Study on Sports Science Students.},
  author = {BAŞOĞLU, Umut Davut and YAĞCI, İhsan and SEYDİOĞLU, Cüneyt},
  date = {2024-09},
