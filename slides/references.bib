  journaltitle = {Journal of Public Mental Health},
  volume = {9},
  number = {3},
  pages = {27--35},
  publisher = {{Pier Professional}},
  location = {{Murray, John, London Health Forum, 6 Derby Street, London, United Kingdom, W1J 7AD}},
  issn = {20428731},
  doi = {10.5042/jpmh.2010.0460},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2011-06035-004{&}site=ehost-live http://jmurray@london-health.org},
  abstract = {In the wake of the financial crisis and ensuing recession, there has been a substantial increase in the number of individuals and households unable to meet their financial commitments, especially in London, UK. This growth in personal debt problems has significant implications for individual health and the associated need for NHS care. There is growing evidence that financial problems are associated with stress-related ill health, both mental and physical. This article summarises the London Health Forum's report on the relationship between personal debt and health in London and reviews other studies that have carried out research on health and debt. (PsycINFO Database Record (c) 2013 APA, all rights reserved). (journal abstract)},
  keywords = {\#nosource,Debt,Economic downturn,Health outcomes,Stress}
}

