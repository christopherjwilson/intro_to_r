  shorttitle = {{{AviR}}},
  booktitle = {Enabling {{Technology}} for {{Neurodevelopmental Disorders}}},
  author = {Verma, Om Prakash, Anshu Khurana},
  date = {2022},
  publisher = {Routledge},
  abstract = {A Neurodevelopmental disorder (NDD) is an abnormality that can be seen in the form of fear, self-confidence, hyper-activeness, social interaction, daily life activities, and many more. Now, to focus on NDDs is the demand of time and need of all countries. Autism spectrum disorder is a notable NDD. The main symptoms that can be seen in autistic children are fear, social interaction, attention span time, focus power and so on. Rehabilitation needs therapies and special training depending on the severity of disease. This chapter proposes software comprising two games: CASO and ATLAS. These two games can be used to treat autistic child between the ages of four and 18 years. The games are freely available globally. Web virtual reality (webVR) is used to develop games which make it more attractive. The testing of games was performed by a therapist and special educator for four weeks. During the testing phase, all parameters was deeply analyzed on the basis of various parameters of autism symptoms. After result analysis, it was concluded that the use of games developed in webVR is effective. Games helped in decreasing levels of fear, increasing attention time span, increasing social interaction, and better emotional skills.},
  isbn = {978-1-003-16556-9},
  pagetotal = {10}
}

