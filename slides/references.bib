@article{MacraeEtAl2014,
  title = {When Do {{I}} Wear Me out? {{Mental}} Simulation and the Diminution of Self-Control},
  shorttitle = {When Do {{I}} Wear Me Out?},
  author = {Macrae, C. Neil and Christian, Brittany M. and Golubickis, Marius and Karanasiou, Magdalene and Troksiarova, Lenka and McNamara, Diana L. and Miles, Lynden K.},
  date = {2014-08},
  journaltitle = {Journal of Experimental Psychology: General},
  shortjournal = {Journal of Experimental Psychology: General},
  volume = {143},
  number = {4},
  pages = {1755--1764},
  issn = {0096-3445},
  doi = {10.1037/a0036100},
  url = {http://search.ebscohost.com/login.aspx?direct=true&db=pdh&AN=2014-09042-001&site=ehost-live},
  urldate = {2019-03-01},
  abstract = {Exerting self-control can diminish people's capacity to engage in subsequent acts of behavioral regulation, a phenomenon termed ego depletion. But what of imaginary regulatory experiences\textemdash does simulated restraint elicit comparable lapses in self-control? Here we demonstrate such effects under theoretically tractable imagery conditions. Across 3 experiments, temporal, structural, and spatial components of mental simulation were observed to drive the efficacy of imaginary self-control. In Experiment 1, lapses in restraint (i.e., financial impulsivity) were more pronounced when imaginary regulation (i.e., dietary restraint) focused on an event in the near versus distant future. In Experiment 2, comparable effects (i.e., increased stereotyping) emerged when simulated self-control (i.e., emotional suppression) was imagined from a first-person (cf. third-person) visual perspective. In Experiment 3, restraint was diminished (i.e., increased risk taking) when self-regulation (i.e., action control) centered on an event at a near versus distant location. These findings further delineate the conditions under which mental simulation impacts core aspects of social\textendash cognitive functioning. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {\#nosource,Cognition,Cognitive Ability,Ego,ego depletion,Female,Humans,Informal,Male,mental simulation,Risk-Taking,self-control,Self-Control,Self-Regulation,Simulation,Social Cognition,social cognitive functioning,Social Control,{Social Control, Informal},temporal construal,Time Factors,visual perspective},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Macrae et al. - 2014 - When do I wear me out Mental simulation and the d.pdf}
}

