@article{MasudaEtAl2009,
  title = {A {{Parametric Study}} of {{Cognitive Defusion}} and the {{Believability}} and {{Discomfort}} of {{Negative Self-Relevant Thoughts}}},
  author = {Masuda, Akihiko and Hayes, Steven C. and Twohig, Michael P. and Drossel, Claudia and Lillis, Jason and Washio, Yukiko},
  date = {2009-03},
  journaltitle = {Behavior Modification},
  shortjournal = {Behav Modif},
  volume = {33},
  number = {2},
  pages = {250--262},
  issn = {0145-4455, 1552-4167},
  doi = {10.1177/0145445508326259},
  url = {http://journals.sagepub.com/doi/10.1177/0145445508326259},
  urldate = {2022-10-07},
  abstract = {A previous time-series study showed that rapidly repeating a single-word version of a negative self-referential thought reduced the discomfort and the believability associated with that thought. The present parametric study examined whether durations of word repetition were differentially effective in altering the discomfort and believability of negative self-referential thought. In two studies, both discomfort and believability varied systematically with the duration of word repetition. The effects of rapid repetition on emotional discomfort bottomed out after 3 s to 10 s of rapid repetition, whereas the effects on believability did so after 20 s to 30 s of repetition. This study lends support to the cognitive defusion interpretation of the effect of word repetition, suggesting that emotional discomfort and believability may be distinctive functional aspects of cognitive events.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Mendeley et al._2009_No Title(29).pdf}
}

@article{matsuba2006,
  title = {Searching for {{Self}} and {{Relationships Online}}},
  author = {{matsuba}, M. Kyle},
  date = {2006-06},
  journaltitle = {CyberPsychology \& Behavior},
  shortjournal = {CyberPsychology \& Behavior},
  volume = {9},
  number = {3},
  pages = {275--284},
  issn = {1094-9313, 1557-8364},
  doi = {10.1089/cpb.2006.9.275},
  url = {http://www.liebertpub.com/doi/10.1089/cpb.2006.9.275},
  urldate = {2022-10-07},
  abstract = {The purpose of this project was to study how Internet use relates to psychological well-being, relationships, the self and identity. University students (N = 203) completed a battery of questionnaires including measures of time spent online, ``pathological'' Internet use, Internet motivation, loneliness, relationship quality, self-concept clarity, and ego identity. Results showed positive relationships between measures of Internet use and loneliness. As well, face-to-face relationships were rated higher on both positive and negative quality dimensions relative to online relationships. Finally, Internet use was negatively correlated with self-concept clarity, and associated with moratorium identity status. These results suggest that the Internet may be an important aid for young adults as they searched for an adult identity.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Matsuba_2006_Searching for self and relationships online.pdf}
}

