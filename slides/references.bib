@article{OuelletEtAl2004,
  title = {Acquiring a Cognitive Skill with a New Repeating Version of the {{Tower}} of {{London}} Task.},
  author = {Ouellet, Marie-Christine and Beauchamp, Miriam H. and {Miriam H. Beauchamp} and Owen, Adrian M. and Doyon, Julien},
  date = {2004-12-01},
  journaltitle = {Canadian Journal of Experimental Psychology},
  volume = {58},
  number = {4},
  eprint = {15648730},
  eprinttype = {pmid},
  pages = {272--288},
  doi = {10.1037/h0087450},
  abstract = {A computerized version of the Tower of London task was used to investigate cognitive skill learning. Thirty- six healthy volunteers were assigned to either a random condition (nonrecurring problems), or to a sequence condi- tion in which, unbeknownst to the subjects, a repeating sequence of three problems was presented. Indices of exe- cution, planning, and total time, as well as number of moves performed, were used to measure behavioural change. Subjects' performance improved in both conditions across blocks of practice. A distinct learning effect related to the repeating sequence was also observed. This suggests that a specific skill that reflects procedural learning of the strategies, rules, and procedures pertaining to repeating problems can develop over and above a more general skill at solving cognitive planning problems with practice.},
  annotation = {MAG ID: 2059708726 S2ID: e747d63034d61b07a4912dbf7438b845b1007509}
}

@article{OuyangEtAl2009,
  title = {An Optimization Approach for Joint Pricing and Ordering Problem in an Integrated Inventory System with Order-Size Dependent Trade Credit},
  author = {Ouyang, Liang Yuh and Ho, Chia Huei and Su, Chia Hsien},
  date = {2009-10},
  journaltitle = {Computers and Industrial Engineering},
  volume = {57},
  number = {3},
  pages = {920--930},
  issn = {03608352},
  doi = {10.1016/j.cie.2009.03.011},
  url = {http://10.0.3.248/j.cie.2009.03.011 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=44101499{&}site=ehost-live},
  abstract = {Under a business trading environment, it is common for the trade credit to depend on the order size. Therefore, it is important to discuss the single-supplier and single-buyer supply chain problem which includes order-size dependent trade credit. In this study, an integrated inventory model with a price sensitive demand rate, determining jointly economic lot size of the buyer's ordering and the supplier's production batch, are developed to maximize the total profit per unit time. An efficient algorithm is provided to obtain the optimal solution, and then numerical examples are presented to illustrate the theoretical results. Finally, the comparison between whether an optimal solution is jointly or independently determined is also provided. \textcopyright{} 2009 Elsevier Ltd. All rights reserved.},
  keywords = {\#nosource,Finance,Integrated model,Inventory control,Order-size dependent trade credit,Pricing}
}

