@article{peckhamEyeTrackingAttention2016,
  title = {Eye {{Tracking}} of {{Attention}} to {{Emotion}} in {{Bipolar I Disorder}}: {{Links}} to {{Emotion Regulation}} and {{Anxiety Comorbidity}}},
