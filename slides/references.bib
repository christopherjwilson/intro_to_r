@article{berezukManagingMoneyMatters2018,
  title = {Managing Money Matters: {{Managing}} Finances Is Associated with Functional Independence in {{MCI}}},
  shorttitle = {Managing Money Matters},
  author = {Berezuk, Courtney and Ramirez, Joel and Black, Sandra E. and Zakzanis, Konstantine K. and {for the Alzheimer's Disease Neuroimaging Initiative} and {Alzheimer's Disease Neuroimaging Initiative}},
  date = {2018-03},
