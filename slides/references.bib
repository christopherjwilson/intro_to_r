  date = {2003-03},
  journaltitle = {Journal of Child Psychology and Psychiatry},
  volume = {44},
  number = {3},
  pages = {432--444},
  issn = {00219630},
  doi = {10.1111/1469-7610.00133},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/1469-7610.00133},
  urldate = {2022-10-07},
  abstract = {Background: This study presents two experiments that investigated the relationship between7- and 10-year-olds' levels of self-report trait anxiety and depression and their visual search for threatening (angry faces) and non-threatening (happy and neutral faces) stimuli. Method: In both experiments a visual search paradigm was used to measure participants' reaction times to detect the presence or absence of angry, happy or neutral schematic faces (Experiment 1) or cartoon drawings (Experiment 2). On target present trials, a target face was displayed alongside three, five or seven distractor items. On target absent trials all items were distractors. Results: Both experiments demonstrated that on target absent (but not present) trials, increased levels of anxiety produced significantly faster search times in the angry face condition, but not in the neutral condition. In Experiment 2 there was some trend towards significance between anxiety and searches for happy faces in absent trials. There were no effects of depression on search times in any condition. Conclusion: The results support previous work highlighting a specific link between anxiety and attention to threat in childhood.},
  langid = {english},
  keywords = {Anxiety,attention,depression,emotional expression,nosource},
  file = {/home/chris/Zotero/storage/KSZFMX2W/Hadwin et al_2003_The influence of children's self-report trait anxiety and depression on visual.pdf;/home/chris/Zotero/storage/KYKGANSZ/Hadwin et al_2003_The influence of children's self-report trait anxiety and depression on visual.pdf}
