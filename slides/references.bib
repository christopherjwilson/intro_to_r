@incollection{Haslem2012,
  title = {Mutual {{Funds}} and {{Individual Investors}}: {{Advertising}} and {{Behavioral Issues}}},
  booktitle = {Ssrn},
  author = {Haslem, John A.},
  editor = {Baker, H Kent and Ricciardi, Victor},
  date = {2012},
  series = {Wiley Finance Series},
  pages = {533--553},
  publisher = {{John Wiley \& Sons Inc}},
  location = {{Hoboken, NJ}},
  doi = {10.2139/ssrn.2146632},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2014-13443-029{&}site=ehost-live},
  abstract = {The study reviews important interactions between mutual funds and individual investors in choosing equity mutual funds. An important question is why both sophisticated and unsophisticated investors continue to invest in actively managed funds that generally underperform. Actively managed funds have histories of high levels of spending on advertising because they know it works in increasing assets under management. Fund managers have learned that investors chase past performance in the mistaken belief that the past predicts future performance. Funds further take advantage of investors by increasing advertising when current past performance is high. Advertising encourages individual investors to make fund choices in specific funds because they are generally unsophisticated, uninformed, and have low financial literacy, including a lack of knowledge of both transparent and opaque fund expenses and fees. Any persistence in high fund performance is also much more likely due to luck than portfolio manager skill. The Securities and Exchange Commission has also failed to prohibit performance advertising or to require it to be unambiguous.},
  isbn = {978-1-118-49298-7},
  keywords = {\#nosource,active management,advertising,choice,emotion,expenses,financial literacy,flows,G2,G23,G28,investor choice,mutual funds,performance,performance sensitivity,persuasion,sentiment contrarian behavior}
}

