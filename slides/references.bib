@inproceedings{LeeEtAl2018,
  title = {Cross-Correlation between {{HbO}} and {{HbR}} as an Effective Feature of Motion Artifact in {{fNIRS}} Signal},
  booktitle = {2018 6th {{International Conference}} on {{Brain-Computer Interface}} ({{BCI}})},
  author = {Lee, Gihyoun and Jin, Sang Hyeon and Yang, Seong Tae and An, Jinung and Abibulaev, Berdakh},
  date = {2018-01},
  pages = {1--3},
  issn = {2572-7672},
  doi = {10.1109/IWW-BCI.2018.8311513},
  abstract = {The general linear model (GLM) as a standard model for fMRI analysis has been applied to fNIRS imaging analysis as well. The GLM is very likely to make false predictions for motion artifact in fNIRS signals. The temporal characteristics of normal cerebral hemodynamics are basically the opposite tendency of oxy-hemoglobin (HbO) and deoxy-hemoglobin (HbR). When motion artifact occurs, HbO and HbR are completely different from normal cases as the baseline changes. This paper presents a cross-correlation between HbO and HbR as a feature that can determine the dynamic noise of fNIRS. Since cross-correlation is a deterministic tool that is easy to calculate, it will be very useful for noise elimination if it is noted as a criterion of dynamic noise in fNIRS signals.},
  eventtitle = {2018 6th {{International Conference}} on {{Brain-Computer Interface}} ({{BCI}})},
  keywords = {Analytical models,Biological system modeling,Correlation,Cross-correlation,Feature extraction,fNIRS,Functional magnetic resonance imaging,Hemodynamics,Motion artifact,Motion artifacts,Pattern analysis},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Lee et al_2018_Cross-correlation between HbO and HbR as an effective feature of motion.pdf}
}

