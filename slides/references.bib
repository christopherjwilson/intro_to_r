@article{savolainenRoleOnlineGroup2021,
  title = {The Role of Online Group Norms and Social Identity in Youth Problem Gambling},
  author = {Savolainen, Iina and Oksanen, Atte and Kaakinen, Markus and Sirola, Anu and Zych, Izabela and Paek, Hye-Jin},
