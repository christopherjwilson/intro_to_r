  shorttitle = {Information {{Privacy Concerns}}},
  author = {{Pennsylvania State University} and Xu, Heng and Dinev, Tamara and {Florida Atlantic University} and Smith, Jeff and {Miami University} and Hart, Paul and {Florida Atlantic University}},
