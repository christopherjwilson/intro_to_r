@article{TaylorWarren2012,
  title = {Maternal {{Depressive Symptoms Following Autism Spectrum Diagnosis}}},
  author = {Taylor, Julie and Warren, Zachary},
  date = {2012-07},
  journaltitle = {Journal of Autism \& Developmental Disorders},
  volume = {42},
  number = {7},
