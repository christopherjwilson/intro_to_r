  journaltitle = {Australasian Journal on Ageing},
  series = {Papers from Special Theme Session Held as Part of the {{International Academy}} of {{Law}} and {{Mental Health}}, {{Sydney}} 2: {{September}} 2003},
  volume = {24},
  pages = {S51-S56},
  publisher = {{Blackwell Publishing}},
  location = {{Tilse, Cheryl, School of Social Work \& Applied Human Sciences, University of Queensland, Brisbane, QLD, Australia, 4072}},
  issn = {14406381},
  doi = {10.1111/j.1741-6612.2005.00101.x},
  url = {http://search.ebscohost.com/login.aspx?direct=true{&}db=psyh{&}AN=2006-10884-010{&}site=ehost-live orcid: 0000-0001-8724-411X http://c.tilse@social.ug.edu.au},
  abstract = {The management of the financial assets of older people is increasingly important in the current policy context. Competing interests from the state, the market and the family regarding the appropriate use of these assets suggest that non-professional managers are assisting older people in a complex environment. This paper, based on a national prevalence study and an in-depth study, explores the nature and extent of asset management on behalf of older people. It examines the role of legal provision for substitute decision-making in these processes and concludes that the current provision is insufficient to protect older people from financial abuse and support carers to manage assets well. This paper proposes that more broadly based interventions are required in a complex environment of competing interests. Such interventions include attitudinal change, improved financial literacy, information and support for older people and informal asset managers and improved monitoring and support for substitute decision makers.},
  issue = {SUPPL.1},
  keywords = {\#nosource,Aging,asset management,Decision Making,Legal Processes,legal provisions,Money,older people's financial assets}
}

