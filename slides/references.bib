@article{spicerLootBoxesProblem2022,
  title = {Loot Boxes, Problem Gambling and Problem Video Gaming: {{A}} Systematic Review and Meta-Synthesis},
  shorttitle = {Loot Boxes, Problem Gambling and Problem Video Gaming},
  author = {Spicer, Stuart Gordon and Nicklin, Laura Louise and Uther, Maria and Lloyd, Joanne and Lloyd, Helen and Close, James},
  date = {2022-04-01},
  journaltitle = {New Media \& Society},
  volume = {24},
  number = {4},
  pages = {1001--1022},
  publisher = {SAGE Publications},
  issn = {1461-4448},
  doi = {10.1177/14614448211027175},
  url = {https://doi.org/10.1177/14614448211027175},
  urldate = {2025-07-02},
  abstract = {Loot boxes (LBs) are video game-related purchases with a chance-based outcome. Due to similarities with gambling, they have come under increasing scrutiny from media, academics and policymakers alike. Initial evidence suggested that LB engagement might be associated with both problem gambling (PG) and problem video gaming (PVG). We therefore conducted a systematic review of the evidence for associations between LB purchasing, PG and PVG. For LB/PG, 12 of 13 publications reported a positive relationship, with a moderately sized mean effect of r\,=\,.27. For LB/PVG, the mean effect was r\,=\,.40, although this finding was drawn from only six surveys in total. For PG/PVG, the mean effect was r\,=\,.21, with only 11 of 20 studies reporting significant effects. While further evidence is required to determine the direction of causality, the strength of relationships suggests that policy action on LBs may have benefits for harm minimisation.},
  langid = {english},
  keywords = {Addiction,BEHAVIORS,CONVERGENCE,ESPORTS,GAMBLERS,GAMERS,impulsivity,loot boxes,mental health,microtransactions,MIGRATION,nudges,problem gambling,problem video gaming,SKINS,systematic review,wellbeing},
  file = {/home/chris/Zotero/storage/9MZRT5EM/Spicer et al_2022_Loot boxes, problem gambling and problem video gaming.pdf;/home/chris/Zotero/storage/Y2BLEYXX/Spicer et al. - 2022 - Loot boxes, problem gambling and problem video gaming A systematic review and meta-synthesis.pdf}
}

@article{spiekermannValueTheoryPersonal2017,
  title = {Towards a Value Theory for Personal Data},
  author = {Spiekermann, Sarah and Korunovska, Jana},
  date = {2017-03-01},
  journaltitle = {Journal of Information Technology},
  shortjournal = {Journal of Information Technology},
  volume = {32},
  number = {1},
  pages = {62--84},
  publisher = {SAGE Publications Ltd},
  issn = {0268-3962},
  doi = {10.1057/jit.2016.4},
  url = {https://doi.org/10.1057/jit.2016.4},
  urldate = {2022-04-20},
  abstract = {Analysts, investors and entrepreneurs have recognized the value of personal data for Internet economics. Personal data is viewed as ‘the oil’ of the digital economy. Yet, ordinary people are barely aware of this. Marketers collect personal data at minimal cost in exchange for free services. But will this be possible in the long term, especially in the face of privacy concerns? Little is known about how users really value their personal data. In this paper, we build a user-centered value theory for personal data. On the basis of a survey experiment with 1269 Facebook users, we identify core constructs that drive the value of volunteered personal data. We find that privacy concerns are less influential than expected and influence data value mainly when people become aware of data markets. In fact, the consciousness of data being a tradable asset is the single most influential factor driving willingness-to-pay for data. Furthermore, we find that people build a sense of psychological ownership for their data and hence value it more. Finally, our value theory helps to unveil market design mechanisms that will influence how personal data markets thrive: First, we observe a majority of users become reactant if they are consciously deprived of control over their personal data; many drop out of the market. We therefore advice companies to consider user-centered data control tools to have them participate in personal data markets. Second, we find that in order to create scarcity in the market, centralized IT architectures (reducing multiple data copies) may be beneficial.},
  langid = {english},
  keywords = {data protection,data valuation,personal data markets,privacy,psychological ownership,WTP},
  file = {/home/chris/Zotero/storage/J3TFZFZD/jit.2016.4.pdf;/home/chris/Zotero/storage/KUPQWVBU/Spiekermann_Korunovska_2017_Towards a value theory for personal data.pdf;/home/chris/Zotero/storage/RJLGSSKK/Spiekermann_Korunovska_2017_Towards a value theory for personal data.pdf}
}

@article{spillerSpotlightsFloodlightsMagic2013,
  title = {Spotlights, {{Floodlights}}, and the {{Magic Number Zero}}: {{Simple Effects Tests}} in {{Moderated Regression}}},
  shorttitle = {Spotlights, {{Floodlights}}, and the {{Magic Number Zero}}},
  author = {Spiller, Stephen A. and Fitzsimons, Gavan J. and LynchJR., John G. and Mcclelland, Gary H.},
