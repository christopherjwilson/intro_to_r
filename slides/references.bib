@article{rayyan-471359455,
  title = {Addressing the Relationship between Gambling and Professional Football in {{England}}: A Response to {{Smith}} et al. '{{Gambling}}, Sports Psychiatry, and Disciplinary Sanctions in {{English}} Professional Football' [Soccer \& Society 25, No. 1 (2024): 140-143]},
