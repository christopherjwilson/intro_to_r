@article{pikulinaOverconfidenceInvestmentExperimental2017,
  title = {Overconfidence and Investment: {{An}} Experimental Approach.},
  author = {Pikulina, Elena and Renneboog, Luc and Tobler, Philippe N},
  date = {2017-04},
  journaltitle = {Journal of Corporate Finance},
  volume = {43},
  pages = {175--192},
  issn = {09291199},
  url = {http://10.0.3.248/j.jcorpfin.2017.01.002 http://search.ebscohost.com/login.aspx?direct=true{&}db=bth{&}AN=122094746{&}site=bsi-live},
  abstract = {A positive relation between overconfidence and investment provision has been theoretically justified and practically assumed in the literature, but has not been thoroughly investigated. We test and confirm this positive relation between direct measures of overconfidence in one's financial knowledge and choice of investment. More precisely, strong overconfidence results in excess investment, underconfidence induces underinvestment, whereas moderate overconfidence leads to accurate investments. Our experimental results are based on different subject pools, financial professionals and students, and different media: computer-, paper-, and web-based. The degree of one's overestimation of one's individual financial knowledge relative to one's actual knowledge as well as relative to the knowledge of peers explains investment decisions better than one's actual knowledge. The relation between overconfidence and investment is robust to the degree of individual risk aversion, the riskiness of the investment projects, and to the changes in incentives structure. [ABSTRACT FROM AUTHOR]},
  keywords = {Better-than-average,Bias,Decision making in investments,Financial literacy,Financial planners,G11,Investment,J22,Labor incentives,nosource,Overconfidence,Professionals,Risk aversion}
}

@article{pileckiExperimentalInvestigationCognitive2012,
  title = {An {{Experimental Investigation}} of {{Cognitive Defusion}}},
  author = {Pilecki, Brian C. and McKay, Dean},
