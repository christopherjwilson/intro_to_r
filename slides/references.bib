  publisher = {Taylor \& Francis Ltd},
  location = {["École de Psychologie, Université Laval, Quebec, Quebec, Canada", "Consultant", "School of Psychology, The University of Sydney, Sydney, Australia", "Division on Addiction, The Cambridge Health Alliance, Medford, MA, Harvard Medical School, Boston, MA, USA"] Philadelphia, Pennsylvania},
  issn = {1606-6359},
  doi = {10.1080/16066359.2016.1245294},
  url = {https://ezproxy.tees.ac.uk/login?url=https://search.ebscohost.com/login.aspx?direct=true&db=cul&AN=121841661&site=ehost-live},
  abstract = {Many jurisdictions around the world have implemented Responsible Gambling (RG) programs for the purpose of preventing gambling-related harms. Using a research synthesis strategy, this paper examines the extant peer-reviewed empirical evidence underpinning RG strategies. Instead of reporting all available studies and then discarding many on the ground of methodological flaws, we used the followinga prioriset of inclusion criteria: (1) All studies must have been conducted within real gambling environments with ‘real’ gamblers; and studies must have included at least one of the following elements: (2) a matched control or comparison group; (3) repeated measures; and (4) one or more measurement scales. The results revealed that only 29 articles met at least one of the methodological criteria. These empirical studies revealed five primary RG strategies. These findings have practical implications for evidence-based implementation of RG activities.},
  keywords = {Data Analysis Software,Descriptive Statistics,Funding Source,Gambling,Harm Reduction,Human,Internet,Interrater Reliability,kappa Statistic,Prevention and Control,Psychosocial Factors,Psycinfo,PubMed,Systematic Review},
