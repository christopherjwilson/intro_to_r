  url = {https://linkinghub.elsevier.com/retrieve/pii/S0306452205007438},
  urldate = {2022-10-07},
  abstract = {Working memory can be defined as the ability to hold in mind information in the face of potentially interfering distraction in order to guide behavior. The experimental manipulation of working memory tasks has shed considerable light on the probable structure of the human working memory system, and, to a lesser extent, the specific processes captured by working memory paradigms. However, individual differences research has also had a crucial role to play in the development of theories of working memory. In particular, correlational approaches have been particularly informative in three areas of working memory research, each of which is reviewed here. These are, first, the importance of working memory measures as correlates of high-level cognitive skills such as reading, mathematics, reasoning, and fluid intelligence; second, the extent to which human working memory relies on domain-general or domain-specific component subsystems, and third, the precise reasons why working memory measures do relate to other important indices of human cognitive functioning. The findings from each of these areas suggest that working memory depends on a combination of domain-specific representational systems and domain-general processing and control systems, and that working memory measures capture individuals’ ability to combine maintenance and processing demands in a manner that limits information loss from forgetting or distraction. © 2005 Published by Elsevier Ltd on behalf of IBRO.},
  langid = {english},
  file = {/home/chris/Zotero/storage/E7DZ7PPM/Jarrold_Towse_2006_Individual differences in working memory.pdf;/home/chris/Zotero/storage/JSILHV3U/Jarrold_Towse_2006_Individual differences in working memory.pdf}
}

@article{jasperNumeracyPredictorAdaptive2013,
  title = {Numeracy as a {{Predictor}} of {{Adaptive Risky Decision Making}}},
  author = {Jasper, John D. and Bhattacharya, Chandrima and Levin, Irwin P. and Jones, Lance and Bossard, Elaine},
  date = {2013},
  journaltitle = {Journal of Behavioral Decision Making},
  volume = {26},
  number = {2},
  pages = {164--173},
  issn = {1099-0771},
  doi = {10.1002/bdm.1748},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bdm.1748},
  urldate = {2025-12-10},
  abstract = {Numeracy or one's ability to appropriately process and use numerical information has been shown to be an important individual difference factor in decision making. The current study utilized a risky decision-making task (called the “cups task”) in which choices are made to both earn and avoid losing hypothetical money. Critically, this design allowed investigators to examine numeracy-related differences in adaptive decision-making as measured by sensitivity to expected value (EV) differences over 54 paired-choice trials—some in which it was advantageous to take a risk and some in which it was not. Results showed that in an undergraduate sample of 114 individuals, the less numerate took more risks and were less sensitive to varying EV levels than the more numerate, especially when it was disadvantageous to take a risk and when the choice involved a potential loss (rather than a gain). These results are consistent with a dual processing account in which the more numerate are much better than the less numerate at extracting the precise affective “gist” of the numerical information, which is then used to determine the goodness or badness of a particular choice. Copyright © 2012 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {affect,dual processes,framing,individual differences,numeracy,risky decision making},
  file = {/home/chris/Zotero/storage/ALJXTA9V/Jasper et al. - 2013 - Numeracy as a Predictor of Adaptive Risky Decision Making.pdf;/home/chris/Zotero/storage/8D4XQIEV/bdm.html}
}

