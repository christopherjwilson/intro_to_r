@article{westbergImplicitAssociationsSocial2007,
  title = {Implicit {{Associations}} and {{Social Anxiety}}},
  author = {Westberg, Peter and Lundh, Lars‐Gunnar and Jönsson, Peter},
  date = {2007-03},
  journaltitle = {Cognitive Behaviour Therapy},
  shortjournal = {Cognitive Behaviour Therapy},
  volume = {36},
