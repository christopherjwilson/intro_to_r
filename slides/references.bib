  url = {http://doi.apa.org/getdoi.cfm?doi=10.1037/a0018264},
  urldate = {2022-10-07},
  abstract = {The causal role of biased attention in worry was investigated in an experiment in which high worriers were assigned either to a condition requiring attention to nonthreatening words and text while ignoring worry-related material or to a mixed-attention control condition. The former procedure led to fewer negative thought intrusions in a worry test (as rated by both participants and an assessor) than did the control condition. These findings suggest that attentional bias plays a causal role in worry and that its modification can reduce excessive worry.},
