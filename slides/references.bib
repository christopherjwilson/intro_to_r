@article{gimbertRolePerformanceMeasurement2010,
  title = {The {{Role}} of {{Performance Measurement Systems}} in {{Strategy Formulation Processes}}},
  author = {Gimbert, Xavier and Bisbe, Josep and Mendoza, Xavier},
