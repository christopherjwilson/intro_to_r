  abstract = {Student loan debt has become an issue of national concern in the context\textbackslash nof rapidly increasing higher education costs. Graduate education can be\textbackslash nprohibitively expensive, particularly at the doctoral level. The present\textbackslash nstudy provides an updated and comprehensive analysis of the financial\textbackslash ncircumstances and debt loads related to pursuing a graduate degree in\textbackslash npsychology. The study surveyed a random sample of graduate students and\textbackslash nearly career psychologists (ECPs) listed in the American Psychological\textbackslash nAssociation membership database. Participants were asked about their\textbackslash ndebt loads for educational costs, sources of financial support, living\textbackslash ncircumstances, financial stress, and the impact of student loan debt on\textbackslash ntheir personal and professional lives. The results indicate that current\textbackslash ndebt loads are substantially higher than what has been previously\textbackslash nreported (Michalski, Kohout, Wicherski, \& Hart, 2011), with some\textbackslash nvariation by subfield and type of degree. A number of participants\textbackslash nendorsed significant financial stress, as well as having to delay major\textbackslash nlife milestones because of their debt. While education costs and loan\textbackslash ndebt have continued to increase, starting salaries appear relatively\textbackslash nstagnant, suggesting the need for a thoughtful cost/benefit analysis of\textbackslash ngraduate education in psychology. The psychology community is urged to\textbackslash nincrease awareness of and advocate for these issues, with several\textbackslash nspecific advocacy steps recommended.},
  keywords = {\#nosource,Debt,Graduate education,Psychology,Qualitative data,Student loans}
}

@article{DoranEtAl2016b,
  title = {Graduate Debt in Psychology: {{A}} Quantitative Analysis.},
  shorttitle = {Graduate Debt in Psychology},
  author = {Doran, Jennifer M. and Kraha, Amanda and Marks, Laura Reid and Ameen, Edward J. and El-Ghoroury, Nabil Hassan},
  date = {2016-02},
  journaltitle = {Training and Education in Professional Psychology},
  shortjournal = {Training and Education in Professional Psychology},
  volume = {10},
  number = {1},
  pages = {3--13},
  issn = {1931-3926, 1931-3918},
  doi = {10.1037/tep0000112},
  url = {http://doi.apa.org/getdoi.cfm?doi=10.1037/tep0000112},
  urldate = {2022-10-07},
  abstract = {Student loan debt has become an issue of national concern in the context of rapidly increasing higher education costs. Graduate education can be prohibitively expensive, particularly at the doctoral level. The present study provides an updated and comprehensive analysis of the financial circumstances and debt loads related to pursuing a graduate degree in psychology. The study surveyed a random sample of graduate students and early career psychologists (ECPs) listed in the American Psychological Association membership database. Participants were asked about their debt loads for educational costs, sources of financial support, living circumstances, financial stress, and the impact of student loan debt on their personal and professional lives. The results indicate that current debt loads are substantially higher than what has been previously reported (Michalski, Kohout, Wicherski, \& Hart, 2011), with some variation by subfield and type of degree. A number of participants endorsed significant financial stress, as well as having to delay major life milestones because of their debt. While education costs and loan debt have continued to increase, starting salaries appear relatively stagnant, suggesting the need for a thoughtful cost/benefit analysis of graduate education in psychology. The psychology community is urged to increase awareness of and advocate for these issues, with several specific advocacy steps recommended.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Doran et al_2016_Graduate debt in psychology.pdf}
}

@article{Doring2009,
  title = {The {{Internet}}'s Impact on Sexuality: {{A}} Critical Review of 15years of Research},
  shorttitle = {The {{Internet}}'s Impact on Sexuality},
  author = {D\"oring, Nicola M.},
  date = {2009-09},
  journaltitle = {Computers in Human Behavior},
  shortjournal = {Computers in Human Behavior},
  volume = {25},
  number = {5},
  pages = {1089--1101},
  issn = {07475632},
  doi = {10.1016/j.chb.2009.04.003},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0747563209000442},
  urldate = {2022-10-07},
  abstract = {The body of empirical research on Internet sexuality has grown steadily since 1993. The following paper provides an overview of the current state of research in this field in its full thematic breadth, addressing six areas of online sexuality: Pornography, sex shops, sex work, sex education, sex contacts, and sexual subcultures. Key research results are presented concerning Internet sexuality's forms of manifestation, participant groups, opportunities, and risks. This paper shows that sexually related online activities have become routine in recent years for large segments of the population in the Western world. Internet sexuality also takes somewhat different forms based on the age, gender, and sexual orientation of the individual. Academic studies to date have focused overwhelmingly on the possible negative effects of Internet sexuality. By contrast, little research has been conducted on potential benefits. Consequently, a surprising number of gaps are evident in the scholarship on Internet sexuality.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Döring_2009_The Internet’s impact on sexuality.pdf}
}

@article{Doring2009a,
  title = {The {{Internet}}'s Impact on Sexuality: {{A}} Critical Review of 15years of Research},
  shorttitle = {The {{Internet}}'s Impact on Sexuality},
  author = {D\"oring, Nicola M.},
  date = {2009-09},
  journaltitle = {Computers in Human Behavior},
  shortjournal = {Computers in Human Behavior},
  volume = {25},
  number = {5},
  pages = {1089--1101},
  issn = {07475632},
  doi = {10.1016/j.chb.2009.04.003},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0747563209000442},
  urldate = {2022-10-07},
  abstract = {The body of empirical research on Internet sexuality has grown steadily since 1993. The following paper provides an overview of the current state of research in this field in its full thematic breadth, addressing six areas of online sexuality: Pornography, sex shops, sex work, sex education, sex contacts, and sexual subcultures. Key research results are presented concerning Internet sexuality's forms of manifestation, participant groups, opportunities, and risks. This paper shows that sexually related online activities have become routine in recent years for large segments of the population in the Western world. Internet sexuality also takes somewhat different forms based on the age, gender, and sexual orientation of the individual. Academic studies to date have focused overwhelmingly on the possible negative effects of Internet sexuality. By contrast, little research has been conducted on potential benefits. Consequently, a surprising number of gaps are evident in the scholarship on Internet sexuality.},
  langid = {english},
  file = {C:\Users\wilso\OneDrive - Teesside University\Papers\Döring_2009_The Internet’s impact on sexuality2.pdf}
}

@article{DossiPatelli2010,
  title = {You {{Learn From What You Measure}}: {{Financial}} and {{Non-Financial Performance Measures}} in {{Multinational Companies}}},
  shorttitle = {You {{Learn From What You Measure}}},
  author = {Dossi, Andrea and Patelli, Lorenzo},
  date = {2010-08},
  journaltitle = {Long Range Planning},
  series = {Strategic {{Performance Measurement}}},
  volume = {43},
  number = {4},
  pages = {498--526},
  issn = {0024-6301},
  doi = {10.1016/j.lrp.2010.01.002},
  abstract = {According to recent studies in international management, relationships between headquarters and subsidiaries in the global economy are characterised simultaneously by elements of organisational interdependence and local autonomy. These characteristics challenge the traditional design and use of performance measurement systems (PMSs). Contemporary approaches to PMSs emphasise the role of performance indicators for strategy implementation and advocate the adoption of non-financial indicators in addition to traditional financial metrics. We investigated the factors associated with the inclusion of non-financial indicators in PMSs used in relationships between headquarters and subsidiaries. Our empirical study is based on 141 questionnaires collected from Italian subsidiaries of foreign companies and 13 interviews with respondents. Non-financial performance indicators contained in PMSs refer equally to customer, internal processes and people measurement perspectives. Furthermore, we find that the inclusion of non-financial indicators is positively associated with relative performance evaluation, interactive use of PMSs, subsidiary size, headquarters nationality and subsidiary participation in the design of PMSs. Information gathered through interviews provides explanations of our results, and suggests that the inclusion of non-financial perspectives in PMSs contributes to the strategic alignment of international organisations by supporting learning and dialogue within relationships between headquarters and subsidiaries.},
  keywords = {\#nosource}
}

